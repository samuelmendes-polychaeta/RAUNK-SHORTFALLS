@ARTICLE{Liang2026,
	author = {Liang, Jian and Ma, Chae-Woo},
	title = {Evaluating ecological quality in the subtidal zone off Jindo Island, South Korea, by using multiple benthic indices},
	year = {2026},
	journal = {Marine and Freshwater Research},
	volume = {77},
	number = {1},
	pages = {},
	doi = {10.1071/MF25182},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105027661287&doi=10.1071%2FMF25182&partnerID=40&md5=3a74d4d76b1d8d90c5aaa0a4cce3a643},
	affiliations = {Experimental Teaching Demonstration Center of Food Safety and Nutrition, Xinjiang Institute of Technology, Aksu, 843000, China; Aksu Institute of Apple, Xinjiang Institute of Technology, Aksu, 843000, China; Department of Food Science and Engineering, Xinjiang Institute of Technology, Aksu, 843000, China; Department of Biology, College of Natural Sciences, Soonchunhyang University, Asan, 31538, South Korea},
	abstract = {Context: Rapid coastal development and aquaculture expansion along the South Korean coast have intensified anthropogenic pressure on benthic ecosystems, highlighting the need for reliable ecological assessment tools. Aims: This study assessed the ecological quality status (EcoQS) of the subtidal zone off Jindo Island, South Korea. Methods: Five benthic indices, namely the AZTI marine biotic index (AMBI), BENTIX, benthic polychaeta amphipoda index (BPA), benthic pollution index (BPI), multivariate AMBI (M-AMBI) and a composite index were applied to evaluate EcoQS across 3 survey years. Multivariate analyses were performed to identify the influence of environmental variables on community structure. Key results: In total, 98 macrobenthic species were recorded. Most stations exhibited acceptable EcoQS according to AMBI, BENTIX, BPI and M-AMBI, whereas BPA classified many as moderate or poor, underscoring the limitations of single-taxon approaches. Lead (Pb) concentration in seawater was identified as a key driver of macrobenthic community variation, particularly in years with enhanced terrestrial runoff. Conclusions: Although Pb concentrations were below national thresholds, their ecological effects were evident, indicating subtle but measurable community responses. Implications: Employing multiple benthic indices provided an integrated framework for long-term monitoring and sustainable environmental management in the coastal waters of Jindo Island. © 2026 The Author(s) (or their employer(s)). Published by CSIRO Publishing.},
	author_keywords = {benthic index; composite index; ecological quality status; heavy metal; Jeju Strait; Jindo Island; macrobenthos; southern sea of Korea},
