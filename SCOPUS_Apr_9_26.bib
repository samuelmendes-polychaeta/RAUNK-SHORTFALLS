	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-83155181825&doi=10.1242%2Fjeb.055178&partnerID=40&md5=09da19bb96d8b126664bf91e01916002},
	affiliations = {Alfred Wegener Institute for Polar and Marine Research, 27570 Bremerhaven, Am Handelshafen 12, Germany; Center for Biomolecular Interactions Bremen, University of Bremen, 28359 Bremen, Leobener Str., Germany; Institute of Clinical Molecular Biology, Christian-Albrechts University Kiel, 24105 Kiel, Schittenhelmstrasse 12, Germany; Marine Research Institute, Skulagata 4, Iceland; Hamburg University of Applied Sciences, Faculty of Life Sciences, FTZ-ALS, 21033 Hamburg, Lohbruegger Kirchstrasse 65, Germany; University of Bremen, 28359 Bremen, Leobener Str., Germany},
	abstract = {Arctica islandica is the longest-lived non-colonial animal found so far, and reaches individual ages of 150?years in the German Bight (GB) and more than 350?years around Iceland (IC). Frequent burrowing and physiological adjustments to low tissue oxygenation in the burrowed state are proposed to lower mitochondrial reactive oxygen species (ROS) formation. We investigated burrowing patterns and shell water partial pressure of oxygen (P <sub>O2</sub>) in experiments with live A. islandica. Furthermore, succinate accumulation and antioxidant defences were recorded in tissues of bivalves in the normoxic or metabolically downregulated state, as well as ROS formation in isolated gills exposed to normoxia, hypoxia and hypoxia/reoxygenation. IC bivalves burrowed more frequently and deeper in winter than in summer under in situ conditions, and both IC and GB bivalves remained burrowed for between 1 and 6?days in laboratory experiments. Shell water PO2 was >5?kPa when bivalves were maintained in fully oxygenated seawater, and ventilation increased before animals entered the state of metabolic depression. Succinate did not accumulate upon spontaneous shell closure, although shell water P <sub>O2</sub> was 0?kPa for over 24?h. A ROS burst was absent in isolated gills during hypoxia/reoxygenation, and antioxidant enzyme activities were not enhanced in metabolically depressed clams compared with normally respiring clams. Postponing the onset of anaerobiosis in the burrowed state and under hypoxic exposure presumably limits the need for elevated recovery respiration upon surfacing and oxidative stress during reoxygenation. © 2011. Published by The Company of Biologists Ltd.},
	author_keywords = {Adenylates; Antioxidative enzymes; Arctica islandica; Burrowing; Mantle cavity water PO2; Metabolic rate depression; Reactive oxygen species formation; Succinate},
