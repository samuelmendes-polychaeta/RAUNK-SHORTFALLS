}

@ARTICLE{Forbes19971002,
	author = {Forbes, Valery E. and Forbes, Thomas L.},
	title = {Dietary absorption of sediment-bound fluoranthene by a deposit-feeding gastropod using the 14C:51CR dual-labeling method},
	year = {1997},
	journal = {Environmental Toxicology and Chemistry},
