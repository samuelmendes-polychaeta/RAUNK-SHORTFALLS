@ARTICLE{Cheschin2025,
	author = {Cheschin, M.F.B. and Massi, K.G. and Rodgher, S.},
	title = {Temperature elevation intensifies the toxicity of metals to terrestrial invertebrates: results of a meta-analysis; [Elevação da temperatura intensifica a toxicidade de metais para invertebrados terrestres: resultados de uma meta-análise]},
