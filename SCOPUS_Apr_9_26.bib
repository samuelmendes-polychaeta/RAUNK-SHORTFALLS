	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85071189118&doi=10.3354%2Fmeps13033&partnerID=40&md5=ac99b40c154f31742e3f2f0ff4d5b6fe},
	affiliations = {Centro de Estudos Do Mar, Universidade Federal Do Paraná, Av. Beira-Mar, s/n, Pontal do Sul, PO Box 61, Pontal do Paraná, Paraná, CEP 83255-976, Brazil; Millennium Nucleus of Ecology and Sustainable Management of Oceanic Islands (ESMOI), Departamento de Biología Marina, Universidad Católica Del Norte, Larrondo, Coquimbo, 1281, Chile; Departamento de Química e Biologia, Universidade Estadual Do Maranhão, Cidade Universitária Paulo VI, s/n, Tirirical, PO Box 09, São Luís, Maranhão, CEP 65055-970, Brazil},
	abstract = {The capacity of an infaunal organism to exploit resources in a given sedimentary habitat is reflected by its bioturbation-related traits. Functional traits such as body size, mobility, and type of burrowing behavior reflect the species' bioturbation potential and, therefore, their role in affecting sediment characteristics. In this study, we applied a trait-based approach to assess the variation in the functional diversity of intertidal macrobenthic assemblages from Guaratuba Bay, a subtropical estuarine system in Southern Brazil. We expected that changes in sediment characteristics across and within estuarine zones would be followed by detectable changes in the trait diversity of infaunal assemblages. The estuarine gradient strongly affected overall functional diversity, especially on the largest spatial scale, which corresponded to 3 distinct salinity sectors. This was also the case for the variables grain size and depth of the redox discontinuity layer. We identified 3 assemblages with distinct functional trait composition among the sectors. Although the number of species remained relatively constant across sectors, the functional diversity increased from the inner, less saline to the outer, more saline sectors. Our findings emphasize that drivers at the largest spatial scales (i.e. gradients in salinity and sediment texture) play a major role in maximizing functional diversity and shifts in trait composition along an estuarine gradient. © Inter-Research 2019.},
	author_keywords = {Biological traits; Estuarine gradients; Functional diversity; Macrobenthic invertebrates; Tidal flats},
	correspondence_address = {G.C. Morais; Centro de Estudos Do Mar, Universidade Federal Do Paraná, Pontal do Paraná, Paraná, Av. Beira-Mar, s/n, Pontal do Sul, PO Box 61, CEP 83255-976, Brazil; email: gisellymorais@gmail.com},
