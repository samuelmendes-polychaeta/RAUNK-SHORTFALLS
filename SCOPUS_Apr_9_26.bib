@ARTICLE{Hewitt20011502,
	author = {Hewitt, J.E. and Thrush, S.E. and Cummings, V.J.},
	title = {Assessing environmental impacts: Effects of spatial and temporal variability at likely impact scales},
	year = {2001},
	journal = {Ecological Applications},
	volume = {11},
	number = {5},
	pages = {1502 - 1516},
	doi = {10.1890/1051-0761(2001)011[1502:AEIEOS]2.0.CO;2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0034788899&doi=10.1890%2F1051-0761%282001%29011%5B1502%3AAEIEOS%5D2.0.CO%3B2&partnerID=40&md5=5294571a453fd91341b1327e1e2a25c7},
	affiliations = {Natl. Inst. of Water/Atmosph. Res., Hamilton, P.O. Box 11-115, New Zealand},
	abstract = {Ecological and environmental variability in natural ecosystems precludes the widespread use of simplistic design and analysis tools to detect the effects of human activities on natural ecosystems. BACI (Before-After and Control-Impact) sampling and analysis is often recommended to overcome the problem of inferring that changes are due to an impact rather than natural variability. Using five different BACI design and analysis techniques (from nested ANOVA to time-series intervention) on data with spatial, temporal, and sampling variability at scales relevant to impact assessments, we investigated how BACI designs cope with interactions between spatial and temporal variability and whether natural variability is best treated as random. A number of simulated impacts of different sizes and types were imposed on long-term observations of six macrofaunal species and three diversity indices. A major problem in detecting the impacts was the differences in variability between sites, although the statistical detection of impacts was aided by treating temporal variability as an underlying process with structure, rather than random noise. However, the sensitivity of any method depended on the spatial and temporal variability exhibited by the ecological measure. Our results emphasize that scale is one of the most important concepts in impact assessment. As spatial or temporal scale increases, both the number of processes and their importance in influencing local populations and communities will change, increasing the variability encompassed by the study. We suggest monitoring a number of variables (populations) and developing sampling strategies that enable a number of methods of analysis to be employed.},
	author_keywords = {BACI; Impact assessment; Macrofaunal populations; Sensitivity analysis; Spatial and temporal variability; Time series},
