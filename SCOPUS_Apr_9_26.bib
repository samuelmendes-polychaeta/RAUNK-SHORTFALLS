@ARTICLE{Torroja20042395,
	author = {Torroja, Carlos and Gorfinkiel, Nicole and Guerrero, Isabel},
	title = {Patched cotrols the Hedgehog gradient by encocytosis in a dynamin-dependent manner, but this internalization does not play a major role in signal transduction},
	year = {2004},
	journal = {Development},
	volume = {131},
