}

@ARTICLE{Cassai1999489,
	author = {Cassai, C. and Prevedelli, D.},
	title = {Fecundity and reproductive effort in Ophryotrocha labronica (Polychaeta: Dorvilleidae)},
	year = {1999},
	journal = {Marine Biology},
	volume = {133},
