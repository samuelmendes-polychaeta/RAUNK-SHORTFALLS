	volume = {5620},
	number = {2},
	pages = {367 - 378},
	doi = {10.11646/zootaxa.5620.2.9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002416238&doi=10.11646%2Fzootaxa.5620.2.9&partnerID=40&md5=af5c85347b1973f48048e1dd5bdd9e4a},
	affiliations = {Programa de Capacitação Institucional, Museu Paraense Emilio Goeldi, Coordenação de Zoologia, Av. Perimetral, 1901, Terra Firme, PA, Belém, CEP 66077-830, Brazil; Museu Paraense Emilio Goeldi, Laboratório de Invertebrados Aquáticos (LIA-MPEG), Av. Perimetral, 1901, PA, Belém, 66077-830, Brazil},
	abstract = {Morphological descriptions of juveniles in Crustacea serve as a guide for identifying species during this stage, thus increasing our understanding of life cycle strategies and potential adaptations to the environment. In addition, these studies can facilitate the elucidation of phylogenetic relationships within taxa. Pseudothelphusidae Ortmann, 1893 is the family with the largest number of species among the neotropical freshwater Brachyura, but descriptions of juvenile forms in freshwater crabs are still rare. Notably, only a few species within the Trichodactylidae, such as Dilocarcinus pagei Stimpson, 1861, Dilocarcinus septemdentatus (Herbst, 1783) and Trichodactylus sp., have been documented with descriptions of their juvenile forms. In this study, we present a comprehensive description of the pre-juvenile and first juvenile stages of the pseudothelphusid crab Fredius reflexifrons (Ortmann, 1897), offering a new contribution to the field. We also describe the characteristics that allow us to differentiate F. reflexifrons juveniles from other species of freshwater crab juveniles. Pre-juveniles are characterized by the absence of calcification and the presence of nonfunctional appendages. The distinctive feature of pseudothelphusid crabs, a reduced exopodite of the third maxilliped, is already evident in the first juvenile stage. Copyright © 2025 Magnolia Press.},
	author_keywords = {Amazon; Brachyura; development; morphology; setae},
	correspondence_address = {R.R.R. Vieira; Programa de Capacitação Institucional, Museu Paraense Emilio Goeldi, Belém, Coordenação de Zoologia, Av. Perimetral, 1901, Terra Firme, PA, CEP 66077-830, Brazil; email: ronycrab@gmail.com},
	abbrev_source_title = {Zootaxa},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

