}

@ARTICLE{Verónica2025,
	author = {Verónica, Cuello Graciela and Emiliano, Hines and Noemi, Llanos Elizabeth and Rodolfo, Elías and Valeria, Garaffo Griselda and Ignacio, Isla Federico},
	title = {Assessment of the Structure and Function of Macrobenthic Communities Affected by Port Activities},
	year = {2025},
