	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Green Open Access}
}

@ARTICLE{Akinpelu202590,
	author = {Akinpelu, O.T. and Arimoro, F.O. and Ayanwale, A.V. and Chukwuemeka, V.I. and Adedapo, A.M. and Akindele, E.O.},
	title = {Comparative investigation provides further insights on how riparian deforestation and different land uses impact the distribution of freshwater macroinvertebrates in Nigerian streams},
	year = {2025},
	journal = {Ecohydrology and Hydrobiology},
	volume = {25},
	number = {1},
	pages = {90 - 105},
	doi = {10.1016/j.ecohyd.2024.01.006},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184038503&doi=10.1016%2Fj.ecohyd.2024.01.006&partnerID=40&md5=920e05eedbba23a3330c0d631f2889b8},
	affiliations = {Department of Animal Biology, School of Life Science, Federal University of Technology, Niger State, Minna, Nigeria; Department of Zoology, Obafemi Awolowo University, Osun State, Ile-Ife, Nigeria},
	abstract = {Riparian forest loss and various land use impacts on macroinvertebrate communities in Nigerian streams remain poorly understudied. To fill this knowledge gap, a study was conducted on five streams in the southwest ecoregion of Nigeria between December 2019 and October 2021. A total of 2,077 macroinvertebrates were sampled, comprising 16 orders, 40 families, and 80 species. Aquatic insects were the most abundant, constituting 85 % of species and 73.13 % of individuals. Other specimens included Mollusca, Crustacea, Arachnida, and Annelida. Notably, Olumirin stream exhibited the highest macroinvertebrate abundance, including the stress-sensitive Ephemeroptera-Plecoptera-Trichoptera (EPT) members. The site also had the highest degree of naturalness, widest channel and dissolved oxygen (DO), but lowest electrical conductivity (EC) and total dissolved solids (TDS) compared to the other streams (Abirunmu, Awoosun, Mogimogi, and Aboto), that harbored facultative and stress-tolerant species, indicating varying degrees of disturbances. The bivariate regression analysis confirms that riparian deforestation and land use impact macroinvertebrate distribution in streams as there was an inverse relationship between EPT abundance and forest cover. Also, DO positively correlates with EPT taxa richness but inversely correlates with Coleoptera richness and Hemiptera abundance. As a result, Olumirin stream is proposed as a benchmark for evaluating freshwater ecological integrity in the region. Given the escalating anthropogenic activities in the tropics, urgent collaborative efforts are required to safeguard freshwater biodiversity, protect the riparian corridor of Olumirin stream, and restore impaired streams in the region. © 2024},
	author_keywords = {Aquatic insects; Biological water quality; Facultative species; Olumirin stream; Riparian forest; Stress sensitive},
	correspondence_address = {O.T. Akinpelu; Department of Animal Biology, School of Life Science, Federal University of Technology, Minna, Niger State, Nigeria; email: oluwaseuntemitopeakinpelu@gmail.com},
	abbrev_source_title = {Ecohydrol. Hydrobiol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@ARTICLE{Kang2024,
	author = {Kang, Hee Yoon and Lee, Byeong-Gweon and Park, Sang Rul and Kim, Changseong and Jang, Jaebin and Kang, Chang-Keun},
	title = {Trophic niche overlap in coralline algae- and coral-dominated rocky-bottom subtidal communities},
	year = {2024},
	journal = {Marine Pollution Bulletin},
	volume = {208},
	pages = {},
	doi = {10.1016/j.marpolbul.2024.116997},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204376814&doi=10.1016%2Fj.marpolbul.2024.116997&partnerID=40&md5=5bfc0d503e16f52107876147a3d510a8},
	affiliations = {School of Earth Sciences and Environmental Engineering, Gwangju Institute of Science and Technology, Gwangju, 61005, South Korea; Department of Oceanography, College of Natural Science, Chonnam National University, Gwangju, 61186, South Korea; Department of Marine Life Science (BK21 FOUR) and Marine Science Institute, Jeju National University, Jeju, 63243, South Korea},
	abstract = {We investigated trophic structures in rocky subtidal ecosystems transitioning from canopy-forming to barren states across coastlines with varying oceanographic conditions. We examined stable isotopes and functional traits of common invertebrate and fish taxa to understand the food-web consequences. We hypothesized that resource exploitation patterns of functional guilds would result in distinct isotopic niches, defining trophic diversity and niche. δ<sup>13</sup>C and δ<sup>15</sup>N ranges of invertebrate functional groups differentiated pelagic from benthic trophic pathways, reflecting flexible dietary use in the absence of macroalgae. Fish production relied on prey using pelagic and benthic basal resources. Trophic redundancy among consumers within functional guilds contributed to intrinsic trophic structure in barren ecosystems. The resulting community-wide trophic diversity has led to consistent niche widths and overlapping niche space. Overall, our findings highlight the crucial roles of consumers that persist with diverse functional guilds in conferring the adaptability of barren rocky ecosystems following habitat disturbance. © 2024},
	author_keywords = {Coralline barrens; Food web; Korean coast; Stable isotopes; Subtidal rocky bottom; Trophic structure},
	correspondence_address = {C.-K. Kang; School of Earth Sciences and Environmental Engineering, Gwangju Institute of Science and Technology, Gwangju, 61005, South Korea; email: ckkang@gist.ac.kr},
