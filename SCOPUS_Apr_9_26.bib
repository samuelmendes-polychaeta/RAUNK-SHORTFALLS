	title = {Changes in vertical and horizontal diversities mediated by the size structure of introduced fish collectively shape food-web stability},
	year = {2023},
	journal = {Ecology Letters},
	volume = {26},
	number = {10},
	pages = {1752 - 1764},
	doi = {10.1111/ele.14290},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85165663614&doi=10.1111%2Fele.14290&partnerID=40&md5=8d23ee5db2068460646c64d9e3585ec6},
	affiliations = {Université Savoie Mont Blanc, INRAE, UMR CARRTEL, Thonon-les-Bains, France; Pôle R&D Ecosystèmes Lacustres (ECLA), OFB-INRAE-USMB, Aix-en-Provence, France; Colorado Mesa University, Grand Junction, CO, United States; Fédération de Savoie pour la Pêche et la Protection du Milieu Aquatique (FDPPMA 73), Saint-Alban-Leysse, France; Office Française pour la Biodiversité, Unité Spécialisée Milieux Lacustres, Thonon-les-Bains, France; INRAE, Université Aix Marseille, UMR RECOVER, Aix-en-Provence, France},
	abstract = {Species introductions can alter local food-web structure by changing the vertical or horizontal diversity within communities, largely driven by their body size distributions. Increasing vertical and horizontal diversities is predicted to have opposing effects on stability. However, their interactive effects remain largely overlooked. We investigated the independent and collective effects of vertical and horizontal diversities on food-web stability in alpine lakes stocked with variable body size distributions of introduced fish species. Introduced predators destabilize food-webs by increasing vertical diversity through food chain lengthening. Alternatively, increasing horizontal diversity results in more stable food-web topologies. A non-linear interaction between vertical and horizontal diversities suggests that increasing vertical diversity is most destabilizing when horizontal diversity is low. Our findings suggest that the size structure of introduced predators drives their impacts on stability by modifying the structure of food-webs, and highlights the interactive effects of vertical and horizontal diversities on stability. © 2023 John Wiley & Sons Ltd.},
	author_keywords = {consumer diversity; food-web; predator impact; size-structured populations; stability},
