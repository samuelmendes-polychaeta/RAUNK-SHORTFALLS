@ARTICLE{Dye2006802,
	author = {Dye, A.H.},
	title = {Inhibition of the decomposition of Zostera capricornii litter by macrobenthos and meiobenthos in a brackish coastal lake system},
	year = {2006},
	journal = {Estuaries and Coasts},
	volume = {29},
	number = {5},
