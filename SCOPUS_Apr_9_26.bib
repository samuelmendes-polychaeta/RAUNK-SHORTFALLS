	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85079535857&doi=10.1016%2Fj.dsr.2020.103239&partnerID=40&md5=98d1643631c4a7907f1f196ee8ea48a7},
	affiliations = {National Institute of Water and Atmospheric Research (NIWA) Ltd, Private Bag 14-901, Kilbirnie, Wellington, 6241, New Zealand; School of Science, University of Waikato, Private Bag 3105, Hamilton, 3240, New Zealand},
	abstract = {Predicting the impacts of anthropogenic disturbance on deep-sea ecosystems requires a thorough understanding of both environmental and faunal drivers of ecosystem function. Studies of deep-sea ecosystems, however, typically consider environmental drivers only and seldom investigate the effects of seabed communities on ecosystem processes. Here, we describe spatial and temporal variation in sediment community oxygen consumption (SCOC), a measure of benthic metabolism and carbon mineralisation, across several sites on Chatham Rise, off the east coast off New Zealand's South Island, and investigate relationships between environmental factors, macrofauna community parameters, and SCOC in order to quantify their relative contributions to benthic metabolism. SCOC differed significantly among sites but not between the two sampling events in August and December 2015. SCOC was significantly and most strongly correlated with estimated particulate organic carbon flux in both August and December in marginal regressions (R<sup>2</sup> = 0.53–0.61), followed by macrofaunal abundance (0.28–0.52), macrofaunal taxon richness (0.09–0.50) and water depth (0.30–0.35). Variation partitioning analysis showed that in late winter (August), most of the variability in SCOC was accounted for by environmental variables independently of macrofauna, whereas in summer (December), most of the variability in SCOC was accounted for by the combined effects of environment and macrofauna. We also observed a greater effect of macrofauna independent of environment in summer than in late winter (R<sup>2</sup> = 0.13 and 0.05, respectively). Our findings indicate that the contribution of macrofauna to benthic metabolism can be substantial and vary temporally. In addition, our findings suggest that the shifts in ecosystem function resulting from anthropogenic stressors will be difficult to predict due to the interactive effects of environment and macrofauna on benthic metabolism. Nevertheless, if particulate organic carbon flux decreases on Chatham Rise as predicted in climate change scenarios, we anticipate that impacts on benthic metabolism will be most strongly felt in the less productive areas of the rise due to the stronger link between macrofauna and SCOC at low macrofaunal densities. © 2020 Elsevier Ltd},
	author_keywords = {Continental slope; Ecosystem function; Macroinfauna abundance; Modelled particulate organic carbon flux; Sediment community oxygen consumption; Taxon richness},
	correspondence_address = {D. Leduc; National Institute of Water and Atmospheric Research (NIWA) Ltd, Wellington, Private Bag 14-901, Kilbirnie, 6241, New Zealand; email: Daniel.leduc@niwa.co.nz},
	abbrev_source_title = {Deep-Sea Res. Part I Oceanogr. Res. Pap.},
	type = {Article},
