	pages = {},
	doi = {10.1016/j.biocon.2025.111578},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020084742&doi=10.1016%2Fj.biocon.2025.111578&partnerID=40&md5=8409ab4e3b3ad1fada0ed51bcde1b9a9},
	affiliations = {Department of Ecology, Faculty of Environmental Sciences, Czech University of Life Sciences Prague, Kamýcká 129, Praha, Suchdol, 165 00, Czech Republic; Institute for Environmental Studies, Faculty of Science, Charles University, Benátská 2, Praha 2, Prague, 128 01, Czech Republic; Department of Zoology, Faculty of Science, Palacký University in Olomouc, 17. listopadu 50, Olomouc, 771 46, Czech Republic; Institute of Soil Biology and Biogeochemistry, Biology Centre of the Czech Academy of Sciences, Na Sádkách 7, České Budějovice, 370 05, Czech Republic},
	abstract = {Agri-environmental schemes, such as wildflower strips (WFS), can help to mitigate biodiversity loss caused by agricultural intensification. WFSs can provide benefits like soil protection and biodiversity support, particularly during winter when they can offer crucial shelter for multiple species in agricultural landscapes. However, WFS winter performance and the impacts of management activities, e.g., autumn mowing of WFS or soil tillage in surrounding arable fields, are poorly understood. This study explores how ground-dwelling arthropods and resident birds utilise WFSs and surrounding arable land during winter while evaluating the effects of different management practices. We investigated ten arable fields, either tilled or planted with winter crops, and adjacent WFSs split into mown and unmown sections. WFSs significantly increased arthropod activity-density, species richness, and the number of recorded birds. Carabids and rove beetles were primarily concentrated at the edge of WFSs, while spiders and myriapods were more abundant in the wildflower strips' interiors. Autumn mowing had no effects on the studied taxa. In contrast, soil tillage in arable fields negatively impacted carabids, spiders, and myriapods but positively affected rove beetles. Our findings highlight that maintaining WFSs promotes beneficial arthropods and birds, underscoring their role as valuable conservation tools in agricultural policy frameworks. Additionally, avoiding tillage during late autumn and winter can complement WFSs by creating a favourable environment for overwintering multiple beneficial taxa directly on arable land. © 2025 The Authors},
	author_keywords = {Abundance; Agroecosystems; Diversity; Ecosystem services; Epigeic invertebrates; Non-crop habitats},
	correspondence_address = {M. Knapp; Department of Ecology, Faculty of Environmental Sciences, Czech University of Life Sciences Prague, Suchdol, Kamýcká 129, Praha, 165 00, Czech Republic; email: knapp@fzp.czu.cz},
