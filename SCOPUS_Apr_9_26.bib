@ARTICLE{Potapov2024116,
	author = {Potapov, Anton M. and Drescher, Jochen and Darras, Kevin and Wenzel, Arne and Janotta, Noah and Nazarreta, Rizky and Kasmiatun and Laurent, Valentine and Mawan, Amanda and Utari, Endah H. and Pollierer, Melanie M. and Rembold, Katja and Widyastuti, Rahayu and Buchori, Damayanti and Hidayat, Purnama and Turner, Edgar and Grass, Ingo and Westphal, Catrin and Tscharntke, Teja and Scheu, Stefan},
	title = {Rainforest transformation reallocates energy from green to brown food webs},
