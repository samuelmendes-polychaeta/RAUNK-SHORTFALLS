	note = {Cited by: 5}
}

@ARTICLE{Wang20211634,
	author = {Wang, Lei and Peng, Saijun and Dong, Zhijun},
	title = {Effects of ocean acidification and copper ions on the ephyrae of moon jellyfish Aurelia coerulea},
