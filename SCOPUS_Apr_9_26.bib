	source = {Scopus},
	note = {Cited by: 157; All Open Access; Green Open Access}
}

@ARTICLE{Martinez-Madrid199997,
	author = {Martinez-Madrid, M. and Rodriguez, P. and Perez-Iglesias, J.I.},
	title = {Sediment toxicity bioassays for assessment of contaminated sites in the Nervion River (Northern Spain). 1. Three-brood sediment chronic bioassay of Daphnia Magna straus},
