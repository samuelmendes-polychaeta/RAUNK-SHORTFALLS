	title = {Depauperate skeletonized reef-dwelling fauna of the early Cambrian: Insights from archaeocyathan reef ecosystems of western Mongolia},
	year = {2019},
	journal = {Palaeogeography, Palaeoclimatology, Palaeoecology},
	volume = {514},
	pages = {206 - 221},
