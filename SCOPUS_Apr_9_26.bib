	title = {Hydrodynamic conditioning of diversity and functional traits in subtidal estuarine macrozoobenthic communities},
	year = {2017},
	journal = {Estuarine, Coastal and Shelf Science},
	volume = {197},
	pages = {80 - 92},
	doi = {10.1016/j.ecss.2017.08.012},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85027588710&doi=10.1016%2Fj.ecss.2017.08.012&partnerID=40&md5=eb25cbf4c9b77aa0c22100469603ccec},
	affiliations = {NIOZ Royal Netherlands Institute of Sea Research, Dept. of Estuarine and Delta Systems, Utrecht University, P.O. Box 140, Yerseke, 4400, AC, Netherlands; School of Ocean Sciences, Bangor University, Menai Bridge, Anglesey, LL59 5AB, United Kingdom; Wageningen Marine Research, P.O.Box 77, Yerseke, 4400, AB, Netherlands; Flanders Hydraulics Research, Flemish Government, Borgerhout, Antwerpen, Belgium; Deltares, P.O. Box 177, Delft, 2600, MH, Netherlands},
	abstract = {Variations in abundance and diversity of estuarine benthic macrofauna are typically described along the salinity gradient. The influence of gradients in water depth, hydrodynamic energy and sediment properties are less well known. We studied how these variables influence the distribution of subtidal macrofauna in the polyhaline zone of a temperate estuary (Westerschelde, SW Netherlands). Macrofauna density, biomass and species richness, combined in a so-called ecological richness, decreased with current velocities and median grain-size and increased with organic carbon of the sediment, in total explaining 39% of the variation. The macrofauna community composition was less well explained by the three environmental variables (approx. 12–15% in total, with current velocity explaining approx. 8%). Salinity, water depth and distance to the intertidal zone had a very limited effect on both ecological richness and the macrofauna community. The proportion of (surface) deposit feeders (including opportunistic species), decreased relative to that of omnivores and carnivores with increasing current velocity and sediment grain-size. In parallel, the proportion of burrowing sessile benthic species decreased relative to that of mobile benthic species that are able to swim. Correspondingly, spatial variations in hydrodynamics yielded distinct hotspots and coldspots in ecological richness. The findings highlight the importance of local hydrodynamic conditions for estuarine restoration and conservation. The study provides a tool based on a hydrodynamic model to assess and predict ecological richness in estuaries. © 2017},
	author_keywords = {Estuarine gradients; Flow; Functional traits; Hydrodynamics; Macrozoobenthos; Westerschelde},
	correspondence_address = {D. van der Wal; NIOZ Royal Netherlands Institute of Sea Research, Dept. of Estuarine and Delta Systems, Utrecht University, Yerseke, P.O. Box 140, 4400, Netherlands; email: daphne.van.der.wal@nioz.nl},
	abbrev_source_title = {Estuar. Coast. Shelf Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 42; All Open Access; Green Open Access}
}

