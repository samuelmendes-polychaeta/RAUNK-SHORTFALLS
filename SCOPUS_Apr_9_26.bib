@ARTICLE{Kim2024,
	author = {Kim, Dong-U and Ahn, In-Young and Noh, Junsung and Lee, Changkeun and Khim, Jong Seong},
	title = {Shifts in benthic megafauna communities after glacial retreat in an Antarctic fjord},
