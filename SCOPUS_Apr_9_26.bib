}

@ARTICLE{Mesrop2024,
	author = {Mesrop, Lisa Y. and Minsky, Geetanjali and Drummond, Michael S. and Goodheart, Jessica A. and Proulx, Stephen R. and Oakley, Todd H.},
	title = {Ancient Secretory Pathways Contributed to the Evolutionary Origin of an Ecologically Impactful Bioluminescence System},
	year = {2024},
	journal = {Molecular Biology and Evolution},
	volume = {41},
	number = {11},
	pages = {},
	doi = {10.1093/molbev/msae216},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208585211&doi=10.1093%2Fmolbev%2Fmsae216&partnerID=40&md5=cdd9a3c3e33b874af7be334c146ba298},
	affiliations = {Department of Ecology Evolution, and Marine Biology, University of California, Santa Barbara, 93106, CA, United States; Division of Invertebrate Zoology, American Museum of Natural History, New York, 10024, NY, United States},
	abstract = {Evolutionary innovations in chemical secretion - such as the production of secondary metabolites, pheromones, and toxins - profoundly impact ecological interactions across a broad diversity of life. These secretory innovations may involve a "legacy-plus-innovation"mode of evolution, whereby new biochemical pathways are integrated with conserved secretory processes to create novel products. Among secretory innovations, bioluminescence is important because it evolved convergently many times to influence predator-prey interactions, while often producing courtship signals linked to increased rates of speciation. However, whether or not deeply conserved secretory genes are used in secretory bioluminescence remains unexplored. Here, we show that in the ostracod Vargula tsujii, the evolutionary novel c-luciferase gene is co-expressed with many conserved genes, including those related to toxin production and high-output protein secretion. Our results demonstrate that the legacy-plus-innovation mode of secretory evolution, previously applied to sensory modalities of olfaction, gustation, and nociception, also encompasses light-producing signals generated by bioluminescent secretions. This extension broadens the paradigm of secretory diversification to include not only chemical signals but also bioluminescent light as an important medium of ecological interaction and evolutionary innovation.  © 2024 The Author(s). Published by Oxford University Press on behalf of Society for Molecular Biology and Evolution.},
	author_keywords = {bioluminescence; complex traits; evo-devo; evolution; novelty; WGCNA},
	correspondence_address = {T.H. Oakley; Department of Ecology Evolution, and Marine Biology, University of California, Santa Barbara, 93106, United States; email: oakley@ucsb.edu},
	abbrev_source_title = {Mol. Biol. Evol.},
	type = {Article},
