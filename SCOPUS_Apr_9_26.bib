@ARTICLE{Libralato2004331,
	author = {Libralato, Simone and Pranovi, Fabio and Raicevich, Saša and Da Ponte, Filippo and Giovanardi, Otello and Pastres, Roberto and Torricelli, Patrizia and Mainardi, Danilo},
