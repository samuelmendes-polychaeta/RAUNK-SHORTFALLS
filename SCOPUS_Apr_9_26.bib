	doi = {10.1016/j.ecss.2024.108672},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185610946&doi=10.1016%2Fj.ecss.2024.108672&partnerID=40&md5=9650ee57ae9e586968ac3722bfd23065},
	affiliations = {Groningen Institute for Evolutionary Life-Sciences, GELIFES, University of Groningen, Nijenborgh 7, Groningen, 9747, AG, Netherlands; School of Natural Sciences, Macquarie University, 6 Wally's Walk, Macquarie Park, 2113, NSW, Australia; Departamento de Biología Animal, Edafología y Geología, Universidad de La Laguna, Astrofísico Francisco Sánchez s/n, La Laguna, Santa Cruz de Tenerife, 38206, Spain; Biology Department, University of Hamburg, Mittelweg 177, Hamburg, 20148, Germany},
	abstract = {In seagrass systems, there is a realization that biotic interactions affecting sediment stability might be as important as abiotic stressors in shaping the growth and distribution patterns of seagrass vegetation. However, few studies have looked at the interaction between seagrass and large (mega) bioturbating species, although through sediment reworking activity they may have the capacity to cause large scale impact on seagrass establishment. We assessed the effect of bioturbation by mobile megabioturbators (species lager than 5 cm) on subtidal seagrass (Cymodocea nodosa) using a manipulative field experiment where access by megabioturbators was restricted for 4 months during the growth season. There was a negative effect of megabioturbators on both the biomass and density of young seagrass ramets extending outwards from a mature seagrass meadow, but megabioturbators did not have a notable effect on seagrass growth in the meadows. Interestingly, the exclusion of megabioturbators in all tested habitats significantly modified the infaunal community composition, indicating the presence of complexity in biotic interactions and the possibility of indirect effects caused by the megabioturbators. Overall, megabioturbators have direct and indirect impact in seagrass habitats, playing a significant role in seagrass distribution patterns. © 2024 The Authors},
	author_keywords = {Cymodocea nodosa; Ecological interactions; Megabioturbators; Seagrass},
	correspondence_address = {S. Laukaityte; Groningen Institute for Evolutionary Life-Sciences, GELIFES, University of Groningen, Groningen, Nijenborgh 7, 9747, Netherlands; email: S.Laukaityte@rug.nl},
