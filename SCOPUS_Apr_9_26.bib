	author = {Jędruch, Agnieszka and Bełdowska, Magdalena and Ziółkowska, Marcelina},
	title = {The role of benthic macrofauna in the trophic transfer of mercury in a low-diversity temperate coastal ecosystem (Puck Lagoon, southern Baltic Sea)},
	year = {2019},
	journal = {Environmental Monitoring and Assessment},
	volume = {191},
