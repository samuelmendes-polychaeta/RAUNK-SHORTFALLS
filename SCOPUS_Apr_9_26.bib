@ARTICLE{Hawkes2026,
	author = {Hawkes, Sarah A. and Welman, Shaun and Rishworth, Gavin M.},
	title = {Functional trait convergence in benthic macrofauna between estuaries and estuarine-like stromatolite pools},
	year = {2026},
	journal = {Estuarine, Coastal and Shelf Science},
	volume = {332},
	pages = {},
	doi = {10.1016/j.ecss.2026.109760},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105029377045&doi=10.1016%2Fj.ecss.2026.109760&partnerID=40&md5=1655c5d730663edf881ddbcdc804f557},
	affiliations = {Department of Zoology, Nelson Mandela University, Gqeberha, 6031, South Africa; Institute for Coastal and Marine Research (CMR) and DSI/NRF Research Chair: Shallow Water Ecosystems, Nelson Mandela University, Gqeberha, 6031, South Africa; Department of Biological Sciences, University of Cape Town, Cape Town, 7701, South Africa},
	abstract = {Estuaries are shaped by fluctuating temperature and salinity levels, which select for highly tolerant species. Coastal stromatolite-forming pools occur where fresh groundwater meets the ocean, thereby creating habitats analogous to estuaries. It has been hypothesised that the benthic macroinvertebrate communities that inhabit modern supratidal stromatolite pools form a subset of the most stress-tolerant species found in estuaries. Such an ecological overlap would suggest a functional convergence that could be driven by environmental pressures. To investigate this hypothesis, we conducted a meta-analysis comparing functional traits of benthic macroinvertebrate communities across the southeastern coast of South Africa, the region with the highest density of supratidal stromatolite pools globally. Furthermore, a detailed analysis of morphometric traits of a numerically dominant macrofauna that occurs in both habitats, the amphipod Melita zeylanica , was conducted. Our findings showed that the functional traits of macroinvertebrates in stromatolite pools closely resemble those in estuaries, despite the lower species richness in these pools. Morphometric analyses of Melita zeylanica revealed no significant differences between individuals from these two habitats, suggesting that similar selective pressures may be shaping morphological traits. Fluctuations in environmental conditions such as temperature and salinity may be acting as environmental filters, favouring species with functional traits that are well-adapted to both environments. The prevalence of crawling species in stromatolite pools could provide insight into how these ancient structures which dominated most shallow aquatic coasts in the Proterozoic are able to persist in modern times, as they are less destructive than burrowing species. The lower species richness in stromatolite pools may be a consequence of their isolated nature, smaller size, and extreme environmental variability. Our findings highlight the role of environmental filtering in shaping benthic communities and suggest that functional trait convergence occurs in response to shared abiotic constraints. Future studies should investigate genetic connectivity and dispersal patterns between these habitats to better understand the mechanisms driving community similarity. © 2026 The Authors.},
	author_keywords = {Environmental filtering; Functional traits; Macrofauna; Microbialites; Morphometrics; Seascape connectivity},
	correspondence_address = {S.A. Hawkes; Department of Zoology, Nelson Mandela University, Gqeberha, 6031, South Africa; email: s217174019@mandela.ac.za},
	abbrev_source_title = {Estuar. Coast. Shelf Sci.},
	type = {Article},
