}

@ARTICLE{Cartes2004263,
	author = {Cartes, Joan E. and Carrassón, Maite},
	title = {Influence of trophic variables on the depth-range distributions and zonation rates of deep-sea megafauna: The case of the Western Mediterranean assemblages},
	year = {2004},
	journal = {Deep-Sea Research Part I: Oceanographic Research Papers},
	volume = {51},
