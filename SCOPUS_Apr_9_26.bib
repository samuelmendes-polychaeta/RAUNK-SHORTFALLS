@ARTICLE{Ditter20191,
	author = {Ditter, Robert E. and Erdman, Robert B. and Goebel, Anna M. and Bracken-Grissom, Heather D.},
	title = {Widespread phenotypic hypervariation in the enigmatic anchialine shrimp Barbouria cubensis (Decapoda: Barbouriidae)},
	year = {2019},
	journal = {Zootaxa},
	volume = {4648},
