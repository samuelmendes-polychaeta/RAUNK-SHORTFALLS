@ARTICLE{Meyer-Wolfarth2017237,
	author = {Meyer-Wolfarth, Friederike and Schrader, Stefan and Oldenburg, Elisabeth and Weinert, Joachim and Brunotte, Joachim},
	title = {Biocontrol of the toxigenic plant pathogen Fusarium culmorum by soil fauna in an agroecosystem},
	year = {2017},
	journal = {Mycotoxin Research},
