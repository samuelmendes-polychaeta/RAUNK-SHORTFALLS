	affiliations = {Institute of Environmental Sciences, Faculty of Biology, Jagiellonian University, Gronostajowa 7, Kraków, 30-387, Poland},
	abstract = {Microplastic pollution is a problem of global concern. This study is based on a laboratory experiment that was performed to investigate how soil-added microplastic particles (MP) affect soil microorganisms and mesofauna with a focus on enchytraeids (Annelida). In an experiment presented, polyethylene spherical MP of two sizes, 60 μm and 140 μm, (Cospheric LLC, USA) were applied (0.8 % w/w) to three different soils (mesocosms). The effect of MP was measured twice, 3 and 15 weeks after application as soil microbial activity (basal respiration rate), soil mesofauna feeding activity (bait-lamina test), and number and body length of enchytraeids (after wet funnel extraction). Both applied MP sizes caused a significant increase in soil respiration rate compared to controls (10 % on average). Mesofaunal feeding activity decreased in MP treated soils compared to controls (15 % on average), but the effect was significant only as an interaction between MP treatment and time. MP added to the soil did not affect the number of enchytraeids, nor their total body length or mean body length, but the body length distribution of enchytraeids differed between MP treatments and controls. These results may indicate that the effect of MP may differ between soil microorganisms and mesofauna. Changes in the body length distribution of enchytraeids, particularly a decrease in the smallest length class, may serve as a simple indicator of impending assemblage collapse. © 2024 Elsevier B.V.},
	author_keywords = {Bait-lamina test; Ecotoxicology; Polyethylene; Soil respiration rate; Wet funnel extraction},
