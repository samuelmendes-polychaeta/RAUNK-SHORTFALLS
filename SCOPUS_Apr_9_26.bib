	title = {Taphonomy and biological affinity of three-dimensionally phosphatized bromalites from the middle ordovician winneshiek lagerstätte, Northeastern Iowa, USA},
	year = {2018},
	journal = {Palaios},
	volume = {33},
	number = {1},
	pages = {1 - 15},
	doi = {10.2110/palo.2017.053},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85052843948&doi=10.2110%2Fpalo.2017.053&partnerID=40&md5=f09c755c392840b97c8729a30a12933e},
	affiliations = {Department of Geosciences, Virginia Tech, Blacksburg, 24061, VA, United States; Iowa Geological Survey, IIHR-Hydroscience and Engineering, University of Iowa, Iowa City, 52242, IA, United States; Department of Geology and Geophysics, Yale University, New Haven, 06520, CT, United States; Department of Earth and Planetary Sciences, Harvard University, Cambridge, 02138, MA, United States; Department of Earth and Environmental Sciences, University of Iowa, Iowa City, 52242, IA, United States},
	abstract = {The Winneshiek Lagerstätte occurs within an Ordovician meteorite impact structure beneath part of the city of Decorah, Iowa. The Lagerstätte has yielded an atypical marine fauna including phyllocarid crustaceans, eurypterids, conodonts, linguloid brachiopods, and jawless fish. Associated with these taxa are vermiform fossils: elongate, morphologically variable, and often three-dimensionally preserved bromalites of uncertain organisms. The preservational state of these bromalites is significantly different from that of other components of the Winneshiek biota. Here we present a compositional and microstructural analysis of the vermiform fossils in order to elucidate their taphonomy and biological affinities. The majority of studied specimens are preserved three-dimensionally and composed of calcium phosphate, while a minority are preserved as carbonaceous compressions. Winneshiek bromalites exhibit important similarities to examples documented from both older and younger sediments. They provide independent evidence of predation in the Winneshiek assemblage during the Great Ordovician Biodiversification Event. Copyright © 2013, SEPM (Society for Sedimentary Geology).},
