	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000050605&doi=10.1134%2FS1062359024701735&partnerID=40&md5=fab9f3edc64312d8fbb01cc07df903c6},
	affiliations = {Institute of Biology and Chemistry, Moscow Pedagogical State University, Moscow, 129164, Russian Federation},
	abstract = {Abstract: Widespread species of small soil arthropods are commonly used in biological monitoring of the environment. A promising development in this field could be the use of genetic methods, particularly the composition of genetic lineages in populations of polytypic species. Such a species is the widespread springtail (Collembola), Parisotoma notabilis sensu lato, which is widespread and abundant in Europe. At present, six lineages of this species are known, the genetic distances between which are close to those accepted for distinct species. Our previous research has confirmed the differentiation of genetic lineages along an urbanization gradient (natural forest–forest park–urban lawn), using Moscow oblast as an example. In this study we examined the divergence of genetic lineages in habitats in various natural zones. The least disturbed habitats were characterised by lineages L2, L4-Hebert and L0, and the most disturbed habitats by L1. Using these springtails as indicators in studies monitoring changes in the soil layer of ecosystems is possible only in zones of sympatry (co-occurrence) of different P. notabilis genetic lineages. Our data indicate that the entire European part of Russia satisfies this requirement. © Pleiades Publishing, Inc. 2024.},
	author_keywords = {28S rDNA; ecological divergence; ecotypes; soil fauna; springtail},
