	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012923065&doi=10.1016%2Fj.rsma.2025.104408&partnerID=40&md5=df647a0c57a3594641245759576eb69a},
	affiliations = {UNDECIMAR, Facultad de Ciencias, Iguá 4225, Montevideo, 11400, Uruguay; Departamento Interdisciplinario de Sistemas Costeros y Marinos, Centro Universitario Regional Este, Universidad de la República, Ruta 9 km 206, CP, Rocha, 27000, Uruguay; Instituto de Ciencias Oceánicas, Universidad de la República, Uruguay},
	abstract = {Inland-generated organic matter may represent significant trophic subsidy in a variety of aquatic systems. However few studies have tested how this terrestrial input integrates in complex sandy beach food webs. In this study, we identify the main basal resources dragged by an artificial freshwater canal to a sandy beach, and assess its relative contribution to the local food web. To this end, we sampled two representative benthic species, the cirolanid isopod Excirolana armata and the polychaete Thoracophelia furcifera, along with their potential food sources at three sites along an exposed sandy beach on the east coast of Uruguay, covering a salinity gradient: the first site at the canal mouth, the second 1 km from the mouth, and the third 13 km away. Potential food sources were grouped due to their ecological similarity and its relative contribution to the consumers diet was assessed by SIMMR mixing models. In the areas near the canal´s mouth, δ<sup>13</sup>C values were significantly depleted than at the distant site, due to a high consumption of C3 photosynthetic plants such as macrophytes and Juncaceae carried by the canal. Furthermore, suspended particulate organic matter (POM) accounted for a significant contribution across sites, reinforcing the recognized importance of surf zone trophic subsidies. As E. armata and T. furcifera were demonstrated to occupy different levels within the beach food web, this study enhances the role of the canal trophic subsidy, proving that its effects scale, at least, to intermediate positions within the trophic network of the sandy beach. © 2025 Elsevier B.V.},
	author_keywords = {Excirolana armata; Food webs; Sandy beach; Stable isotopes; Terrestrial carbon; Thoracophelia furcifera; Uruguay},
	correspondence_address = {L. Bergamino; Departamento Interdisciplinario de Sistemas Costeros y Marinos, Centro Universitario Regional Este, Universidad de la República, Rocha, Ruta 9 km 206, CP, 27000, Uruguay; email: leandro.bergamino@cure.edu.uy},
