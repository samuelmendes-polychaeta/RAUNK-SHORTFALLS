@ARTICLE{Widdicombe2008187,
	author = {Widdicombe, Stephen and Spicer, John I.},
	title = {Predicting the impact of ocean acidification on benthic biodiversity: What can animal physiology tell us?},
	year = {2008},
	journal = {Journal of Experimental Marine Biology and Ecology},
	volume = {366},
	number = {1-2},
	pages = {187 - 197},
	doi = {10.1016/j.jembe.2008.07.024},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-54049108809&doi=10.1016%2Fj.jembe.2008.07.024&partnerID=40&md5=8489e179f4ace0bb8ab049901b2306eb},
	affiliations = {Plymouth Marine Laboratory, Plymouth, PL1 3DH, Prospect Place, West Hoe, United Kingdom; Marine Biology and Ecology Research Centre, School of Biological Sciences, University of Plymouth, Plymouth, PL4 8AA, United Kingdom},
	abstract = {For the past 200 years, the oceans have been absorbing carbon dioxide at an unprecidented rate. It is now evident that this ongoing process has already significantly altered seawater carbon chemistry at a global scale and will continue to do so for hundreds of years to come; a phenomenon termed "ocean acidification". The challenge currently facing scientists is to predict the long term implications of ocean acidification for the diversity of marine organisms and for the ecosystem functions this diversity sustains. This challenge is all the more difficult considering that empirical data which specifically address the impact of ocean acidification on marine biodiversity are currently lacking. In the face of growing political and public pressure to provide answers, what predictions can be made and how reliable are the assumptions on which those predictions depend? Here we review the extent to which the few existing data, and understanding gained from previous physiological studies, can be used to make predictions for marine biodiversity. In doing so we also scrutinise some established paradigms concerning the impact of hypercapnia, resulting from seawater acidification, on marine organisms. © 2008 Elsevier B.V. All rights reserved.},
	author_keywords = {Biodiversity; Ocean acidification; Organism physiology},
	correspondence_address = {S. Widdicombe; Plymouth Marine Laboratory, Plymouth, PL1 3DH, Prospect Place, West Hoe, United Kingdom; email: swi@pml.ac.uk},
	abbrev_source_title = {J. Exp. Mar. Biol. Ecol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 330}
}

