	correspondence_address = {Ó. Monroig; Instituto de Acuicultura Torre de la Sal (IATS, CSIC), Consejo Superior de Investigaciones Científicas, Ribera de Cabanes, Castellón, 12595, Spain; email: oscar.monroig@csic.es},
	abbrev_source_title = {Biochim. Biophys. Acta Mol. Cell Biol. Lipids},
