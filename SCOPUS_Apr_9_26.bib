@ARTICLE{Sun2016,
	author = {Sun, Shao'E and Li, Qi and Kong, Lingfeng and Yu, Hong and Zheng, Xiaodong and Yu, Ruihai and Dai, Lina and Sun, Yan and Chen, Jun and Liu, Jun and Ni, Lehai and Feng, Yanwei and Yu, Zhenzhen and Zou, Shanmei and Lin, Jiping},
