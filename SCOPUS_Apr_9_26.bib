@ARTICLE{Larsen200847,
	author = {Larsen, Poul S. and Madsen, Caroline V. and Riisgård, Hans Ulrik},
	title = {Effect of temperature and viscosity on swimming velocity of the copepod Acartia tonsa, brine shrimp Artemia salina and rotifer Brachionus plicatilis},
	year = {2008},
	journal = {Aquatic Biology},
	volume = {4},
	number = {1},
	pages = {47 - 54},
	doi = {10.3354/ab00093},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-70350600953&doi=10.3354%2Fab00093&partnerID=40&md5=2fa59b29b983d185de32d29692546d8e},
	affiliations = {Department of Mechanical Engineering, Fluid Mechanics Section, Technical University of Denmark, 2800 Kgs. Lyngby, Building 403, Denmark; Marine Biological Research Centre, University of Southern Denmark, 5300 Kerteminde, Hindsholmvej 11, Denmark},
	abstract = {Beating cilia are important organelles for swimming in many zooplanktonic aquatic organisms, including many invertebrate larvae, rotifers and ciliates, but other planktonic organisms, such as copepods and brine shrimps, use muscle-powered swimming appendages. In recent studies we found that the temperature-dependent viscosity of seawater is the key physical/mechanical fac-tor that controls the beat frequency of water-pumping cilia in mussels and the swimming velocity in a ciliate. The present study on the swimming velocity of 3 zooplankton organisms, however, shows that the response of swimming velocity to a change in viscosity is different when due to a change in temperature or, at constant temperature, due to a manipulation of viscosity by addition of a high-mol-ecular-weight polymer (polyvinyl pyrrolidone, PVP) to the ambient seawater. There is a biological effect (fraction of total reduction of swimming velocity for a 10°C temperature reduction) that is found to be largest for the brine shrimp Artemia salina nauplius (37%) and the rotifer Brachionus plicatilis (26%), but negligible for the copepod Acartia tonsa (4%). We suggest that experimental data on change in swimming velocity (V) due to change in kinematic viscosity (ν) be correlated in terms of a power law, V ∝ ν-m. The present data on swimming velocity of copepods, brine shrimps and rotifers show values of exponent m ≈ 1.5 to 3, with a trend of decreasing values for increasing size of species. Differences in m-values may be ascribed to differences in propulsion system, body drag and size. © Inter-Research 2008.},
	author_keywords = {Kinematic viscosity; PVP; Q<sub>10</sub>; Swimming velocity; Temperature},
	correspondence_address = {P. S. Larsen; Department of Mechanical Engineering, Fluid Mechanics Section, Technical University of Denmark, 2800 Kgs. Lyngby, Building 403, Denmark; email: psl@mek.dtu.dk},
	abbrev_source_title = {Aqua. Biol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 63; All Open Access; Bronze Open Access}
}

@ARTICLE{Karle2007265,
