@ARTICLE{Ito2024,
	author = {Ito, Maysa and Guy-Haim, Tamar and Sawall, Yvonne and Franz, Markus and Buchholz, Björn and Hansen, Thomas and Neitzel, Philipp and Pansch, Christian and Steinhoff, Tobias and Wahl, Martin and Weinberger, Florian and Scotti, Marco},
	title = {Responses at various levels of ecological hierarchy indicate acclimation to sequential sublethal heatwaves in a temperate benthic ecosystem},
	year = {2024},
	journal = {Philosophical Transactions of the Royal Society B: Biological Sciences},
	volume = {379},
