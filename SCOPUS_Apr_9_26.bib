@ARTICLE{Wiesebron2021,
	author = {Wiesebron, Lauren E. and Steiner, Natalie and Morys, Claudia and Ysebaert, Tom and Bouma, Tjeerd J.},
	title = {Sediment Bulk Density Effects on Benthic Macrofauna Burrowing and Bioturbation Behavior},
	year = {2021},
	journal = {Frontiers in Marine Science},
	volume = {8},
	pages = {},
	doi = {10.3389/fmars.2021.707785},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85112151170&doi=10.3389%2Ffmars.2021.707785&partnerID=40&md5=b76ec02c820924c2c02db9229221ba9e},
	affiliations = {Department of Estuarine and Delta Systems (EDS), Royal Netherlands Institute for Sea Research, Utrecht University, Utrecht, Netherlands; Wageningen Marine Research, Wageningen University Research, Wageningen, Netherlands; Building With Nature Group, University of Applied Sciences, Vlissingen, Netherlands; Faculty of Geosciences, Utrecht University, Utrecht, Netherlands},
	abstract = {Benthic macrofauna are a key component of intertidal ecosystems. Their mobility and behavior determine processes like nutrient cycling and the biogeomorphic development of intertidal flats. Many physical drivers of benthic macrofauna behavior, such as sediment grain size, have been well-studied. However, little is known about how sediment bulk density (a measure of sediment compaction and water content) affects this behavior. We investigated the effect of bulk density on the burrowing rate, burrowing depth, bioturbation activity, and oxygen consumption of bivalves (Limecola balthica, Scrobicularia plana, and Cerastoderma edule) and polychaetes (Hediste diversicolor and Arenicola marina) during a 29-day mesocosm experiment. We compared four sediment treatments consisting of two sediments of differing grain size classes (sandy and muddy) with two bulk densities (compact and soft). Overall, bulk density had a strong effect on benthic macrofauna behavior. Benthic macrofauna burrowed faster and bioturbation more intensely in soft sediments with low bulk density, regardless of grain size. In addition, L. balthica burrowed deeper in low bulk density sediment. Finally, we found that larger bivalves (both C. edule and S. plana) burrowed slower in compact sediment than smaller ones. This study shows that benthic macrofauna change their behavior in subtle but important ways under different sediment bulk densities which could affect animal-sediment interactions and tidal flat biogeomorphology. We conclude that lower bulk density conditions lead to more active macrofaunal movement and sediment reworking. © Copyright © 2021 Wiesebron, Steiner, Morys, Ysebaert and Bouma.},
	author_keywords = {animal-sediment interactions; benthic macrofauna; bioturbation; bulk density; burrowing behavior; grain size; intertidal mudflat},
	correspondence_address = {L.E. Wiesebron; Department of Estuarine and Delta Systems (EDS), Royal Netherlands Institute for Sea Research, Utrecht University, Utrecht, Netherlands; email: lauren.wiesebron@nioz.nl},
	abbrev_source_title = {Front. Mar. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 37; All Open Access; Gold Open Access; Green Open Access}
}

