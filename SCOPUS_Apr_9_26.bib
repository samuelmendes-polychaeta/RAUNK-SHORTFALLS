	author = {Robert, Alexandre Elie and Quillien, Nolwenn and Bacha, Mahmoud and Caulle, Clémence and Nexer, Maëlle and Parent, Briz and Garlan, Thierry and Desroy, Nicolas},
	title = {Sediment migrations drive the dynamic of macrobenthic ecosystems in subtidal sandy bedforms},
	year = {2021},
	journal = {Marine Pollution Bulletin},
	volume = {171},
	pages = {},
	doi = {10.1016/j.marpolbul.2021.112695},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85109817023&doi=10.1016%2Fj.marpolbul.2021.112695&partnerID=40&md5=865d7879b0cd6a270a8e6ce2286c6b3e},
	affiliations = {France Energies Marines Environmental Integration R&D Program, 525 Avenue Alexis de Rochon, Plouzané, 29280, France; IFREMER, Unité Littoral, Laboratoire Environnement et Ressources de Bretagne Nord, CRESCO, 38 rue du Port-Blanc, Dinard, 35800, France; Laboratoire d'Océanologie et de Géosciences, UMR 8187, CNRS, Université du Littoral Côte d'Opale, 32 Avenue Foch, Wimereux, 62930, France; Ocean Zoom, 2 chemin de la Houssinière, Nantes, 44300, France; Shom, Brest, 29200, France},
	abstract = {A traditional taxonomic approach coupled to a biological traits analysis was conducted in order to provide a new insight into macrobenthic communities associated with subtidal sandy environments. Results suggest that the macro-scale distribution of benthic communities is mainly driven by the migration rate of bedforms (sandbank, barchan dune and transversal dune) which changes the sediment grain size and reduces macrobenthic diversity. A classic scheme of species/traits succession was also observed from less to more physically disturbed areas. Finally, the high frequency of migration events homogenized macrobenthic communities between the troughs to the crest of bedforms. As bedforms areas are targeted for the commissioning of offshore windfarms the information provided by the present paper will be particularly useful to implement the environmental impact assessment required for such activities at sea. © 2021 Elsevier Ltd},
	author_keywords = {Biological traits; Ecosystem functioning; Macrobenthos; North Sea; Sandy bedforms; Soft sediments; Spatio-temporal variations},
	correspondence_address = {A.E. Robert; France Energies Marines Environmental Integration R&D Program, Plouzané, 525 Avenue Alexis de Rochon, 29280, France; email: alexandre.robert@ifremer.fr},
	abbrev_source_title = {Mar. Pollut. Bull.},
	type = {Article},
	publication_stage = {Final},
