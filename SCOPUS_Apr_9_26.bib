@ARTICLE{Haram20182751,
	author = {Haram, Linsey E. and Kinney, Kaitlin A. and Sotka, Erik E. and Byers, James E.},
	title = {Mixed effects of an introduced ecosystem engineer on the foraging behavior and habitat selection of predators},
	year = {2018},
	journal = {Ecology},
