	author = {Carter, Mauricio J. and Vega-Retter, Caren and Ramos-Jiliberto, Rodrigo},
	title = {Non-lethal effects of invertebrate predators on Daphnia: Morphological and life-history consequences of water mite kairomone},
	year = {2008},
	journal = {Freshwater Biology},
