@ARTICLE{Ndatimana2025,
	author = {Ndatimana, Gilbert and Dusabe, Marie Claire and Albrecht, Christian},
	title = {Bridging riverine and lacustrine systems: Macroinvertebrate indicators of ecological health in the Rwandan Congo basin},
	year = {2025},
	journal = {Environmental Monitoring and Assessment},
	volume = {197},
	number = {11},
