@ARTICLE{Pitacco2019126,
	author = {Pitacco, Valentina and Mistri, Michele and Aleffi, Ida Floriana and Lardicci, Claudio and Prato, Susanna and Tagliapietra, Davide and Munari, Cristina},
	title = {Spatial patterns of macrobenthic alpha and beta diversity at different scales in Italian transitional waters (central Mediterranean)},
