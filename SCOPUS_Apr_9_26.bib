@ARTICLE{EL-AZZOUZI2026,
	author = {EL-AZZOUZI, Zakaria and DAHBI, Abdallah and SABOUR, Brahim and CHAOUTI, Abdellatif},
	title = {Environmental filtering shapes the functional composition of epibenthic crustaceans in intertidal mussel beds of northwestern Morocco: A trait-based approach},
	year = {2026},
	journal = {Science of the Total Environment},
	volume = {1013},
	pages = {},
	doi = {10.1016/j.scitotenv.2025.181312},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105026662467&doi=10.1016%2Fj.scitotenv.2025.181312&partnerID=40&md5=ef5e58c6a1f818d9797ea5c8cbacb86f},
	affiliations = {Laboratory of Plant Biotechnology, Ecology and Ecosystem Valorization – CNRST Labeled Research Unit N°10, Faculty of Sciences, Chouaib Doukkali University, El Jadida, 24000, Morocco; Laboratory of Ecotoxicology, Bioresources and Coastal Geomorphology, Polydisciplinary Faculty, Cadi Ayyad University, Safi, Morocco},
	abstract = {Mussel beds host diverse epibenthic crustacean communities that serve as valuable indicators of environmental change along the Moroccan Atlantic coast. This study presents the first comprehensive assessment of crustacean assemblages associated with Mytilus galloprovincialis beds. Using a multi-approach framework that combined taxonomic diversity, biotic indices (AMBI, M-AMBI, and BENTIX), and the Biological Traits Approach (BTA), this study investigated spatiotemporal responses of mussel-associated assemblages to natural and anthropogenic stressors across six intertidal stations from Azemmour to Essaouira (NW Morocco). The study recorded 25 species, dominated by amphipods and isopods. Species richness declined by 25–50 % at polluted stations, although mussel bed structural complexity facilitated the persistence of some sensitive taxa, acting as habitat-mediated refugia. Unexpectedly, several traditionally pollution-sensitive species (Apohyale perrieri, Idotea granulosa, Dynamene bidentata) exhibited two- to fourfold increases in abundance under contaminated conditions, challenging established biomonitoring assumptions. Biotic indices effectively detected assemblage-level changes, while BTA revealed systematic functional reorganization along pollution gradients. Environmental filtering favoured reduced mobility, smaller body sizes, and suspension feeding, while eliminating motile species with diverse feeding strategies. This filtering produced paradoxical diversity patterns: functional richness decreased under stress, functional dispersion increased, functional evenness declined and functional redundancy rose as multiple taxa converged on stress-tolerance strategies. Despite species loss, functional diversity remained stable, indicating that ecosystem functions were maintained through species substitution. Indicator Value Analysis identified nine taxa as exclusive to pristine stations, with the amphipod Ampithoe sp. emerging as the most reliable bioindicator. Overall, functional metrics provided early-warning signals of ecosystem change and highlight the importance of integrating taxonomic, biotic, and trait-based approaches to improve biomonitoring and conservation of Moroccan intertidal habitats under growing anthropogenic pressures. © 2025 Elsevier B.V.},
	author_keywords = {Atlantic coast of Morocco; Bioindication; Biological traits approach/analysis; Community assembly; Ecosystem functioning; Environmental disturbance; Environmental filters; Functional diversity; Intertidal rocky shores; Mytilus galloprovincialis; Trait-based biomonitoring},
	correspondence_address = {A. CHAOUTI; Laboratory of Plant Biotechnology, Ecology and Ecosystem Valorization – CNRST Labeled Research Unit N°10, Faculty of Sciences, Chouaib Doukkali University, El Jadida, 24000, Morocco; email: chaouti@ucd.ac.ma},
