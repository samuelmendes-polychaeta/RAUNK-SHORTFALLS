	year = {2022},
	journal = {Estuarine, Coastal and Shelf Science},
	volume = {278},
	pages = {},
	doi = {10.1016/j.ecss.2022.108121},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140923220&doi=10.1016%2Fj.ecss.2022.108121&partnerID=40&md5=41fa9170d0b46a9d12cdbd88f257f3b6},
	affiliations = {Dipartimento di Scienze Chimiche, Fisiche, Matematiche e Naturali, Università di Sassari, Via Piandanna 4, Sassari, 07100, Italy},
	abstract = {Biogenic structures edified by crustose coralline algae (CCA) are known to enhance biodiversity, but the mechanisms involved are only partially defined. This study aims at contributing to the knowledge of the interaction between habitat-builder CCA and epibiont assemblages through a manipulative approach. To achieve this objective, transplantations of the CCA Lithophyllum stictiforme were performed to test the following hypotheses: 1) the structure of L. stictiforme epibiont assemblage changes between depth and biogeographic area; 2) L. stictiforme epibiont assemblage is different and more diversified than the assemblage recruited on bare rock; 3) the early L. stictiforme epibiont assemblage differ from the mature L. stictiforme epibiont assemblage. A total of 63 epibiontic taxa were found on the transplanted L. stictiforme thalli, such as 7 Chlorophyta, 10 Ochrophyta, 40 Rhodophyta, 1 Sarcomastigophora, 1 Porifera, 4 Bryozoa. The sessile assemblage recruited on transplanted L. stictiforme thalli depended on sites and depths, and it had a higher taxa richness compared to that colonizing the bare rock. The early recruited assemblage on L. stictiforme transplanted thalli compared to the mature assemblage on untouched thalli was different mostly in the relative abundance of taxa, rather than in species composition. These manipulative experiments highlighted for the first time the role of a common CCA on the development and biodiversity of coralligenous assemblages, contributing to emphasize the importance of CCA conservation efforts. © 2022 Elsevier Ltd},
	author_keywords = {Biodiversity; Biogenic structures; Coralligenous reefs; Crustose coralline algae; Epibiota; Mediterranean sea},
	correspondence_address = {L. Piazzi; Dipartimento di Scienze Chimiche, Fisiche, Matematiche e Naturali, Università di Sassari, Sassari, Via Piandanna 4, 07100, Italy; email: lpiazzi@uniss.it},
