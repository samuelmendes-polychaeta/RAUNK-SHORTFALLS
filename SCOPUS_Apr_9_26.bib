	source = {Scopus},
	note = {Cited by: 21}
}

@ARTICLE{Segura20131739,
	author = {Segura, A.M. and Calliari, D. and Fort, H. and Lan, B.L.},
	title = {Fat tails in marine microbial population fluctuations},
	year = {2013},
	journal = {Oikos},
	volume = {122},
