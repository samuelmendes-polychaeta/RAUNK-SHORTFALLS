@ARTICLE{Saddiki2025,
	author = {Saddiki, Zakariaa and Layachi, Mostafa and Akodad, Mustapha and Oujidi, Bouchra and Baghour, Mourad and Le Guillou, Jean-Etienne and Maanan, Mohamed and Skalli, Ali},
	title = {Integrated assessment of the ecological status of a Mediterranean coastal lagoon based on benthic communities},
	year = {2025},
	journal = {Environmental Monitoring and Assessment},
	volume = {197},
	number = {12},
	pages = {},
	doi = {10.1007/s10661-025-14706-y},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021200812&doi=10.1007%2Fs10661-025-14706-y&partnerID=40&md5=d18ce2fdb319ec8158ab93459a056b59},
	affiliations = {LETG, UMR 6554, University of Nantes, BP 81227, Bâtiment IGARUN, 1 rue de la Noë, Nantes, 44300, France; Laboratory OLMAN-BPGE, Multidisciplinary Faculty of Nador, Mohamed First University, Oujda, Morocco; National Institute of Fisheries Research (INRH), Nador, Morocco; Marchica Observatory, Department of Sustainable Development, Nador, Morocco},
	abstract = {Coastal lagoons, recognized as some of the most productive ecosystems, are also vulnerable to increasing human pressures, particularly due to the discharge of wastewater. This study aimed to evaluate, for the first time, the ecological status of the Marchica Lagoon (Mediterranean coast of Morocco). An integrated ecological monitoring approach, based on spatial diversity models of species assemblages (analyzed using taxonomic indices, structural trophic guilds as indicators of functional biodiversity, and marine biotic indices), was conducted in relation to sedimentary and hydrological descriptors. Water movements in the lagoon, such as currents and river waters, influence sediment distribution and create differences between stations close to pollution sources and those further away. This explains 66% of the observed variations in species living at the bottom of the water. dbRDA-DistLM analyses showed that water temperature, turbidity, and sediment type (such as mud, sand, and silt) are the main factors affecting species distribution. Stations near pollution sources are characterized by more silt and lower oxygenation, while those farther away show greater sediment diversity and better water quality. In total, 184 species from six taxonomic groups were recorded. The results revealed generally good to high ecological quality for most stations according to five biotic indices (AMBI, BENTIX, H′, M-AMBI, and ITI). However, five stations located on the continental edge were classified as moderate, highlighting the persistence of environmental pressures despite restoration efforts, such as the opening of a new maritime passage and the installation of wastewater treatment stations. © The Author(s), under exclusive licence to Springer Nature Switzerland AG 2025.},
	author_keywords = {Anthropogenic pressures; Biotic indices; Ecological quality; Functional biodiversity; Wastewater discharge},
	correspondence_address = {Z. Saddiki; LETG, UMR 6554, University of Nantes, Nantes, BP 81227, Bâtiment IGARUN, 1 rue de la Noë, 44300, France; email: zakariaa.saddiki@etu.univ-nantes.fr},
