	author = {De Borger, Emil and van Oevelen, Dick and Mavraki, Ninon and De Backer, Annelies and Braeckman, Ulrike and Soetaert, Karline and Vanaverbeke, Jan},
	title = {Offshore wind farms modify coastal food web dynamics by enhancing suspension feeder pathways},
	year = {2025},
