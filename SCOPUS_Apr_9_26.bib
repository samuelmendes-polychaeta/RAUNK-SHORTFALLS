	title = {Characterization and expression of cytoplasmic copper/zinc superoxide dismutase (CuZn SOD) gene under temperature and hydrogen peroxide (H2O2) in rotifer Brachionus calyciflorus},
	year = {2013},
	journal = {Gene},
	volume = {518},
