	author = {Bass, A.L. and Hinch, S.G. and Teffer, A.K. and Patterson, D.A. and Miller, K.M.},
	title = {A survey of microparasites present in adult migrating Chinook salmon (Oncorhynchus tshawytscha) in south-western British Columbia determined by high-throughput quantitative polymerase chain reaction},
