	affiliations = {Alfred Wegener Institute for Polar and Marine Research, 27515 Bremerhaven, P.O. Box 120161, Germany; Department of Biological Sciences, Florida Atlantic University, SC 214, Boca Raton, FL 33431, 777 Glades Road, United States; Gymnasium Wesermünde, 27580 Bremerhaven, Humboldtstrasse 12-14, Germany; DIP.TE.RIS Dipartimento per lo Studio del Territorio e Delle Sue Risorse, Università di Genova, 5-16132 Genova, Viale Benedetto XV, Italy},
	abstract = {Annual growth rates of Antarctic marine organisms are low compared to their relatives from warmer waters. Previous studies hypothesise that high food availability during austral spring-summer may enable Antarctic invertebrates to attain comparatively high short-term growth rates despite the low temperature. Neither a temperature-growth experiment with juvenile Adamussium colbecki (Smith 1902) nor the comparison of A. colbecki summer growth rates with an empirical scallop specific growth-to-temperature relationship could confirm this hypothesis. Hence, summer growth rates of young, immature A. colbecki are strongly affected by temperature, i.e. no "uncoupling" from temperature. © Springer-Verlag 2005.},
