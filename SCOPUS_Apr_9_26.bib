}

@ARTICLE{Conti2022,
	author = {Conti, Erminia and Mulder, Christian},
	title = {Chemistry-driven Enchytraeidae assemblages acting as soil and ecosystem engineers in edaphic communities},
	year = {2022},
	journal = {Ecological Indicators},
	volume = {144},
	pages = {},
	doi = {10.1016/j.ecolind.2022.109529},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85139595578&doi=10.1016%2Fj.ecolind.2022.109529&partnerID=40&md5=384c64bd34ca6425678b1b42a4a3117f},
	affiliations = {Dept. of Biological, Geological and Environmental Sciences, University of Catania, Italy},
	abstract = {Smaller body-sized invertebrate groups are known to be highly sensitive to environmental pollution. Like soil nematodes, enchytraeids have very permeable cuticles and come into direct contact with heavy metals; therefore they can be adversely affected by soil pollution. However, in contrast to nematodes, fewer data on enchytraeids are at our disposal to assess their functional responses to heavy metals. Such an assessment would be of greatest value, as in any edaphic community, enchytraeids are the only functional group bridging the detrital energy flux across the bacterial-driven and the fungal-driven pathways. For this purpose we investigated and evaluated the effect of heavy metals on the occurrence and biomass of enchytraeids in different soils in The Netherlands. Samplings of topsoils were carried out in 297 sites with Pleistocene sandy soils, river clay and sea clay under different environmental stress and all recovered enchytraeid species have been included in three existing phylogenetical clades (hereafter: A, B, and C). Our results show that the biomass of the enchytraeid species belonging to the Clade C is highly correlated with Cr, Cu and Zn in sandy soils (all 2-tails significance values share p < 0.005, n = 186) but is correlated with Cu and Hg in loamy soils (p < 0.05, n = 111), whilst the biomass of the enchytraeid species belonging to the Clade B is highly correlated with either Cd + Cu + Pb in sandy soils (p < 0.025, n = 186) or Hg + Pb in loamy soils (p < 0.05, n = 111). The entire enchytraeid community actively contributes to promote the rapid turnover of soil organic matter. Given that clay-rich soils retain a much higher amount of heavy metals in contrast to sandy soils, most enchytraeids share different values as bioindicators according to the soil type, even comparing river clay with sea clay. Hence, elemental availabilities have disproportionately strong effects on enchytraeids and on the entire edaphic community according to the soil types. © 2022 The Author(s)},
	author_keywords = {Enchytraeids; Heavy metals; Pollution; Soil types; The Netherlands},
	correspondence_address = {C. Mulder; email: christian.mulder@unict.it},
	abbrev_source_title = {Ecol. Indic.},
	type = {Article},
	publication_stage = {Final},
