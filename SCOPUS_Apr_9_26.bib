	source = {Scopus},
	note = {Cited by: 27; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Fontinha2021,
	author = {Fontinha, Bruno M. and Zekoll, Theresa and Al-Rawi, Mariam and Gallach, Miguel and Reithofer, Florian and Barker, Alison J. and Hofbauer, Maximilian and Fischer, Ruth M. and Von Haeseler, Arndt and Baier, Herwig and Tessmar-Raible, Kristin},
	title = {TMT-Opsins differentially modulate medaka brain function in a context-dependent manner},
