	title = {Sulfurimonas microaerophilic sp. nov. and Sulfurimonas diazotrophicus sp. nov.: Two Novel Nitrogen-Fixing and Hydrogen- and Sulfur-Oxidizing Chemolithoautotrophs Within the Campylobacteria Isolated from Mangrove Sediments},
	year = {2025},
