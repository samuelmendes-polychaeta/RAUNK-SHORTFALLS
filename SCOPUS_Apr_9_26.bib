@ARTICLE{Johnson2017243,
	author = {Johnson, Kevin B. and Soltis, Kerry A.},
	title = {Larval supply and recruitment of the ivory barnacle Balanus eburneus (Gould, 1841) on oyster cultch used in oyster-reef restoration},
	year = {2017},
	journal = {Journal of Crustacean Biology},
	volume = {37},
