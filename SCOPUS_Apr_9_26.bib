}

@ARTICLE{Zeimet2025,
	author = {Zeimet, Timo and Gorb, Stanislav N. and Krings, Wencke},
	title = {Morphology and material composition of raptorial foreleg cuticles in praying mantises Gongylus gongylodes and Sphodromantis lineola},
	year = {2025},
	journal = {Scientific Reports},
	volume = {15},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-025-06427-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105008690950&doi=10.1038%2Fs41598-025-06427-6&partnerID=40&md5=d40957a012da6c08396421d958a852fc},
	affiliations = {Department of Electron Microscopy, Institute of Cell and Systems Biology of Animals, University of Hamburg, Martin-Luther-King-Platz 3, Hamburg, 20146, Germany; Section Mammalogy and Palaeoanthropology, Leibniz Institute for the Analysis of Biodiversity Change, Martin-Luther-King-Platz 3, Hamburg, 20146, Germany; Department of Functional Morphology and Biomechanics, Zoological Institute, Kiel University, Am Botanischen Garten 1–9, Kiel, 24118, Germany; Department of Cariology, Endodontology and Periodontology, Leipzig University, Liebigstraße 12, Leipzig, 04103, Germany},
	abstract = {Praying mantises (Mantodea, Insecta) are capable of capturing larger invertebrates and also smaller vertebrates with their raptorial forelegs. Forelegs may exhibit morphological adaptations based on the type of prey they prefer (e.g., softer or harder invertebrates). Since the functionality of a structure is also influenced by its material composition, it could be tailored to match the prey as well. To pave the way for deeper studies on trophic adaptations in insects, this study investigates the morphology, material composition and mechanical properties of the raptorial forelegs of two species of praying mantises with different prey preferences. Sphodromantis lineola favours harder and larger invertebrates, such as cockroaches (Blattaria), whereas Gongylus gongylodes feeds on softer and smaller invertebrates like flies (Diptera). Both males and females were examined in both species to assess potential sexual dimorphism. The results suggest that the morphology of the raptorial forelegs, the arrangement and tiltability of the spines, and the material mechanical properties of the leg cuticle could potentially be related to the preferred prey type. Autofluorescence documentations reflected the presence of micro gradients in the spines, which are related to their mechanical properties. However, pigmentation in the structures of G. gongylodes seemed to corrupt the autofluorescence, complicating comparisons between the species. Elemental analysis confirmed the presence of traces of transition and alkaline earth metals in the raptorial forelegs, though no significant species-specific differences and no correlations to the mechanical properties were detected. © The Author(s) 2025.},
	author_keywords = {Biomechanics; Cuticle; Elemental composition; Hardness; Nanoindentation; Prey capture; Young’s modulus},
	correspondence_address = {W. Krings; Department of Electron Microscopy, Institute of Cell and Systems Biology of Animals, University of Hamburg, Hamburg, Martin-Luther-King-Platz 3, 20146, Germany; email: wencke.krings@uni-hamburg.de},
	abbrev_source_title = {Sci. Rep.},
