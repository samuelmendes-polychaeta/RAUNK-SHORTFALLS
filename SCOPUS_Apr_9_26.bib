}

@ARTICLE{Small2016604,
	author = {Small, Daniel P. and Milazzo, Marco and Bertolini, Camilla and Graham, Helen and Hauton, Chris and Hall-Spencer, Jason M. and Rastrick, Samuel P. S.},
	title = {Temporal fluctuations in seawater pCO2 may be as important as mean differences when determining physiological sensitivity in natural systems},
