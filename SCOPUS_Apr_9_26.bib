	doi = {10.21608/ejabf.2026.448969.7143},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105030825718&doi=10.21608%2Fejabf.2026.448969.7143&partnerID=40&md5=046529efda9d3e1e0d4ba805fa59f3a3},
	affiliations = {Department of Aquaculture, Faculty of Fisheries and Marine, Universitas Airlangga, Surabaya, Indonesia; Research Group of Environment and Fisheries Resources Management, Faculty of Fisheries and Marine, Universitas Airlangga, Surabaya, Campus C Unair, Surabaya, 60115, Indonesia; Program Study of Aquaculture, Faculty of Fisheries and Marine, Universitas Airlangga, Surabaya, Indonesia; Program Study of Biotechnology of Fisheries and Marine, Faculty of Fisheries and Marine, Universitas Airlangga, Surabaya, Indonesia; Department of Marine, Faculty of Fisheries and Marine, Universitas Airlangga, Surabaya, Indonesia; Department of Aquatic Resources Management, Faculty of Fisheries and Marine Sciences, IPB University, Indonesia},
	abstract = {The Ujungpangkah Estuary is a productive aquatic ecosystem characterized by a high level of biodiversity. The mixing of low-salinity and high-salinity water masses in estuarine zones significantly impacts the distribution of aquatic biota, such as zooplankton communities. This study aims to analyze zooplankton diversity and community structure as biological indicators of water pollution around the Bengawan Solo River and Ujungpangkah Waters. Research was conducted from March to October 2022 across three stations: riverine, estuarine, and marine environments. Biological indicators were assessed based on abundance, diversity (H′), evenness (E), and dominance (C) indices. The results identified seven zooplankton phyla: Protozoa, Echinodermata, Brachiopoda, Cordata, Annelida, Rotifera, and Arthropoda. Zooplankton abundance in the Bengawan Solo River Estuary and Ujungpangkah Waters ranged from 5,333 to 28,444 ind/m³, with the peak occurring in September. The diversity index (H′) ranged from 0.76 to 1.52, while the evenness index (E) was high (0.84–0.98). Furthermore, the dominance index (C) ranged from 0.25 to 0.50, indicating that no single zooplankton taxon dominates these waters. © 2026, Egyptian Society for the Development of Fisheries and Human Health. All rights reserved.},
	author_keywords = {Aquatic biota; Aquatic ecosystem; Biodiversity; Zooplankton},
