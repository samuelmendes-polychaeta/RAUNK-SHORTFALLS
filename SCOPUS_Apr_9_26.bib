@ARTICLE{Motta2021,
	author = {Motta, Maria Lorenza Leal and Filho, Jaire Alves Ferreira and de Melo, Ricardo Rodrigues and Zanphorlin, Leticia Maria and dos Santos, Clelton Aparecido and de Souza, Anete Pereira},
	title = {A novel fungal metal-dependent α-l-arabinofuranosidase of family 54 glycoside hydrolase shows expanded substrate specificity},
	year = {2021},
	journal = {Scientific Reports},
	volume = {11},
