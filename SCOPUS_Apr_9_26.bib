	year = {2003},
	journal = {Marine Ecology Progress Series},
	volume = {256},
	pages = {45 - 56},
	doi = {10.3354/meps256045},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0043073033&doi=10.3354%2Fmeps256045&partnerID=40&md5=b6340b86490db3d056d34c05d1db0652},
	affiliations = {University of Cologne, Dept. of Gen. Ecology and Limnology, Zoological Institute, 50923 Köln (Cologne), Weyertal 119, Germany; Free University of Berlin, Dept. of Biol., Chem. and Pharmacy, Institute of Biology/Zoology, 14195 Berlin, Königin-Luise-Str. 1-3, Germany; Leipniz Inst. Freshw. Ecol./I., Dept. of Limnology/Stratified Lakes, 16775 Stechlin-Neuglobsow, Alte Fischerhütte 2, Germany},
	abstract = {Due to the significant lack of information on the community structure of deep-sea nanoflagellates and other nanofauna components as a potentially important component of deep-sea matter fluxes, the aim of the present study was to check whether there is a specific deep-sea nanofauna (<20 μm) community. Studies were carried out in the deep oligotrophic basins of the Eastern Mediterranean Sea around Greece (1249 to 4260 m depth). Direct microscopic counts and quantitative cultivation techniques were used to estimate the abundance and community structure of heterotrophic flagellates and amoebae from abyssopelagial samples and deep-sea sediments. Euglenids and bodonids were the dominant groups comprising about 2/3 of the abundance and biomass of flagellate nanofauna. Our direct counts clearly demonstrate that attention also has to be paid to species which seldom appear in crude cultures. The records of hemimastigid-like forms were remarkable in this respect. Among the 35 deep-sea nanofauna taxa identified here, 8 never appeared in cultures and 18 taxa were found only in cultures. At least 9 taxa have not been previously recorded from the deep sea. Meteora sporadica seems to be the first record of an endemic deep-sea heterotrophic nanoprotist. The variety of functional groups recorded indicates the nanofauna as part of a complex microbial food web in the deep sea. Estimates of potential maximum growth rates of fresh isolates from deep-sea waters ranged from 1 to 6.3 d (Ancyromonas, Amastigomonas, Bodo, Caecitellus, Cafeteria, Kiitoksia, Massisteria, Percolomonas). There was considerable clonal variability.},
	author_keywords = {Amoebae; Biodiversity; Deep-sea benthos; Deep-sea plankton; Flagellates; Growth rate; Nanofauna; Protozoa},
	correspondence_address = {H. Arndt; University of Cologne, Dept. of Gen. Ecology and Limnology, Zoological Institute, 50923 Köln (Cologne), Weyertal 119, Germany; email: hartmut.arndt@uni-koeln.de},
	abbrev_source_title = {Mar. Ecol. Prog. Ser.},
