@ARTICLE{Zhu201497,
	author = {Zhu, Zhenchang and Bouma, Tjeerd J. and Ysebaert, Tom and Zhang, Liquan and Herman, Peter M.J.},
	title = {Seed arrival and persistence at the tidal mudflat: Identifying key processes for pioneer seedling establishment in salt marshes},
	year = {2014},
	journal = {Marine Ecology Progress Series},
	volume = {513},
	pages = {97 - 109},
	doi = {10.3354/meps10920},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84908467023&doi=10.3354%2Fmeps10920&partnerID=40&md5=e45e4ff8920f4561c22ae461cd6a1874},
	affiliations = {Spatial Ecology Department, Royal Netherlands Institute for Sea Research, Yerseke, 4400AC, Netherlands; State Key Laboratory of Estuarine and Coastal Research, East China Normal University, Shanghai, 200062, China},
	abstract = {Salt marshes are highly valuable ecosystems that provide numerous important ecosystem services. Given the global marsh decline, there is a pressing need to understand the natural bottlenecks and thresholds to their establishment and long-term ecological maintenance. Seed presence in the right place and time is a prerequisite for pioneer establishment. We performed field surveys and manipulative seed-bank experiments on 2 mudflats with different levels of exposure in the Westerschelde, The Netherlands, to identify patterns of seed arrival and persistence and their role in determining seed bank abundance. Seed arrival decreased with distance from the seed-source area, i.e. the salt marsh, resulting in seeds being deposited on the mudflat close to the marsh edge. Once arrived, most of the surface seeds were washed away during subsequent tides, with retention of <20%. However, seed burial enhanced seed retention nonlinearly with increasing burial depth. Predation was not a major cause of seed loss. These results point to the importance of hydro dynamic and morphodynamic processes to both lateral seed dispersal and vertical seed burial on tidal flats and, therefore, suggest that saltmarsh establishment and expansion are closely linked to the physical dynamics of the entire estuarine system. © Inter-Research 2014},
	author_keywords = {Mudflat; Salt marsh; Seed arrival; Seed bank; Seed persistence; Spartina},
	abbrev_source_title = {Mar. Ecol. Prog. Ser.},
	type = {Article},
