	title = {Beyond the tip of the seamount: Distinct megabenthic communities found beyond the charismatic summit sponge ground on an arctic seamount (Schulz Bank, Arctic Mid-Ocean Ridge)},
	year = {2023},
	journal = {Deep-Sea Research Part I: Oceanographic Research Papers},
