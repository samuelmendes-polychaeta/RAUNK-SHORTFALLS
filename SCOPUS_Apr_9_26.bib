@ARTICLE{Joydas201838,
	author = {Joydas, Thadickal V. and Qurban, Mohammad A. and Ali, Said M. and Albarau, Joselito F. and Rabaoui, Lotfi and Manikandan, Karuppasamy P. and Ashraf, Mohamed and Papadopoulos, Vassilis P. and Giacobbe, Salvatore and Krishnakumar, Periyadan K.},
	title = {Macrobenthic community structure in the deep waters of the Red Sea},
	year = {2018},
	journal = {Deep-Sea Research Part I: Oceanographic Research Papers},
	volume = {137},
