@ARTICLE{Amossé2020,
	author = {Amossé, Joël and Bart, Sylvain and Brulle, Franck and Tebby, Cleo and Beaudouin, Rémy and Nélieu, Sylvie and Lamy, Isabelle and Péry, Alexandre R.R. and Pelosi, Céline},
	title = {A two years field experiment to assess the impact of two fungicides on earthworm communities and their recovery},
	year = {2020},
	journal = {Ecotoxicology and Environmental Safety},
