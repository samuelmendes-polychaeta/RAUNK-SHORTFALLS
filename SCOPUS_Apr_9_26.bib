}

@ARTICLE{Santiago-Quesada2009565,
	author = {Santiago-Quesada, Francisco and Masero, José A. and Albano, Noelia and Villegas, Auxiliadora and Sánchez-Guzmán, Juan M.},
	title = {Sex differences in digestive traits in sexually size-dimorphic birds: Insights from an assimilation efficiency experiment on Black-tailed Godwit},
