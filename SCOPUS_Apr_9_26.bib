	note = {Cited by: 7; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Lelièvre2025,
	author = {Lelièvre, Yann and Jossart, Quentin and Hourdez, Stéphane and Verheye, Marie and Kelch, Andreas and Di Franco, Davide and Maxwell, Jamie and Rosenfeld, Sebastián and Mackenzie, Melanie and Lavesque, Nicolas and Legrand, Erwann and Capa, María and San Martín, Guillermo and Moreau, Camille and Saucède, Thomas},
