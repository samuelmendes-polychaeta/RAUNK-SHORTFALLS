@ARTICLE{Fajardo2018,
	author = {Fajardo, Maritza and Andrade, Diego and Bonicelli, Jessica and Bon, Melanie and Gómez, Gonzalo and Riascos, José M. and Pacheco, Aldo S.},
	title = {Macrobenthic communities in a shallow normoxia to hypoxia gradient in the Humboldt upwelling ecosystem},
	year = {2018},
