@ARTICLE{Zhang20231173,
	author = {Zhang, Yue and Gao, Fei and Xu, Qiang and Wang, Yanan and Wang, Haiqing and Wang, Aimin},
	title = {Eukaryotic food sources analysis in situ of tropical common sea cucumber Holothuria leucospilota based on 18S rRNA gene high-throughput sequencing},
	year = {2023},
