@ARTICLE{Dairain2020,
	author = {Dairain, Annabelle and Maire, Olivier and Meynard, Guillaume and Richard, Anaïs and Rodolfo-Damiano, Tiffany and Orvain, Francis},
	title = {Sediment stability: can we disentangle the effect of bioturbating species on sediment erodibility from their impact on sediment roughness?},
	year = {2020},
	journal = {Marine Environmental Research},
	volume = {162},
	pages = {},
	doi = {10.1016/j.marenvres.2020.105147},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85091935870&doi=10.1016%2Fj.marenvres.2020.105147&partnerID=40&md5=c5c1804a8a8d5efbec2c5683f4470329},
	affiliations = {Unité Biologie des ORganismes et Ecosystèmes Aquatiques (FRE BOREA), Sorbonne Universités, Muséum National d'Histoire Naturelle, CNRS, Université Pierre et Marie Curie, Université de Caen Normandie, IRD 207, Université des Antilles, Esplanade de la paix, Caen, F-14032, France; Univ. Bordeaux, CNRS, EPOC, EPHE, UMR 5805, Pessac, F-33600, France; Marine Biology Research Group, Department of Biology, Ghent University, Krijgslaan 281/S8, Ghent, 9000, Belgium},
	abstract = {Benthic organisms, in particular bioturbators, can influence erosion processes either by affecting sediment roughness through their mere presence and/or activities, or by modulating sediment characteristics (e.g., silt content, granulometry), thus altering its erodibility. To date, it was not possible to distinguish the influence of bioturbating species on sediment roughness from their impact on sediment erodibility. Consequently, uncertainties remain regarding the role played by benthic species on sediment dynamics. In this study, we used a canal flume which allows to record the bed shear stress at the surface of a non-cohesive sediment (4% of mud) during erosion experiments, thus allowing to disentangle the influence of bioturbators, here the common cockle Cerastoderma edule, on the two erosion mechanisms. In order to assess the influence of bioturbators on sediment stability in different environmental situations, we additionally tested for the effects of three factors, i.e. bivalve density, availability of suspended food (i.e. phytoplankton presence) and microphytobenthos (MPB) occurrence, which may modulate the behavior of cockles. We observed that cockles promote the erosion of the sediment surficial layer by increasing its roughness as a consequence of their sediment reworking activity and/or presence at the sediment surface (emerging shell). In contrast, we calculated similar critical bed shear stress for erosion with and without bivalves suggesting that cockles have a minor influence on the erodibility of non-cohesive substrates with a low silt content. The destabilizing effect of cockles increased with the bivalve density whereas it was attenuated by the presence of phytoplankton. We hypothesize that the magnitude of cockles' bioturbation activity was lower when a high proportion of suspended food is available. High concentrations of suspended food may also have enhanced the filtration and biodeposition rates of cockles, thus rapidly leading to the ‘muddification’ of the sediment bed and consequently counteracting with the own destabilizing effect of the bivalves. Finally, the sole presence of MPB did not significantly affect the resuspension dynamics of non-cohesive sediments with a low proportion of mud. © 2020 Elsevier Ltd},
	author_keywords = {Bed roughness; Bioturbation; Cerastoderma edule; Density-dependent effect; Microphytobenthos; Sediment erodibility; Suspended-food availability},
	correspondence_address = {A. Dairain; Marine Biology Research Group, Department of Biology, Ghent University, Ghent, Krijgslaan 281/S8, 9000, Belgium; email: annabelle.dairain@ugent.be},
