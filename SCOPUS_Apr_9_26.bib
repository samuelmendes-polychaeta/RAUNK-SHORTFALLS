	author = {Weinert, Michael and Mathis, Moritz and Kröncke, Ingrid and Pohlmann, Thomas and Reiss, Henning},
	title = {Climate change effects on marine protected areas: Projected decline of benthic species in the North Sea},
	year = {2021},
