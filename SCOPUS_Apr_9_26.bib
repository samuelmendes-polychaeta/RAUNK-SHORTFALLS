	source = {Scopus},
	note = {Cited by: 28}
}

@ARTICLE{Rossi2009503,
	author = {Rossi, Francesca and Vos, Matthijs and Middelburg, Jack J.},
	title = {Species identity, diversity and microbial carbon flow in reassembling macrobenthic communities},
	year = {2009},
	journal = {Oikos},
	volume = {118},
