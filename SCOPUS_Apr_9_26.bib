	title = {Syntheses on Taxonomic and Functional Biodiversity Related to Ocean Acidification in a Well-Studied CO2 Vents System: The Castello Aragonese of Ischia (Italy)},
	year = {2025},
	journal = {Journal of Marine Science and Engineering},
	volume = {13},
