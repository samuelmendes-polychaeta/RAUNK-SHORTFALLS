@ARTICLE{Striuchkova20242711,
	author = {Striuchkova, A.V. and Kuznetsova, N.A.},
	title = {Genetic Lineages of Parisotoma notabilis sensu lato (Hexapoda, Collembola) and Their Use in Biological Monitoring},
	year = {2024},
