	author = {Ducrot, Virginie and Billoir, Elise and Péry, Alexandre R. R. and Garric, Jeanne and Charles, Sandrine},
	title = {From individual to population level effects of toxicants in the tubicifid branchiura sowerbyi using threshold effect models in a bayesian framework},
