	author = {Garcia, Clement and Stillman, Richard A. and Forster, Rodney M. and Silva, Tiago and Bremner, Julie},
	title = {Nuclear power and coastal birds: Predicting the ecological consequences of warm-water outflows},
	year = {2016},
	journal = {Ecological Modelling},
	volume = {342},
	pages = {60 - 81},
	doi = {10.1016/j.ecolmodel.2016.09.017},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84990985631&doi=10.1016%2Fj.ecolmodel.2016.09.017&partnerID=40&md5=2d70270b212bc066600ae37f8007d0f9},
	affiliations = {Centre for Environment, Fisheries & Aquaculture Science (Cefas), Lowestoft Laboratory, Pakefield Road, Lowestoft, NR33 0HT, Suffolk, United Kingdom; Department of Life and Environmental Sciences, Faculty of Science and Technology, Bournemouth University, Fern Barrow, Poole, BH12 5BB, Dorset, United Kingdom; Institute of Estuarine & Coastal Studies (IECS), University of Hull, Hull, HU6 7RX, United Kingdom},
	abstract = {Local alteration of species abundance in natural communities due to anthropogenic impacts may have secondary, cascading effects on species at higher trophic levels. Such effects are typically hard to single out due to their ubiquitous nature and, therefore, may render impact assessment exercises difficult to undertake. Here we describe how we used empirical knowledge together with modelling tools to predict the indirect trophic effects of a future warm-water outflow on populations of shorebirds and wildfowl. Of the main potential benthic prey used by the birds in this instance, the clam Macoma balthica was the only species suspected to be adversely affected by a future increase of temperature. Various scenarios of decreases in prey energy content, simulating various degrees of temperature increase, were tested using an individual-based model, MORPH, in order to assess the effects on birds. The survival and body condition of eight of the 10 bird species modelled, dunlin, ringed plover, turnstone, redshank, grey plover, black-tailed godwit, oystercatcher and shelduck were shown to be not influenced even by the most conservative prey reduction scenarios. Most of these species are known to feed primarily on polychaete worms. For the few bivalve-feeding species, the larger size-classes of polychaete worms were predicted to be a sufficient alternative food. Only knot was predicted to have a lower survival under the two worst case scenario of decreased M. balthica energy content. We believe that this is the first time such predicted cascade effects from a future warm-water outflow have been shown. © 2016},
	author_keywords = {Benthic invertebrates; Cascade effects; Individual-based model; Shorebirds; Temperature sensitivity; Thermal pollution},
	correspondence_address = {C. Garcia; Centre for Environment, Fisheries & Aquaculture Science (Cefas), Lowestoft Laboratory, Lowestoft, Pakefield Road, NR33 0HT, United Kingdom; email: clement.garcia@cefas.co.uk},
	abbrev_source_title = {Ecol. Model.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

