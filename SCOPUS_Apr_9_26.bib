	author = {Qin, Le-Zheng and Suonan, Zhaxi and Zhang, Fei and Kim, Seung Hyeon and Kim, Hye Gwang and Lee, Kun-Seop},
	title = {Macrophyte litter mixtures mediate decomposition processes in coastal sediments},
	year = {2024},
	journal = {Communications Earth and Environment},
	volume = {5},
