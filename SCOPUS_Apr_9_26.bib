}

@ARTICLE{Labuce2021,
	author = {Labuce, Astra and Ikauniece, Anda and Jurgensone, Iveta and Aigars, Juris},
	title = {Environmental impacts on zooplankton functional diversity in brackish semi-enclosed gulf},
	year = {2021},
	journal = {Water (Switzerland)},
