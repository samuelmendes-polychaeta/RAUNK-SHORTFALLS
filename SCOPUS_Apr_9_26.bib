	doi = {10.1016/S0764-4469(99)80070-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0033117095&doi=10.1016%2FS0764-4469%2899%2980070-5&partnerID=40&md5=2ffd2bcd6cb021676a57de0e926600f9},
	affiliations = {Lab. d'oceanologie de biogeochimie, ctr. d'oceanologie Marseille (OSU), universite de la Mediterranee, 13288 Marseille cedex 9, campus de Luminy, case 901, France},
	abstract = {If determination of functional groups, the elementary units of functional diversity, is essential in order to understand how an ecosystem functions, it is also necessary to take into account the specific variability within each group. Within a group the different species' impact on ecosystem functioning can in fact vary widely. Laboratory experiments carried out with two species of bivalve molluscs, Ruditapes decussatus and Venerupis aurea, using particulate luminescent tracers, show similar sediment reworking modes for the two species, a biodiffusive mode, but with different intensities. Estimation of the mixing parameters using a biodiffusor model gives a biological diffusion rate more than twice as high for Ruditapes decussatus (R(d)(*) = 14 10<sup>-3</sup> cm<sup>2</sup> d<sup>-1</sup>) as for Venerupis aurea (R(d)(*) = 6.25 10<sup>-3</sup> cm<sup>2</sup> d<sup>-1</sup>) and an inverse trend for the output to the water column rates (f(*) = 0.0135 cm d<sup>-1</sup> for R. decussatus and f(*) = 0.028 cm d<sup>-1</sup> for V. aurea). As R. decussatus buries more of the organic matter which settles at the sediment surface and more rapidly, its effect on the early diagenesis processes and on organic matter bioavailability for the other benthic species in the sediment column differs from that of V. aurea.},
	author_keywords = {Bioturbation; Functional diversity; Functional group; Ruditapes decussatus; Sediment; Specific variablity; Venerupis aurea},
