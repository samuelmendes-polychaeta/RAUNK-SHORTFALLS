	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-23744453157&doi=10.1897%2F04-473R1.1&partnerID=40&md5=1003e5050757f657f29649faaa2a82ae},
	affiliations = {Instituto de Ciências Biomédicas de Abel Salazar, Departamento de Estudos de Populações, 4099-003 Porto, Largo Abel Salazar 2, Portugal; Centro Interdisciplinar de Investigação Marinha e Ambiental, Laboratório de Ecotoxicologia, 4050-123 Porto, Rua dos Bragas 289, Portugal; Instituto do Ambiente e Vida, Departamento de Zoologia, Universidade de Coimbra, 3004-517 Coimbra, Largo Marquês de Pombal, Portugal},
	abstract = {This study evaluated a short-term sublethal endpoint for in situ toxicity assays for estuarine sediments, based on postexposure feeding of the polychaete Hediste (Nereis) diversicolor Müller. A method for precisely quantifying postexposure feeding rates of H. diversicolor was established under laboratory conditions using Artemia franciscana Kellog nauplii. The sensitivity of the postexposure feeding response to copper was investigated by comparing postexposure feeding rates to growth and lethality. The 48-h and 96-h median lethal concentration (LC50) of copper were 241 and 125 μg/L, respectively, whereas the 48-h median inhibitory concentration (IC50) for postexposure feeding and the 20-d IC50 for growth were 52 and 25 μg/L of copper, respectively. The influence of different exposure conditions (substrate, temperature, salinity, food availability, and light) on H. diversicolor postexposure feeding was assessed; temperature and salinity were found to influence significantly postexposure feeding. The effectiveness of the proposed in situ assay was investigated by deploying it at two reference and six contaminated Portuguese estuaries. A 48-h exposure period was followed by a 1-h postexposure feeding period. High organism recoveries (89-100%) were obtained. Postexposure feeding was depressed significantly (17-90%) at all contaminated sites relatively to reference sites. The proposed in situ assay with H. diversicolor was shown to be a potential useful tool for estuarine sediment toxicity testing. © 2005 SETAC.},
	author_keywords = {Estuary; Hediste (Nereis) diversicolor; In situ assay; Postexposure feeding; Sediment toxicity},
