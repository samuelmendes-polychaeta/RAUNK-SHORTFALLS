	author = {Schrader, Stefan and van Capelle, Christine and Meyer-Wolfarth, Friederike},
	title = {Earthworms as partners in rural land use; [Regenwürmer als Partner bei der Bodennutzung: Die Servicekräfte des Bodens]},
