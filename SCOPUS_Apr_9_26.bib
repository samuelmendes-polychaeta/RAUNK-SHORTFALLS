	note = {Cited by: 12}
}

@ARTICLE{Fanelli201179,
	author = {Fanelli, E. and Cartes, J.E. and Papiol, V.},
	title = {Food web structure of deep-sea macrozooplankton and micronekton off the Catalan slope: Insight from stable isotopes},
	year = {2011},
	journal = {Journal of Marine Systems},
