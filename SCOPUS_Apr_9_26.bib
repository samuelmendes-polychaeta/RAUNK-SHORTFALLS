@ARTICLE{Walsh2023,
	author = {Walsh, Kevin and Knockaert, Juliette and Dulias, Katharina and Giguet-Covex, Charline and Unsain, Dianne and Burri, Sylvain and Magniez, Pierre and Pike, Alistair and Orton, David and Mocci, Florence},
	title = {Bioarchaeological approaches to understanding the long-term development of mountain societies},
	year = {2023},
	journal = {Archaeological and Anthropological Sciences},
	volume = {15},
