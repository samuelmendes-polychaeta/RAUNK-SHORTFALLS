@ARTICLE{Cabrol2020379,
	author = {Cabrol, Jory and Tremblay, Rajean and Winkler, Gesche},
	title = {Differential eco-physiological performances of two pseudocryptic species of the Eurytemora affinis complex (Copepoda, Calanoida) in the St. Lawrence estuarine transition zone: A reciprocal transplant experiment},
	year = {2020},
