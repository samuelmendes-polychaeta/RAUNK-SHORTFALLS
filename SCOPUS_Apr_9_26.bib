}

@ARTICLE{Gong2022,
	author = {Gong, Xin and Chen, Ting-Wen and Zhang, Lili and Pižl, Václav and Tajovský, Karel and Devetter, Miloslav},
	title = {Gut microbiome reflect adaptation of earthworms to cave and surface environments},
	year = {2022},
	journal = {Animal Microbiome},
