@ARTICLE{Cooper2017652,
	author = {Cooper, W. James and Carter, Casey B. and Conith, Andrew J. and Rice, Aaron N. and Westneat, Mark W.},
	title = {The evolution of jaw protrusion mechanics is tightly coupled to bentho-pelagic divergence in damselfishes (Pomacentridae)},
	year = {2017},
	journal = {Journal of Experimental Biology},
	volume = {220},
	number = {4},
	pages = {652 - 666},
	doi = {10.1242/jeb.143115},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85013290066&doi=10.1242%2Fjeb.143115&partnerID=40&md5=8a62cb1d562a1bda9adc971cb8efdfb4},
	affiliations = {School of Biological Sciences, Washington State University, PO Box 644236, Pullman, 99164, WA, United States; Graduate Program in Organismic and Evolutionary Biology, University of Massachusetts, 204C French Hall, University of Massachusetts Amherst, 230 Stockbridge Road, Amherst, 01003, MA, United States; Bioacoustics Research Program, Cornell Lab. of Ornithology, Cornell University, 159 Sapsucker Woods Road, Ithaca, 14850, NY, United States; Department of Organismal Biology and Anatomy, University of Chicago, 1027 E. 57th St., Chicago, 60637, IL, United States},
	abstract = {Most species-rich lineages of aquatic organisms have undergone divergence between forms that feed from the substrate (benthic feeding) and forms that feed from the water column (pelagic feeding). Changes in trophic niche are frequently accompanied by changes in skull mechanics, and multiple fish lineages have evolved highly specialized biomechanical configurations that allow them to protrude their upper jaws toward the prey during feeding. Damselfishes (family Pomacentridae) are an example of a species-rich lineage with multiple trophic morphologies and feeding ecologies. We sought to determine whether bentho-pelagic divergence in the damselfishes is tightly coupled to changes in jaw protrusion ability. Using high-speed video recordings and kinematic analysis, we examined feeding performance in 10 species that include three examples of convergence on herbivory, three examples of convergence on omnivory and two examples of convergence on planktivory. We also utilized morphometrics to characterize the feeding morphology of an additional 40 species that represent all 29 damselfish genera. Comparative phylogenetic analyses were then used to examine the evolution of trophic morphology and biomechanical performance. We find that pelagic-feeding damselfishes (planktivores) are strongly differentiated from extensively benthic-feeding species (omnivores and herbivores) by their jaw protrusion ability, upper jaw morphology and the functional integration of upper jaw protrusion with lower jaw abduction. Most aspects of cranial form and function that separate these two ecological groups have evolved in correlation with each other and the evolution of the functional morphology of feeding in damselfishes has involved repeated convergence in form, function and ecology. © 2017. Published by The Company of Biologists Ltd.},
	author_keywords = {Coral reef; Diet niche; Ecomorphology; Feeding kinematics; Functional morphology; Reticulate adaptive radiation},
	correspondence_address = {W.J. Cooper; School of Biological Sciences, Washington State University, Pullman, PO Box 644236, 99164, United States; email: jim.cooper@wsu.edu},
	abbrev_source_title = {J. Exp. Biol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 33; All Open Access; Bronze Open Access}
}

