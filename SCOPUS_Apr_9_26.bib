	author = {DeWitt, Philip D. and Williams, Bronwyn W. and Lu, Zhu-Qi and Fard, Ali N. and Gelder, Stuart R.},
	title = {Effects of environmental and host physical characteristics on an aquatic symbiont},
	year = {2013},
	journal = {Limnologica},
