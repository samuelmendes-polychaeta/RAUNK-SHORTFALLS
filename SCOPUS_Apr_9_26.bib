}

@ARTICLE{Balashov201859,
	author = {Balashov, I. and Kramarenko, S. and Shyriaieva, D. and Vasyliuk, O.},
	title = {Invasion of a crimean land snail brephulopsis cylindrica into protected relict steppic hilltops (tovtrs) in western Ukraine: A threat to native biodiversity?},
	year = {2018},
	journal = {Journal of Conchology},
	volume = {43},
	pages = {59 - 69},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85047562362&partnerID=40&md5=052ed8414b8ef99490d15399c3a9b776},
	affiliations = {I.I. Schmalhausen Institute of Zoology, National Academy of Sciences of Ukraine, B. Khmelnytsky st. 15, Kiev, 01030, Ukraine; Mykolayiv National Agrarian University, G. Gongadze St., 9, Mykolayiv, 54020, Ukraine; M. G. Kholodny Institute of Botany, National Academy of Sciences of Ukraine, Tereshchenkivska st. 2, Kiev, 01601, Ukraine},
	abstract = {Brephulopsis cylindrica (Menke 1828), a snail native to the Crimea, has been expanding northward and westward, and has recently reached Western Ukraine. Three adjacent and abundant colonies have been found in the tovtrs (small rocky hilltop areas of protected relic steppic habitat) of the Podilski Tovtry National Nature Park in Western Ukraine. These sites and ten similar sites without B. cylindrica were sampled. Most of the snail species that occur in the other ten sites were absent from the samples from the sites with B. cylindrica, which have much lower molluscan diversity. It is suggested that B. cylindrica is excluding some threatened native snails that have comparable ecological preferences, notably Helicopsis striata. Possible mechanisms of competition with native species are discussed. The most likely explanation is that these native snails are displaced from seasonal refuges in rock crevices as a result of the high densities of B. cylindrica. The snails in Western Ukrainian populations of B. cylindrica are smaller than in populations from the Crimean mountains, but similar in size to populations from the Crimean plains, which may be where they originated. © 2018 Conchological Society of Great Britain and Ireland. All rights reserved.},
	author_keywords = {Brephulopsis cylindrica; Competition; Conservation; Exclusion; Grasslands; Terrestrial molluscs},
	correspondence_address = {I. Balashov; I.I. Schmalhausen Institute of Zoology, National Academy of Sciences of Ukraine, Kiev, B. Khmelnytsky st. 15, 01030, Ukraine; email: igor_balashov@ukr.net},
