	year = {2011},
	journal = {Biodiversity and Conservation},
	volume = {20},
	number = {13},
	pages = {2967 - 2980},
	doi = {10.1007/s10531-011-0128-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-81255158004&doi=10.1007%2Fs10531-011-0128-7&partnerID=40&md5=6c387247b37a7cea1d7c8e3761ea29d3},
	affiliations = {Department of Biological Science, College of General Studies, University of Puerto Rico, San Juan, PR 00931-3323, Río Piedras Campus, PO Box 23323, United States; Department of Biology, California State University Dominguez Hills, Carson, CA 90747, 1000 E. Victoria St, United States},
	abstract = {Uncontrolled urban development is threatening the survival of many terrestrial species worldwide, especially those with limited dispersal capabilities. Soil invertebrates account for a high proportion of the global biodiversity but there are few studies on how soil biodiversity varies with different parameters of landscape structure, especially in fragmented tropical habitats. Millipedes are among the most abundant detritivore invertebrates in the soil-litter macrofauna. We examined the relationships between soil millipede diversity and landscape structure in 12 forest patches of approximately 30 years of age, in northeastern Puerto Rico. Spatial characteristics of the landscape were determined from aerial color photographs and were digitized into a GIS package for analysis. Millipede species diversity and composition in these forest patches showed correlations with their surroundings (e. g. amount of forest in the matrix) and with the presence of vegetation corridors that connected to other forest patches, rather than forest patch attributes such as patch area and shape. Millipede species richness correlated negatively with the degree of isolation of forest patch (within 600 m radius), while species evenness correlated positively to the amount of forest within a 50 m buffer. Millipede species composition was related with the presence of vegetation corridors and the distance to the Luquillo Experimental Forest reserve. These findings show that a low degree of patch isolation, forested buffers, and presence of vegetation corridors need to be considered for the conservation and management of forest patches surrounded by urban developments, especially to protect terrestrial invertebrate species that require forested habitats for their dispersal. © 2011 Springer Science+Business Media B.V.},
	author_keywords = {Litter and soil millipede composition; Matrix effect; Patch isolation; Soil biodiversity; Tropical moist forest; Vegetation corridors},
	correspondence_address = {I. T. Galanes; Department of Biological Science, College of General Studies, University of Puerto Rico, San Juan, PR 00931-3323, Río Piedras Campus, PO Box 23323, United States; email: i.galanes@gmail.com},
