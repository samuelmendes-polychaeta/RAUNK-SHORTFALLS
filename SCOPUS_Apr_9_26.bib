	title = {Spatial patterns of macrozoobenthos diversity on sewage-impacted intertidal rocky shores in Central Patagonia, Argentina},
	year = {2025},
	journal = {Marine Pollution Bulletin},
	volume = {211},
	pages = {},
	doi = {10.1016/j.marpolbul.2024.117358},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210726048&doi=10.1016%2Fj.marpolbul.2024.117358&partnerID=40&md5=8e3f3aca834724b2108ba432e0170d53},
	affiliations = {Instituto de Desarrollo Costero Dr. Héctor E. Zaixso, Universidad Nacional de la Patagonia San Juan Bosco (UNPSJB), Comodoro Rivadavia, Ruta 1, km4 S/N, Chubut, 9000, Argentina; Instituto Multidisciplinario para la Investigación y el Desarrollo Productivo y Social de la Cuenca Golfo San Jorge (IIDEPyS-GSJ), UNPSJB, CONICET, Argentina; Facultad de Ciencias Naturales y Ciencias de la Salud, UNPSJB, Argentina; Departamento de Biología, Bioquímica y Farmacia, Universidad Nacional del Sur, San Juan 670, Buenos Aires, Bahía Blanca, 8000, Argentina},
	abstract = {The effects of untreated wastewater and shore levels on zoobenthic diversity, species accumulation, and abundance-biomass relationships were studied on intertidal rocky shores of central Patagonia, Argentina. Winter samples (2015) from two sewage-impacted and two reference sites showed that pollution disrupted macrozoobenthic diversity and zonation. A total of 83 taxa were identified, with polychaetes (31 species), mollusks (22), and crustaceans (21) being the most diverse. Impacted sites had greater intra-environmental diversity heterogeneity and higher abundance at the lower midlittoral level, indicating a shift towards lower intertidal levels. Species richness was lower and evenness was higher in the polluted mid-littoral level. ABC curves in the stressed areas showed moderate disturbances with variability across shore zones, while non-polluted rocky shores typically exhibit a higher cumulative faunal biomass than abundance. In impacted areas, chronic habitat changes and disturbances to the mussel matrix by Perumytilus purpuratus are likely responsible for differences in diversity and abundance-biomass relationships. © 2024 Elsevier Ltd},
	author_keywords = {ABC curves; Benthos; Hill's numbers; Intertidal; Sewage},
	correspondence_address = {R.N. Verga; Instituto de Desarrollo Costero Dr. Héctor E. Zaixso, Universidad Nacional de la Patagonia San Juan Bosco (UNPSJB), Comodoro Rivadavia, Ruta 1, km4 S/N, Chubut, 9000, Argentina; email: romynv@gmail.com},
