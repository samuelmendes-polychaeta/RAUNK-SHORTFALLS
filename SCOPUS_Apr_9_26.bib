@ARTICLE{Mazurkiewicz2020,
	author = {Mazurkiewicz, Mikołaj and Górska, Barbara and Renaud, Paul E. and Włodarska-Kowalczuk, Maria},
	title = {Latitudinal consistency of biomass size spectra - benthic resilience despite environmental, taxonomic and functional trait variability},
	year = {2020},
	journal = {Scientific Reports},
	volume = {10},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-020-60889-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85081376272&doi=10.1038%2Fs41598-020-60889-4&partnerID=40&md5=13ba4f4b99e0748be7fa578432315cc0},
	affiliations = {Institute of Oceanology Polish Academy of Sciences, Sopot, 81-712, Poland; Akvaplan-niva, Fram Centre for Climate and the Environment, Tromsø, 9296, Norway; University Centre in Svalbard, Longyearbyen, 9171, Norway},
	abstract = {Global warming is expected to cause reductions in organism body size, a fundamental biological unit important in determining biological processes. Possible effects of increasing temperature on biomass size spectra in coastal benthic communities were investigated. We hypothesized higher proportions of smaller size classes in warmer conditions. Soft bottom infauna samples were collected in six Norwegian and Svalbard fjords, spanning wide latitudinal (60–81°N) and bottom water temperature gradients (from −2 to 8 °C). Investigated fjords differed in terms of environmental settings (e.g., pigments or organic carbon in sediments). The slopes of normalised biomass size spectra (NBSS) did not differ among the fjords, while the benthic biomass and NBSS intercepts varied and were related to chlorophyll a and δ<sup>13</sup>C in sediments. The size spectra based on both abundance and biomass remained consistent, regardless of the strong variability in macrofauna taxonomic and functional trait composition. Variable relationships between temperature and body size were noted for particular taxa. Our results indicate that while benthic biomass depends on the nutritional quality of organic matter, its partitioning among size classes is consistent and independent of environmental and biological variability. The observed size structure remains a persistent feature of studied communities and may be resilient to major climatic changes. © 2020, The Author(s).},
	correspondence_address = {M. Mazurkiewicz; Institute of Oceanology Polish Academy of Sciences, Sopot, 81-712, Poland; email: mikolaj@iopan.gda.pl},
