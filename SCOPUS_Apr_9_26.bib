	year = {2015},
	journal = {Biological Journal of the Linnean Society},
	volume = {115},
	number = {1},
	pages = {114 - 126},
	doi = {10.1111/bij.12483},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84926420142&doi=10.1111%2Fbij.12483&partnerID=40&md5=7d208a3245805a1d7a9ef42e16ba7fb6},
	affiliations = {Department of Zoology, University of Cambridge, Cambridge, CB23EJ, United Kingdom; School of Biological Sciences and Centre for Marine Science, University of Queensland, Brisbane, 4072, QLD, Australia; Department of Zoology and Entomology, Rhodes University, Grahamstown, 6140, South Africa; Knysna Basin Project, Knysna, 6570, South Africa; Institute of Marine Sciences Laboratories, University of Portsmouth, Eastney, Portsmouth, PO49LY, United Kingdom},
	abstract = {Previous work has shown that the intertidal seagrass macrobenthos at three geographically and ecologically disparate localities (in the north-east Atlantic, south-west Indian and south-west Pacific Oceans) possess similar relative species occurrence distributions and uniform species densities. These common features are here demonstrated to be related to the presence in those assemblages of: (1) similar functional diversities and evennesses, (2) the same set of dominant component functional groups, and (3) similar ranked relative occurrence distributions both of those groups and of the component genera within each of the larger groups. The two lower-latitude systems were particularly similar in all these respects. Although sharing the same subset of individual functional groups, however, the relative importance of members of that subset varied from locality to locality and even within a single locality, whilst still maintaining the same ranked relative functional-group occurrence distribution. Therefore the broad structure of available macrobenthic functional roles and the relative occurrences of the component taxa in intertidal seagrass beds (and hence, granted stochastic assembly, the total numbers of taxa supported by unit area) are likely to be linked causally, although the form of the relationship is unclear. © 2015 The Linnean Society of London.},
	author_keywords = {Biodiversity; Biological traits; Functional diversity; Macrobenthos; Seagrass; Spatial occurrence patterns},
	correspondence_address = {R.S.K. Barnes; Department of Zoology, University of Cambridge, Cambridge, CB23EJ, United Kingdom; email: rsb1001@cam.ac.uk},
	abbrev_source_title = {Biol. J. Linn. Soc.},
	type = {Article},
