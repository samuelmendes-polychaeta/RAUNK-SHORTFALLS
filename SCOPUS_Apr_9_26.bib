@ARTICLE{Jensen20001010,
	author = {Jensen, Arne J. and Forseth, Torbjørn and Johnsen, Bjørn Ove},
	title = {Latitudinal variation in growth of young brown trout Salmo trutta},
	year = {2000},
	journal = {Journal of Animal Ecology},
	volume = {69},
