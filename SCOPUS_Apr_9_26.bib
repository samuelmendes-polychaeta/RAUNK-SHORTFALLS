@ARTICLE{Giampaoletti2025,
	author = {Giampaoletti, Jacopo and Moccia, Davide and Gravina, Maria Flavia and Conforti, Alessandro and De Falco, Giovanni and Pusceddu, Antonio and Magni, Paolo},
	title = {Benthic trophic status and spatiotemporal variability of macrobenthic assemblages in S'Ena Arrubia Lagoon (Sardinia, Italy)},
	year = {2025},
	journal = {Estuarine, Coastal and Shelf Science},
	volume = {324},
	pages = {},
	doi = {10.1016/j.ecss.2025.109452},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011652614&doi=10.1016%2Fj.ecss.2025.109452&partnerID=40&md5=0a0895ed370c1c7588e80ccdfe3987a1},
	affiliations = {CNR-IAS, Consiglio Nazionale delle Ricerche – Istituto per lo studio degli Impatti Antropici e Sostenibilità in ambiente marino, Località Sa Mardini, Torregrande, Oristano, 09170, Italy; ISPRA, Italian National Institute for Environmental Protection and Research, Rome, 00144, Italy; Dipartimento di Scienze della Vita e dell'Ambiente, Università degli Studi di Cagliari, Cagliari, 09126, Italy; Dipartimento di Biologia, Università di Roma “Tor Vergata”, Rome, 00133, Italy; CoNISMa (Consorzio Nazionale Interuniversitario per le Scienze del Mare), Rome, 00196, Italy},
	abstract = {Quantity and nutritional availability of sedimentary organic matter (OM) are among the most important factors affecting benthic fauna dynamics. Despite this, the relative importance of food sources with different nutritional quality on the macrobenthos dynamics has been poorly investigated, especially in naturally eutrophic coastal lagoons. We investigated the spatiotemporal variations in the relationship between the macrobenthic assemblages and the quantity and nutritional quality of OM in a Mediterranean coastal lagoon (S'Ena Arrubia lagoon, Sardinia, Italy). Sampling was carried out at six stations selected at different distances from the sea inlet and with a different degree of confinement, in two dates in winter (February and March) and two dates in summer (June and July) 2021. The PERMANOVA tests showed significant differences among stations, seasons and sampling dates in the benthic assemblages, and the quantity and quality of OM. The DistLM analyses revealed that the photosynthetically produced OM (as total phytopigment contents) and OM freshness (as the protein-to-carbohydrate ratio), as well as the nutritional quality of OM (as the algal fraction of biopolymeric C), played a crucial role in influencing the spatiotemporal distribution of the macrobenthic abundance, taxonomic richness and composition, with the most significant correlations being detected for the deposit-feeders and detritivores, such as Streblospio shrubsolii, Microdeutopus gryllotalpa, Malacoceros fuliginosus and Polydora ciliata. These results suggest that a thorough assessment of the environmental quality of coastal lagoon's sediments should consider jointly macrobenthic metrics and the benthic trophic status, as assessed using complementary biochemical descriptors. © 2025 The Author(s)},
	author_keywords = {Animal-sediment relationship; Benthic macroinvertebrates; Biopolymeric carbon; Coastal lagoons; Mediterranean Sea; Organic matter},
	correspondence_address = {P. Magni; CNR-IAS, Consiglio Nazionale delle Ricerche – Istituto per lo studio degli Impatti Antropici e Sostenibilità in ambiente marino, Oristano, Località Sa Mardini, Torregrande, 09170, Italy; email: paolo.magni@cnr.it},
	abbrev_source_title = {Estuar. Coast. Shelf Sci.},
	type = {Article},
	publication_stage = {Final},
