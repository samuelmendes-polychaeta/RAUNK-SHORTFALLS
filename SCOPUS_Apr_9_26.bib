	title = {Restoration of benthic macrofauna promotes biogeochemical remediation of hostile sediments; An in situ transplantation experiment in a eutrophic estuarine-hypersaline lagoon system},
	year = {2022},
	journal = {Science of the Total Environment},
	volume = {833},
	pages = {},
	doi = {10.1016/j.scitotenv.2022.155201},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85128307484&doi=10.1016%2Fj.scitotenv.2022.155201&partnerID=40&md5=448264725f89d3d36889f42355d6d947},
	affiliations = {College of Science and Engineering, Flinders University, GPO Box 2100, Kaurna Country, Adelaide, 5001, SA, Australia; University of South Australia, STEM, Scarce Resources and Circular Economy (ScaRCE), Kaurna Country, 5095, SA, Australia; School of Biological Sciences, University of Adelaide, Kaurna Country, Adelaide, Australia; School of Environment, Griffith University, Yugambeh/Kombumerri Country, QLD, Australia; Centre for Environmental Contaminants Research, CSIRO Land & Water, Tharawal Country, Lucas Heights, 2234, NSW, Australia},
	abstract = {Estuarine ecosystems have very high ecological and economic value, and also act as a buffer for coastal oceans by processing nutrient inputs from terrestrial sources. However, ongoing pressures from increased urbanisation and agriculture, overlaid by climate change, has reduced inflows and increased nutrient loads that challenge the health and buffering capacity of these ecosystems. This study aimed to investigate whether restoring the bioturbating activity of Simplisetia aequisetis (Polychaeta: Nereididae) and other macrofauna could improve biogeochemical conditions in ‘hostile’ (i.e. hypersaline, sulfide-rich) sediments. To achieve this aim, we conducted an in situ experiment in the Coorong estuarine-lagoon ecosystem, translocating hostile hypersaline sediments, devoid of bioturbating macrofauna, to a ‘healthy’ (lower salinity) location where macrobenthic fauna naturally occur, and manipulating the S. aequisetis density in the sediments. Porewater, solid-phase, and diffusive equilibrium and diffusive gradient in thin-films (DET/DGT) measurements showed that bioturbation by macrobenthic fauna significantly influenced sediment biogeochemistry and remediated hostile conditions in sediment within a short time (four weeks) irrespective of S. aequisetis density. Bioturbation promoted sediment oxygenation, while salinity and the concentrations of total organic carbon and porewater sulfide, ammonium, and phosphate all decreased over time at all sediment depths. This research highlights the importance of macrobenthic communities and their functional traits for improving sediment conditions, promoting resilience to eutrophication, providing a nature-based remediation option, and in general ensuring healthy functioning of estuarine ecosystems. © 2022 The Authors},
	author_keywords = {Australia; Eutrophication; Macroinvertebrates; Murray-Darling basin; Nutrient cycling; Sulfide},
	correspondence_address = {O. Lam-Gordillo; College of Science and Engineering, Flinders University, Adelaide, GPO Box 2100, Kaurna Country, 5001, Australia; email: orlando.lamgordillo@flinders.edu.au},
	abbrev_source_title = {Sci. Total Environ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 17; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Soares2021,
	author = {Soares, Joana and Miguel, Isabel and Venâncio, Cátia and Lopes, Isabel and Oliveira, Miguel},
	title = {Public views on plastic pollution: Knowledge, perceived impacts, and pro-environmental behaviours},
	year = {2021},
	journal = {Journal of Hazardous Materials},
	volume = {412},
	pages = {},
	doi = {10.1016/j.jhazmat.2021.125227},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100604094&doi=10.1016%2Fj.jhazmat.2021.125227&partnerID=40&md5=cba637a601a558bd1c399acdee3649dc},
	affiliations = {Department of Biology, University of Aveiro, Aveiro, 3810-193, Portugal; Portucalense Institute of Human Development & Department of Psychology and Education, Portucalense University, Porto, 4200-072, Portugal; Centre for Functional Ecology (CFE), Department of Life Sciences, University of Coimbra, Coimbra, 3000-456, Portugal; Centre for Environmental and Marine Studies (CESAM), Department of Biology, University of Aveiro, Aveiro, 3810-193, Portugal},
	abstract = {Nowadays, plastic pollution is considered an issue of global concern. This environmental problem results from human industrial and domestic activities, associated with poor management, from manufacturing processes to productsʼ end life. In this perspective, human consumption and management of daily used plastic materials can play a determinant role to control this environmental issue. Thus, understanding public perceptions about plastic pollution may be a valuable resource to engage society in solutions to reduce its environmental release. In this study, perceptions about plastic pollution, its impacts as well as sociodemographic and psychological factors predicting individuals’ pro-environmental behaviours were analysed, in the Portuguese context. Overall, results showed that there is a general knowledge that plastics degrade in the environment. The participants of the study perceived the bio-ecological impacts of plastics as a greater threat than the socioeconomic impacts. A hierarchical regression analyses revealed that sociodemographic variables and those related to knowledge and perceived impacts about plastic pollution can predict participants’ pro-environmental behaviours. Awareness about the impacts of plastic pollution (socioeconomic, health impacts and bio-ecological impacts) were highly associated to pro-environmental behaviour. This study data can help to understand how to enhance pro-environmental behaviours and contribute to decrease the presence of micro(nano)plastics in the environment. © 2021 Elsevier B.V.},
	author_keywords = {Ecological behaviour; Environmental awareness; Plastic pollution; Public perception},
	abbrev_source_title = {J. Hazard. Mater.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 188}
}

