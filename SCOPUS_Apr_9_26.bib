@ARTICLE{Peura20121640,
	author = {Peura, Sari and Eiler, Alexander and Bertilsson, Stefan and Nykänen, Hannu and Tiirola, Marja and Jones, Roger I.},
	title = {Distinct and diverse anaerobic bacterial communities in boreal lakes dominated by candidate division OD1},
	year = {2012},
	journal = {ISME Journal},
	volume = {6},
	number = {9},
	pages = {1640 - 1652},
	doi = {10.1038/ismej.2012.21},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84865319078&doi=10.1038%2Fismej.2012.21&partnerID=40&md5=6b1a331e55656dff469696f8c43d4086},
	affiliations = {Department of Biological and Environmental Science, University of Jyväskylä, 40014 Jyväskylä, PO Box 35, Finland; Department of Ecology and Genetics, Uppsala University, Uppsala, Sweden},
	abstract = {Lakes have a central role in the carbon cycle of the boreal landscape. These systems typically stratify in summer and their hypolimnetic microbial communities influence burial of biogenic organic matter in sediments. The composition of bacterial communities in these suboxic habitats was studied by pyrosequencing of 16S rRNA amplicons from five lakes with variable dissolved organic carbon (DOC) concentrations. Bacterioplankton communities in the hypolimnetic waters were clearly different from the surface layer with candidate division OD1, Chlorobi and Bacteroidetes as dominant community members. Several operational taxonomic units (OTUs) affiliated with candidate division OD1 were abundant and consistently present in the suboxic hypolimnion in these boreal lakes. The overall representation of this group was positively correlated with DOC and methane concentrations. Network analysis of time-series data revealed contrasting temporal patterns but suggested similar ecological roles among the abundant OTUs affiliated with candidate division OD1. Together, stable isotope data and taxonomic classification point to methane oxidation and autotrophic denitrification as important processes in the suboxic zone of boreal lakes. Our data revealed that while hypolimnetic bacterial communities are less dynamic, they appear to be more diverse than communities from the oxic surface layer. An appreciable proportion of the hypolimnetic bacteria belong to poorly described phyla. © 2012 International Society for Microbial Ecology All rights reserved.},
	author_keywords = {16S rRNA; 454 pyrosequencing; anoxic; diversity; hypolimnion; OD1},
	correspondence_address = {S. Peura; Department of Biological and Environmental Science, University of Jyväskylä, 40014 Jyväskylä, PO Box 35, Finland; email: sari.peura@jyu.fi},
	abbrev_source_title = {ISME J.},
	type = {Article},
