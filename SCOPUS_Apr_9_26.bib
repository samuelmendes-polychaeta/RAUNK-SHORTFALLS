	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84898878324&doi=10.1111%2Fpcmr.12231&partnerID=40&md5=1dc8d28fbbd71ae090aae53a56ada3a7},
	affiliations = {Department of Ecology and Evolution, University of Lausanne, Biophore, Lausanne, Switzerland},
	abstract = {The adaptive function of melanin located in the integument is well known. Although pigments are also deposited in various internal organs, their function is unclear. A review of the literature revealed that 'internal melanin' protects against parasites, pollutants, low temperature, oxidative stress, hypoxemia and UV light, and is involved in the development and function of organs. Importantly, several studies have shown that the amount of melanin deposited on the external body surface is correlated with the amount located inside the body. This finding raises the possibility that internal melanin plays more important physiological roles in dark than light-colored individuals. Internal melanin and coloration may therefore not evolve independently. This further emphasizes the major role played by indirect selection in evolutionary processes. © 2014 John Wiley & Sons A/S. Published by John Wiley & Sons Ltd.},
