	source = {Scopus},
	note = {Cited by: 108}
}

@ARTICLE{Kristensen20172097,
	author = {Kristensen, Erik and Lee, Shing Yip and Mangion, Perrine and Quintana, Cintia O. and Valdemarsen, Thomas},
	title = {Trophic discrimination of stable isotopes and potential food source partitioning by leaf-eating crabs in mangrove environments},
	year = {2017},
