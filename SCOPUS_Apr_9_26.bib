	affiliations = {University of Oslo, Department of Biology, Center of Ecological and Evolutionary Synthesis (CEES), 0316 Oslo, PO Box 1066, Blindern, Norway; Oklahoma State University, Department of Zoology, Stillwater, OK 74078, United States; University of Iowa, Department of Biology, the Roy J. Carver Center for Comparative Genomics, IO 52242, 143 BB Iowa City, United States; University of Oklahoma, Department of Zoology and Biological Station, Program in Ecology and Evolutionary Biology, Norman, OK 73019, United States},
	abstract = {Pervasive relationships between growth rate, genome size and RNA content exist. One interesting potential consequence of these interrelationships is that selection for high growth rate should be associated with small genomes and high RNA content. Here, we use phosphorus (P) and nitrogen (N) demands of growth along with nucleic acid production as the currency to explore the interrelationships between growth rate and genome size in eukaryotes. We argue that reallocation of P (and eventually N) from DNA to RNA under sustained selection for rapid growth in nutritionally limited environments can lead to genome streamlining in eukaryotes, and that this mechanism might contribute to the evolution of reduced genome size. © 2009 Elsevier Ltd.},
