	title = {The sibling polychaetes Platynereis dumerilii and Platynereis massiliensis in the Mediterranean Sea: are phylogeographic patterns related to exposure to ocean acidification?},
	year = {2017},
	journal = {Marine Biology},
	volume = {164},
	number = {10},
	pages = {},
	doi = {10.1007/s00227-017-3222-x},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85029034702&doi=10.1007%2Fs00227-017-3222-x&partnerID=40&md5=3defcfb4c4f381c31813df196d1bae70},
	affiliations = {School of Environmental Sciences, University of Hull, Cottingham Road, Hull, HU6 7RX, United Kingdom; Leibniz Institute for Baltic Sea Research Warnemünde (IOW), Seestraße 15, Rostock, 18119, Germany; Department of Integrative Marine Ecology, Villa Dohrn-Benthic Ecology Center Ischia, Stazione Zoologica Anton Dohrn, Villa Comunale, Naples, 80121, Italy; Department of Marine Biology, Texas A&M University at Galveston, PO Box 1675, Galveston, 77554, TX, United States},
	abstract = {High pCO<sub>2</sub> environments, such as volcanic carbon dioxide (CO<sub>2</sub>) vents, which mimic predicted near-future scenarios of ocean acidification (OA), offer an opportunity to examine effects of low pH conditions on marine biodiversity and adaptation/acclimatization of marine organisms to such conditions. Based on previous field studies in these systems, it is predicted that the stress owing to increasing CO<sub>2</sub> concentrations favours the colonization by invertebrate species with a brooding habit. The goal of this study was to investigate the relative occurrence of the two sibling species Platynereis dumerilii (Audouin & Milne-Edwards, 1834) (free spawner) and Platynereis massiliensis (Moquin-Tandon, 1869) (egg brooder) in two shallow CO<sub>2</sub> vents off Ischia and Vulcano islands (Italy, Tyrrhenian Sea), and in various areas with ambient pH conditions, where they represent one of the dominant genera. Phylogeographic analyses were integrated with reproductive biology and life-history observations on some selected populations thriving in the vent areas. This approach revealed the presence of four distinct Platynereis clades. Whereas two clades primarily inhabit CO<sub>2</sub> vents and are presumably all brooders, the other two clades dominate the non-acidified sites and appear to be epitokous free spawners. We postulate that one of the brooding, vent-inhabiting clades represents P. massiliensis and one of the free spawning, non-vent-inhabiting clades represents P. dumerilii, although confirmation of the species status with sequence data from the respective-type localities would be desirable. © 2017, Springer-Verlag GmbH Germany.},
	correspondence_address = {G. Valvassori; Department of Integrative Marine Ecology, Villa Dohrn-Benthic Ecology Center Ischia, Stazione Zoologica Anton Dohrn, Naples, Villa Comunale, 80121, Italy; email: giulia.valvassori@szn.it},
	abbrev_source_title = {Mar. Biol.},
	type = {Article},
	publication_stage = {Final},
