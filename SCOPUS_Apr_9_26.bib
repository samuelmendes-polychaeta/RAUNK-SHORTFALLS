@ARTICLE{Phillips2025,
	author = {Phillips, Helen R. P. and Hoeffner, Kevin and Muys, Bart and Le Bayon, Renée-Claire and Cluzeau, Daniel and Butt, Kevin R. and Maréchal, Jeanne and Briones, Maria J. I. and Decaëns, Thibaud and Hedde, Mickaël and Gérard, Sylvain and Pérès, Guénola and Petit-Dit-Grézériat, Lucas and Pelosi, Céline},
	title = {Urban earthworm communities driven more by climate and elevation than urbanisation intensity},
	year = {2025},
	journal = {Urban Ecosystems},
