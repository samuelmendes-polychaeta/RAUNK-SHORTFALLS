}

@ARTICLE{Wolfarth2013903,
	author = {Wolfarth, Friederike and Schrader, Stefan and Oldenburg, Elisabeth and Weinert, Joachim},
	title = {Nematode-collembolan-interaction promotes the degradation of Fusarium biomass and deoxynivalenol according to soil texture},
	year = {2013},
