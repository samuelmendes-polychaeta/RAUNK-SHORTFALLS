	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-80455131170&doi=10.1371%2Fjournal.pone.0027104&partnerID=40&md5=b5474fc0cf0d66533d27042a1abef50f},
	affiliations = {Department of Biological Sciences, Marine Sciences Program, Florida International University, North Miami, FL, United States},
	abstract = {Ontogenetic niche shifts occur across diverse taxonomic groups, and can have critical implications for population dynamics, community structure, and ecosystem function. In this study, we provide a hypothesis-testing framework combining univariate and multivariate analyses to examine ontogenetic niche shifts using stable isotope ratios. This framework is based on three distinct ontogenetic niche shift scenarios, i.e., (1) no niche shift, (2) niche expansion/reduction, and (3) discrete niche shift between size classes. We developed criteria for identifying each scenario, as based on three important resource use characteristics, i.e., niche width, niche position, and niche overlap. We provide an empirical example for each ontogenetic niche shift scenario, illustrating differences in resource use characteristics among different organisms. The present framework provides a foundation for future studies on ontogenetic niche shifts, and also can be applied to examine resource variability among other population sub-groupings (e.g., by sex or phenotype). © 2011 Hammerschlag-Peyer et al.},
	correspondence_address = {C. M. Hammerschlag-Peyer; Department of Biological Sciences, Marine Sciences Program, Florida International University, North Miami, FL, United States; email: cpeye001@fiu.edu},
