	author = {Ma, Shisheng and Li, Li and Chen, Xiaoqun and Chen, Shujing and Dong, Yunwei and Gao, Qinfeng and Zhou, Yangen and Dong, Shuanglin},
	title = {Influence of daily rhythmic light spectra and intensity changes on the growth and physiological status of juvenile steelhead trout (Oncorhynchus mykiss)},
	year = {2023},
	journal = {Frontiers in Marine Science},
	volume = {10},
	pages = {},
