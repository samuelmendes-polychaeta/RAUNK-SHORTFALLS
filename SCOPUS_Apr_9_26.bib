@ARTICLE{Rakocinski2017,
	author = {Rakocinski, Chet F. and Gillam, Kelsey Burns},
	title = {Temperature-modulated expression of allometric respiration strategies supports a metabolic scaling rule},
	year = {2017},
	journal = {Frontiers in Marine Science},
	volume = {4},
