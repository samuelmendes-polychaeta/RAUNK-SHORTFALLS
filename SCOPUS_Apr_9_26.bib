	title = {Do presence of gray shrimp Crangon crangon larvae influence meiobenthic features? Assessment with a focus on traits of nematodes},
	year = {2021},
	journal = {Environmental Science and Pollution Research},
	volume = {28},
	number = {17},
	pages = {21303 - 21313},
	doi = {10.1007/s11356-020-12069-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099050394&doi=10.1007%2Fs11356-020-12069-0&partnerID=40&md5=365e5199ec1316d4ced20a2b02a875a4},
	affiliations = {Faculty of Sciences of Bizerte, Laboratory of Environment Biomonitoring, Coastal Ecology and Ecotoxicology Unit, University of Carthage, Zarzouna, 7021, Tunisia; Zoology Department, College of Science, King Saud University, Box 2455, Riyadh, 11451, Saudi Arabia; Faculty of Biology, Alexandru Ioan Cuza University of Iasi, Iasi, Romania; Texas Water Development Board, 1700 North Congress Avenue, Austin, 78701, TX, United States},
	abstract = {In this study, a microcosm experiment was conducted for 30 days to assess the impact of the presence of juvenile gray shrimp Crangon crangon on meiofauna. The results suggested that juvenile shrimp had a significant negative impact on the abundance of nematodes and copepods, but no effect on polychaetes. Moreover, nematodes showed a significant decline in individual weight. The collected nematodes were taxonomically identified and assigned to five functional traits: shapes of the tail and amphid, life history, feeding types, and adult length. The nematode traits were affected by the number of shrimp introduced, and descriptors followed normal or inversed bell-shaped curves. When no shrimp were present, the nematofauna had a higher species richness compared with treatments of 4, 8, and 12 shrimp. Bell-shaped curve patterns were common in relation to the two phases of feeding for C. crangon. During the first phase, C. crangon consumed the nematode species Oncholaimus campylocercoides; thereafter, shrimp fed mostly on the nematode Anticoma eberthi and copepods. © 2021, The Author(s), under exclusive licence to Springer-Verlag GmbH, DE part of Springer Nature.},
	author_keywords = {Crangon crangon; Functional traits; Meiobenthic nematodes; Taxonomic composition},
	correspondence_address = {F. Boufahja; Faculty of Sciences of Bizerte, Laboratory of Environment Biomonitoring, Coastal Ecology and Ecotoxicology Unit, University of Carthage, Zarzouna, 7021, Tunisia; email: fehmiboufahja@yahoo.fr},
	abbrev_source_title = {Environ. Sci. Pollut. Res.},
