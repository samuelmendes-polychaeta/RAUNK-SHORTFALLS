	author = {Riegl, Bernhard and Johnston, Matthew and Glynn, Peter W. and Keith, Inti and Rivera, Fernando and Vera-Zambrano, Mariana and Banks, Stuart and Feingold, Joshua and Glynn, Peter J.},
	title = {Some environmental and biological determinants of coral richness, resilience and reef building in Galápagos (Ecuador)},
	year = {2019},
	journal = {Scientific Reports},
	volume = {9},
