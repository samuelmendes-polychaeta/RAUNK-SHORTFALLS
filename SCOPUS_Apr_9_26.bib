	abbrev_source_title = {Ecology},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 149; All Open Access; Green Open Access}
}

@ARTICLE{Jørgensen20111183,
	author = {Jørgensen, Lis Lindal and Renaud, Paul E. and Cochrane, Sabine K.J.},
	title = {Improving benthic monitoring by combining trawl and grab surveys},
	year = {2011},
	journal = {Marine Pollution Bulletin},
	volume = {62},
	number = {6},
	pages = {1183 - 1190},
	doi = {10.1016/j.marpolbul.2011.03.035},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-79958730584&doi=10.1016%2Fj.marpolbul.2011.03.035&partnerID=40&md5=c61b0b639a959b7544a8dd905d755045},
	affiliations = {Institute of Marine Research, N-9294 Tromsø, P.O. Box 6404, Norway; Akvaplan-niva, Polar Environmental Centre, N-9296 Tromsø, Norway},
	abstract = {Environmental monitoring is performed on seafloor communities since these organisms are relatively stationary and integrate the environmental conditions over many years. Standard practices involve sampling by grab. Epifaunal taxa, often missed by grab sampling, are likely to have different ecological functions. We investigate how current environmental assessments represent the benthic community as a whole by comparing taxonomic and functional components sampled by grabs and epibenthic trawls. Faunal communities sampled by trawl (filtrating or predator, epifauna) and grab (infaunal, detrivore) differs widely by sampling distinct functional components, and these may be expected to respond to different human-induced stressors. Neither component appears to be a good surrogate for the community as a whole. We suggest a benthic monitoring by combining both techniques. Sustainable ecosystem functioning is intimately tied to the health of both components of the benthic community, and is recognized as an important goal by signatories of the Convention on Biological Diversity. © 2011 Elsevier Ltd.},
	author_keywords = {Arctic; Barents Sea; Beam trawl; Biodiversity; Ecosystem function; Epifauna; Infauna; Monitoring; North Sea; Petroleum industry; Sampling equipment; Trawling impacts; Van Veen grab},
	correspondence_address = {L.L. Jørgensen; Institute of Marine Research, N-9294 Tromsø, P.O. Box 6404, Norway; email: lis.lindal.joergensen@imr.no},
	abbrev_source_title = {Mar. Pollut. Bull.},
	type = {Article},
