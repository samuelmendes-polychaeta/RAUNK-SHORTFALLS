	title = {Laying out the foundations: Assessing the spatial extent and drivers of offshore wind turbine artificial reef effects on soft sediments},
	year = {2025},
	journal = {Journal of Sea Research},
	volume = {208},
	pages = {},
	doi = {10.1016/j.seares.2025.102631},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016849463&doi=10.1016%2Fj.seares.2025.102631&partnerID=40&md5=c8f555ff47dada8bdef0ffc2c75855c4},
	affiliations = {Marine Biology Research Group, Ghent University, Krijgslaan 281, S8, Gent, 9000, Belgium; Institute of Natural Sciences, Operational Directorate Natural Environment, Marine Ecology and Management, Vautierstraat 29, Brussels, 1000, Belgium; Flanders Marine Institute (VLIZ), Jacobsenstraat 1, Oostende, 8400, Belgium},
	abstract = {With the rapid expansion of offshore energy, numerous artificial structures are being installed on the seabed, including wind turbine foundations. This study investigates the “artificial reef” (AR) effect of bottom-fixed offshore wind farms (OWFs) on soft sediment benthic communities. While previous studies have focused on distances ≥30 m from turbines, in this study, sediment and macrobenthic samples were collected at shorter distances (1 m, 7 m, 15 m and 25 m) from the scour protection layer (SPL) around a monopile and a gravity-based foundation in two Belgian OWFs, 10–13 years post-installation. Results show a localized AR footprint for both turbine foundations, with enriched benthic communities within 15 m of the SPL. In comparison to communities 25 m distanced away from the SPL, a higher average species richness (+100 %), abundance (+117 %), functional richness (+438 %), and bioturbation potential (+86 %) was prevalent, whereas the magnitude of enriched structural and functional diversity in the footprint varied respectively between 16 and 80 % and 15–110 % depending on the OWF. Beyond the AR footprint, communities resembled those at reference sites (240–570 m), with less surface dwellers, suspension feeders and a prevalence of burrowing biodiffusors that contribute little to bioturbation. While the AR effect's magnitude depends on local conditions and foundation design, our trait-based analysis indicates that sediment fining, biofouling drop-offs and organic enrichment are consistent drivers shaping the AR footprint. © 2025},
	author_keywords = {Biological trait analysis; Ecosystem functioning; Macrobenthos; Offshore renewable energy; Spatial reef effects},
	correspondence_address = {C. Van Colen; Marine Biology Research Group, Ghent University, Gent, Krijgslaan 281, S8, 9000, Belgium; email: carl.vancolen@ugent.be},
	abbrev_source_title = {J. Sea Res.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Li2025790,
	author = {Li, Tong-Pu and Wang, Chen-Hao and Wang, Zhi-Heng and Hao, Bing-Ren and Xie, Jia-Chu and Li, Hao-Xin and Cai, Dong-Jie and Ye, Shu-Cheng and Zhao, Lv-Quan},
	title = {Tetracycline changes the microbial assembly of Hyphantria cunea and reduces its fitness},
	year = {2025},
	journal = {Environmental Entomology},
	volume = {54},
	number = {4},
	pages = {790 - 801},
	doi = {10.1093/ee/nvaf063},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013572232&doi=10.1093%2Fee%2Fnvaf063&partnerID=40&md5=6e0379b2b38519e4057aa538ac313fc6},
	affiliations = {Co-Innovation Center for Sustainable Forestry in Southern China, College of Forestry and Grassland, Nanjing Forestry University, Jiangsu, Nanjing, China},
	abstract = {The strong environmental adaptability of the fall webworm Hyphantria cunea is closely linked to its internal microbiota. However, with the widespread usage and environmental residuals of antibiotics, their effects on the microbiome and fitness of H. cunea remain unknown. In this study, we found that tetracycline significantly decreased bacterial diversity in H. cunea, evident in a notable reduction in both the number of bacterial species and their relative abundance. Furthermore, the bacterial community structure was influenced by tetracycline, resulting in an increase in the relative abundance of Firmicutes and a decrease in the relative abundances of Proteobacteria, Bacteroidota, and others. Additionally, the potentially tetracycline-resistant bacterial genus ZOR0006 became dominant after tetracycline ingestion. The tetracycline also led to significant alterations in the function of the bacterial community, particularly in defense mechanisms, cell motility, energy production, and conversion. Corresponding to the changes in the microbiota, tetracycline significantly reduced the fitness of H. cunea, mainly manifested as an extension of the developmental duration and a decrease in the survival rate. These findings elucidate the effects of tetracycline on the microbial assembly and fitness of H. cunea, providing an important reference for a deeper understanding of the complex roles of antibiotics in ecological environments. © The Author(s) 2025. Published by Oxford University Press on behalf of Entomological Society of America. All rights reserved.},
	author_keywords = {fitness; Hyphantria cunea; microbial function; microbiome assembly; tetracycline},
	correspondence_address = {T.-P. Li; Co-Innovation Center for Sustainable Forestry in Southern China, College of Forestry and Grassland, Nanjing Forestry University, Nanjing, Jiangsu, 210037, China; email: tpli@njfu.edu.cn; L.-Q. Zhao; Co-Innovation Center for Sustainable Forestry in Southern China, College of Forestry and Grassland, Nanjing Forestry University, Nanjing, Jiangsu, 210037, China; email: zhaolvquan@njfu.edu.cn},
	abbrev_source_title = {Environ. Entomol.},
	type = {Article},
