@ARTICLE{Matsubara2019,
	author = {Matsubara, Shin and Shiraishi, Akira and Osugi, Tomohiro and Kawada, Tsuyoshi and Satake, Honoo},
	title = {The regulation of oocyte maturation and ovulation in the closest sister group of vertebrates},
	year = {2019},
