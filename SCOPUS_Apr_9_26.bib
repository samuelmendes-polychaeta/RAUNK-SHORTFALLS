	author = {Lam-Gordillo, Orlando and Mosley, Luke M. and Simpson, Stuart L. and Welsh, David T. and Dittmann, Sabine},
	title = {Loss of benthic macrofauna functional traits correlates with changes in sediment biogeochemistry along an extreme salinity gradient in the Coorong lagoon, Australia},
	year = {2022},
	journal = {Marine Pollution Bulletin},
	volume = {174},
