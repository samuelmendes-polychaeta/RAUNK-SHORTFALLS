	title = {Effects of Feeding Ratio on the Co-Culture of European Sea Bass (Dicentrarchus labrax) and Glasswort (Salicornia europaea) in a Recirculating Brackish Aquaponic System},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
	number = {6},
	pages = {},
	doi = {10.3390/app16062930},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105034065575&doi=10.3390%2Fapp16062930&partnerID=40&md5=594b6c37f7fece77bff291a4a4855038},
	affiliations = {Department of Fisheries and Aquaculture, School of Agricultural Sciences, University of Patras, Mesolonghi, 30200, Greece; Department of Ichthyology and Aquatic Environment, School of Agricultural Sciences, University of Thessaly, Volos, 38446, Greece; Department of Sustainable Agriculture, School of Agricultural Sciences, University of Patras, Agrinio, 30100, Greece; Department of Food Science & Technology, School of Agricultural Sciences, University of Patras, Agrinio, 30100, Greece},
	abstract = {Brackish aquaponics is expected to be a promising approach to sustainable food production, integrating saline water resources with simultaneous co-cultivation of fish and halophytes. The present study investigated the effects of three feeding ratios (FR1.5: 1.5%, FR3: 3%, and FR6: 6% b.w/d) on the growth performance of European sea bass (Dicentrarchus labrax) and glasswort (Salicornia europaea) co-cultured in three autonomous one-loop recirculation aquaponic systems (180 L each) at 20 ppt salinity over 78 days. Each system comprised three fish-rearing tanks connected to a two-stage sump filter and a nutrient film technique (NFT) hydroponic subsystem. Sea bass fed at FR3 achieved significantly higher weight gain, specific growth rate, and feed conversion efficiency than FR1.5. At FR6, feed consumption nearly doubled compared to FR3 (3.79 vs. 1.91 g), yet the feed conversion ratio increased from 0.79 to 1.65, and protein efficiency ratio declined from 3.80 to 1.91, indicating overfeeding effects. Regarding glasswort, FR6 produced significantly higher chlorophyll a content and plant biomass, whereas FR1.5 showed superior ammonia removal efficiency. Overall, FR3 provided the best balance between fish growth, plant yield, and water quality maintenance. These findings highlight the critical role of feeding management in brackish aquaponics in order to optimize nutrient coupling between fish and halophyte production. © 2026 by the authors.},
	author_keywords = {approximate analysis; brackish aquaponic system; European sea bass; feeding ratios; glasswort; growth performance; nutritional characteristics},
	correspondence_address = {N. Vlahos; Department of Fisheries and Aquaculture, School of Agricultural Sciences, University of Patras, Mesolonghi, 30200, Greece; email: vlachosn@upatras.gr; P. Berillis; Department of Ichthyology and Aquatic Environment, School of Agricultural Sciences, University of Thessaly, Volos, 38446, Greece; email: pveril@uth.gr},
	abbrev_source_title = {Appl. Sci.},
