@ARTICLE{Zizzari20091261,
	author = {Zizzari, Z. Valentina and Braakhuis, Annika and van Straalen, Nico M. and Ellers, Jacintha},
	title = {Female preference and fitness benefits of mate choice in a species with dissociated sperm transfer},
	year = {2009},
	journal = {Animal Behaviour},
	volume = {78},
