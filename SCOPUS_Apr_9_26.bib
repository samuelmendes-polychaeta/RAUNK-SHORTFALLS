@ARTICLE{Navel20121134,
	author = {Navel, Simon and Mermillod-Blondin, Florian and Montuelle, Bernard and Chauvet, Eric and Marmonier, Pierre},
	title = {Sedimentary context controls the influence of ecosystem engineering by bioturbators on microbial processes in river sediments},
	year = {2012},
	journal = {Oikos},
	volume = {121},
	number = {7},
