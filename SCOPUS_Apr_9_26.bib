	correspondence_address = {T.H. Boag; Department of Geological Sciences, Stanford University, Stanford, 94305, United States; email: tomboag@stanford.edu},
	abbrev_source_title = {Proc. R. Soc. B Biol. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
