@ARTICLE{Bhusal201425,
	author = {Bhusal, Daya Ram and Kallimanis, Athanasios S. and Tsiafouli, Maria A. and Sgardelis, Stefanos P.},
	title = {Higher taxa vs. functional guilds vs. trophic groups as indicators of soil nematode diversity and community structure},
	year = {2014},
	journal = {Ecological Indicators},
	volume = {41},
	pages = {25 - 29},
	doi = {10.1016/j.ecolind.2014.01.019},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84894084323&doi=10.1016%2Fj.ecolind.2014.01.019&partnerID=40&md5=f4b12ddb50171aad0a2fe56aeec1020a},
	affiliations = {Department of Ecology, School of Biology, Aristotle University, Thessaloniki, Greece; Department of Environmental and Natural Resources Management, University of Patras, 30100 Agrinio, G. Seferi 2, Greece},
	abstract = {Biodiversity surrogates are often used in ecology to save money and time. One such widely used surrogacy method is the higher taxon approach, also known in the literature as taxonomic sufficiency. This approach has rarely been applied to microscopic organisms like soil microfauna, although there is a lack of detailed taxonomic knowledge regarding the latter. We tested taxonomic sufficiency for genus alpha and beta diversity, as well as for community structure of soil nematodes. We also tested whether the functional classifications of nematodes into functional guilds and trophic groups can serve as efficient indicators of nematode diversity and community structure. We used data from soil nematode communities from five different microhabitats (soil, soil moss, rock moss, low tree trunk moss and high tree trunk moss) in forested and non forested areas at five different stations (differing in elevation and aspect). Our results showed that both the higher taxon approach and the functional surrogacy approach could serve as reliable indicators of alpha and beta diversity. Furthermore, our community analysis of both taxonomic and functional composition identified that the variability at the finer scales, and namely the habitat structure, played the leading role in shaping nematode communities. © 2014 Elsevier Ltd.},
	author_keywords = {Beta diversity; Biodiversity surrogacy; Ordination; Taxonomic sufficiency},
