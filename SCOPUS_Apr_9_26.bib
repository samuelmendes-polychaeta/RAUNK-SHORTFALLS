@ARTICLE{Smith1996647,
	author = {Smith, D.E.C. and Davies, Ronald W.},
	title = {Effects of aggregative behaviour on the bioenergetics of the freshwater predatory leech Nephelopsis obscura (Erpobdellidae)},
	year = {1996},
