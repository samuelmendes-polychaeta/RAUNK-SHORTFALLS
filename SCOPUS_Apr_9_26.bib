}

@ARTICLE{Macolino2019,
	author = {Macolino, Assunta C. and Dafforn, Katherine A. and Hedge, Luke H. and Poore, Alistair G.B. and Johnston, Emma L.},
	title = {Fine-scale effects of boat moorings on soft sediment communities masked in large-scale comparisons},
	year = {2019},
	journal = {Frontiers in Marine Science},
	volume = {6},
	number = {MAR},
	pages = {},
