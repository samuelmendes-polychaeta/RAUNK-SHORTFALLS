	title = {Functional response of tropical estuarine benthic assemblages to perturbation by Polycyclic Aromatic Hydrocarbons},
	year = {2019},
	journal = {Ecological Indicators},
	volume = {96},
	pages = {229 - 240},
	doi = {10.1016/j.ecolind.2018.08.062},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85053190467&doi=10.1016%2Fj.ecolind.2018.08.062&partnerID=40&md5=e2543f8be5ac526110837e9387554694},
	affiliations = {Laboratório de Ecologia Bentônica (LEB), Centro Interdisciplinar de Energia e Ambiente (CIENAM), Instituto de Biologia da Universidade Federal da Bahia, Rua Barão de Jeremoabo, Campus de Ondina, Salvador, 40170-290, Bahia, Brazil; Centro Interdisciplinar de Energia e Ambiente (CIENAM), Instituto de Química, Universidade Federal da Bahia, Rua Barão de Jeremoabo, s/n, Ondina, Salvador, 40170-290, BA, Brazil; Instituto do Mar da Universidade Federal de São Paulo, Rua Carvalho de Mendonça, 144, Santos, São Paulo, 11030-400, Brazil},
	abstract = {The potential effects of perturbations by Polycyclic Aromatic Hydrocarbons (PAHs) on nematode and macrobenthos assemblages were investigated using the Biological Traits Analysis (BTA). We sampled at tidal flats near an oil refinery and in a reference estuary. Morphological and ecological traits of benthic fauna were selected and analyzed in order to assess the contribution of PAHs concentrations, the proximity to the oil refinery, the sediment characteristics and interaction between these predictor variables on benthic fauna. Multivariate analyses (DISTLM and db-RDA), showed that a large fraction of functional and taxonomic variation of benthic assemblages was explained by the interaction between location and sediment characteristics. The interaction between ∑PAHs and sediment characteristics was relatively low but significant. The results showed that taxonomic and functional variability of benthic assemblages were driven by natural and anthropogenic variables and BTA was an important auxiliary tool for distinguishing these responses. The amount of variability explained by the model was higher for nematode assemblages than to macrofaunal assemblages, showing a potential higher sensitivity of this group to the predictor variables. © 2018 Elsevier Ltd},
	author_keywords = {Functional structure; Macrobenthos assemblages; Nematode assemblages; PAHs perturbation; Tidal flats; Todos os Santos Bay},
	correspondence_address = {A.G. Egres; Laboratório de Ecologia Bentônica (LEB), Centro Interdisciplinar de Energia e Ambiente (CIENAM), Instituto de Biologia da Universidade Federal da Bahia, Rua Barão de Jeremoabo, Salvador, Campus de Ondina, 40170-290, Brazil; email: egres.aline@gmail.com},
