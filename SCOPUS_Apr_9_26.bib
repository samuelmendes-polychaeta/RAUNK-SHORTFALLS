	author = {Vandromme, Mathil and Trekels, Hendrik and Sepúlveda Ruiz, Norvin and Somarriba, Eduardo and Vanschoenwinkel, Bram},
	title = {Exploring the suitability of bromeliads as aquatic breeding habitats for cacao pollinators},
	year = {2019},
	journal = {Hydrobiologia},
	volume = {828},
