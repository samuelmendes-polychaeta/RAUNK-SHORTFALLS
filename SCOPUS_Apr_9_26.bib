@ARTICLE{Lourenço2016855,
	author = {Lourenço, Pedro M. and Catry, Teresa and Piersma, Theunis and Granadeiro, José P.},
	title = {Comparative Feeding Ecology of Shorebirds Wintering at Banc d’Arguin, Mauritania},
	year = {2016},
	journal = {Estuaries and Coasts},
