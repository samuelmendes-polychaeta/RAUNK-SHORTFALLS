@ARTICLE{Voss2025,
	author = {Voss, Maren and Holtermann, Peter and Ahmerkamp, Soeren and Arévalo Martínez, Damian Leonardo and Cahill, Bronwyn and Chouksey, Manita and Dippner, Joachim W. and Dutz, Jörg and Feldens, Peter and Geersen, Jacob and Gentsch, Kaja and Gogina, Mayya and Herlemann, Daniel and Henkel, Jan and Kanwischer, Marion and Krebs, Bennet and Kremp, Anke and Malissery, Anju and Mars, Robert and Müller, Jann and Neubert, Sebastian and Osterholz, Helena and Radtke, Hagen and Rehder, Gregor and Romoth, Katharina and Sass, Martin and Sassenhagen, Ingrid and Schmale, Oliver and Thenen, Miriam v. and Weber, Mario v. and Zielinski, Oliver},
	title = {Coastal zones of the Baltic Sea in the Anthropocene: Current state and the impact of climate change},
	year = {2025},
