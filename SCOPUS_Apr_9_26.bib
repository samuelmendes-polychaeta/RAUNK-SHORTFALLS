	affiliations = {Department of Biomolecular Engineering and Bioinformatics, University of California Santa Cruz, 1156 High Street, Santa Cruz, 95064, CA, United States; Shemyakin-Ovchinnikov Institute of Bioorganic Chemistry of the Russian Academy of Sciences, Miklukho-Maklaya, 16/10, Moscow, 117997, Russian Federation; Planta LLC, Bolshoi Boulevard, 42 str 1, Office 335, Moscow, 121205, Russian Federation; Monterey Bay Aquarium Research Institute, 7700 Sandholdt Road, Moss Landing, 95039, CA, United States; Department of Ecology and Evolutionary Biology, University of California Santa Cruz, 1156 High Street, Santa Cruz, 95064, CA, United States; Department of Environmental Biology, Chubu University, Kasugai, 487-8501, Japan; Pirogov Russian National Research Medical University, Ostrovitianova 1, Moscow, 117997, Russian Federation},
	abstract = {Odontosyllis undecimdonta is a marine syllid polychaete that produces bright internal and exuded bioluminescence. Despite over fifty years of biochemical investigation into Odontosyllis bioluminescence, the light-emitting small molecule substrate and catalyzing luciferase protein have remained a mystery. Here we describe the discovery of a bioluminescent protein fraction from O. undecimdonta, the identification of the luciferase using peptide and RNA sequencing, and the in vitro reconstruction of the bioluminescence reaction using highly purified O. undecimdonta luciferin and recombinant luciferase. Lastly, we found no identifiably homologous proteins in publicly available datasets. This suggests that the syllid polychaetes contain an evolutionarily unique luciferase among all characterized luminous taxa. © 2018 Elsevier Inc.},
