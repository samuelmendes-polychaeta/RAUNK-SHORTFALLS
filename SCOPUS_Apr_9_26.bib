@ARTICLE{Madurell2008336,
	author = {Madurell, T. and Fanelli, E. and Cartes, J.E.},
	title = {Isotopic composition of carbon and nitrogen of suprabenthic fauna in the NW Balearic Islands (western Mediterranean)},
