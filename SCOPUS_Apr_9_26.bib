	title = {Variation of growth rate and survival in embryos and larvae of Rana temporaria populations from the pyrenees},
	year = {2015},
	journal = {Acta Herpetologica},
	volume = {10},
	number = {2},
	pages = {85 - 91},
	doi = {10.13128/Acta_Herpetol-16297},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84953296145&doi=10.13128%2FActa_Herpetol-16297&partnerID=40&md5=2dd1f413299d22e4fc51f84a3fd14b5b},
	affiliations = {Escola Tècnica Superior d’Enginyeria Agrària, Departament de Producció Animal (Fauna Silvestre), University of Lleida, Av. Rovira Roure 191, Lleida, 25198, Spain; Laboratory of Fish and Amphibian Ethology, Behavioural Biology Unit, Department of Biology Ecology and Evolution University of Liege, 22 Quai van Beneden, Liege, 4020, Belgium},
	abstract = {Variations on embryonic and larval life history traits of ectotherm organisms are strongly affected by temperature conditions. However, these effects can vary between species and populations depending on the mechanisms that act in a determinate local habitat. In the present study, we analysed the effects of temperature on several embryonic and larval traits (survival, development and growth rate until the metamorphosis) of Rana temporaria in two populations living at different altitude (1540 and 2100 m) in the Pyrenees. Five spawns from each population were distributed in a common garden experiment at different temperature treatments according to the normal temperature range that tadpoles might experience in the field and also considering a high treatment (24 °C) to test a possible effect of global warming. Like in other studies of the same species in a latitudinal gradient, the temperature effects depended on the analysed trait. Our results support the general rule that the rate of development is faster at higher temperatures, although survival was significantly affected by the highest temperature in the highland population. Size varied at embryonic and larval stages and was largest at metamorphosis in the highland population. In concordance, the growth rate was higher in the highland population suggesting a countergradient variation in response to the short growing season. However, this possible adaptation can be altered in a global warming scenario with an increase of mortality and limited growth. © Firenze University Press.},
	author_keywords = {Altitudinal variation; Development; Growth; Rana temporaria},
