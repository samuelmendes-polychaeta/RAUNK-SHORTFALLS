	year = {2013},
	journal = {Biogeosciences},
	volume = {10},
	number = {6},
	pages = {3705 - 3714},
	doi = {10.5194/bg-10-3705-2013},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84882413967&doi=10.5194%2Fbg-10-3705-2013&partnerID=40&md5=2c81b56713388d882cba69799dc69392},
	affiliations = {Oceanlab., Institute of Biological and Environmental Sciences, University of Aberdeen, Aberdeen, AB41 6AA, United Kingdom; Scottish Association for Marine Science, Scottish Marine Institute, Oban, Argyll, PA37 1QA, United Kingdom},
	abstract = {Spatial distribution and patchiness of deep sea macrofaunal communities were studied from samples collected in the Rockall Trough, NE Atlantic. In June 2011, two areas, located outside and within the Darwin Mound Special Area of Conservation (SAC), were sampled. Three megacores were deployed in each area at approximately 900 m depth. The two areas, ∼ 18 km apart, did not differ in terms of sediment organic matter and percentage of mud content, but small significant differences were found in sediment median grain size and depth. Macrofaunal communities were found to differ significantly, with the difference mostly driven by changes in the abundance of polychaetes, crustaceans and nematodes whilst no significant differences were seen for the other phyla. Whereas overall macrofaunal abundance was higher outside the SAC compared to within, this pattern varies considerably between phyla. Diversity indices showed no significant differences between protected and unprotected sites. Deep-water trawling regularly take place outside the Darwin Mounds SAC whilst the area inside the SAC has been closed to bottom trawling since 2004, and the above distribution patterns are discussed in the context of both environmental and anthropogenic causes. © Author(s) 2013.},
	correspondence_address = {N. Serpetti; Oceanlab., Institute of Biological and Environmental Sciences, University of Aberdeen, Aberdeen, AB41 6AA, United Kingdom; email: natalia.serpetti@sams.ac.uk},
