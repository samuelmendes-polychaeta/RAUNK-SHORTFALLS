	source = {Scopus},
	note = {Cited by: 7; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Hou2022,
	author = {Hou, Yiran and Jia, Rui and Ji, Peng and Li, Bing and Zhu, Jian},
