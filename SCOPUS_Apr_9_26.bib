@ARTICLE{Jansen2007233,
	author = {Jansen, Jeroen M. and Bonga, Sjoerd Wendelaar and Hummel, Herman},
	title = {Differential cold-shock resistance among acclimated European mussel populations},
	year = {2007},
	journal = {Marine and Freshwater Behaviour and Physiology},
	volume = {40},
