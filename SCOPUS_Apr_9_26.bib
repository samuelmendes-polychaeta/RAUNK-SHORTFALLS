	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

@ARTICLE{Araújo201850,
	author = {Araújo, J.E. and Madeira, D. and Vitorino, R. and Repolho, T. and Rosa, R. and Diniz, M.},
