	author = {Lozano Fondón, Carlos and Scotti, Marco and Innangi, Michele and Bondavalli, Cristina and De Marco, Anna and Virzo De Santo, Amalia and Fioretto, Antonietta and Menta, Cristina and Bodini, Antonio},
	title = {Indirect effects of trophic interactions govern carbon circulation in two beech forest soil ecosystems},
	year = {2023},
	journal = {Functional Ecology},
	volume = {37},
