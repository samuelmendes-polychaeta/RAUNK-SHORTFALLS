	title = {How do estuarine channel morphology and vegetation presence shape the distribution of benthic macrofauna in Amazonian mangroves?},
	year = {2026},
	journal = {Regional Studies in Marine Science},
	volume = {93},
	pages = {},
	doi = {10.1016/j.rsma.2025.104620},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105022314066&doi=10.1016%2Fj.rsma.2025.104620&partnerID=40&md5=90098c22cd871c212b8ad54f0324b868},
	affiliations = {Laboratório de Invertebrados Aquáticos, Coordenação de Zoologia, Museu Paraense Emílio Goeldi, Av. Perimetral 1901, Terra Firme, Pará, Belém, 66077-830, Brazil; Laboratório de Pesquisa em Monitoramento Ambiental Marinho (LAPMAR), Instituto de Geociências, Universidade Federal do Pará, Rua Augusto Corrêa, 01 - Guamá, Pará, Belém, 66075-110, Brazil; Laboratório Oceanografia Biológica, Instituto de Geociências, Universidade Federal do Pará, Rua Augusto Corrêa, 01 - Guamá, Pará, Belém, 66075-110, Brazil},
	abstract = {The study evaluated how habitat characteristics influenced the spatial and temporal distribution of benthic macrofauna in mangroves on a coastal island in the Brazilian Amazon, focusing on intertidal zones with and without vegetation in estuarine channels with different morphologies. The responses of the macrobenthic community to spatial factors were compared during the two seasonal periods (dry and rainy). The results showed distinct spatial variations (taxonomic and functional) within each period, and the seasonal variations were differed in each habitat. In the narrow and sinuous channel, detritus-feeding organisms (polychaetes and oligochaetes) dominated, associated with muddier sediments and higher organic matter content. In the wide and straight channel, in addition to detritus-feeding organisms, there was a higher proportion of predators associated with sandier sediments. The unvegetated zone had a significantly higher density than the vegetated zone in both channels, possibly due to less compacted and more humid sediment. Density and richness significantly decreased during the rainy season, however only in the unvegetated zone because it is more affected by the reduction in estuary salinity. The study provides valuable information on the variability of benthic macrofauna in Amazonian mangroves, which are poorly understood despite their dominance in the region's landscape. Copyright © 2025. Published by Elsevier B.V.},
	author_keywords = {Amazon estuary; Benthic invertebrates; Soft bottom; Tropical region},
	correspondence_address = {D. Aviz; Laboratório de Invertebrados Aquáticos, Museu Paraense Emílio Goeldi, Belém, Campus de Pesquisa, Coordenação de Zoologia, Av. Perimetral, 1901/1907 - Terra Firme, Pará, 66017-970, Brazil; email: daiane.aviz@gmail.com},
	abbrev_source_title = {Reg. Stud. Mar. Sci.},
