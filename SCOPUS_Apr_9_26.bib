@ARTICLE{Nuutinen2025,
	author = {Nuutinen, Visa and Briones, Maria J. I. and Schrader, Stefan and Dekemati, Igor and Grujić, Nikola and Hyvönen, Juha and Ivask, Mari and Lassen, Simon Bo and Lloret, Eva and Ollio, Irene and Pérez-Rodríguez, Paula and Simon, Barbara and Sutri, Merit and de Sutter, Nancy and Brandt, Kristian K. and Peltoniemi, Krista and Shanskiy, Merrit and Waeyenberge, Lieven and Martínez-Martínez, Silvia and Fernández-Calviño, David},
	title = {Wheat field earthworms under divergent farming systems across a European climate gradient},
