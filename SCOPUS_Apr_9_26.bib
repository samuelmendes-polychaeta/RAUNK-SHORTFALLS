	title = {Trophic position estimates of marine teleosts using amino acid compound specific isotopic analysis},
	year = {2015},
	journal = {Limnology and Oceanography: Methods},
	volume = {13},
	number = {9},
	pages = {476 - 493},
	doi = {10.1002/lom3.10041},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85000786706&doi=10.1002%2Flom3.10041&partnerID=40&md5=3fd1281cc93148d158b3f3529fabe116},
	affiliations = {Department of Oceanography, University of Hawaii, Honolulu, HI, United States; Department of Geology and Geophysics, University of Hawaii, Honolulu, HI, United States; Division of Biological Sciences, University of California, San Diego, California, La Jolla, CA, United States; Department of Marine Science and Environmental Studies, University of San Diego, San Diego, CA, United States; School of Natural Sciences, University of California, Merced, CA, United States},
	abstract = {The increasing use of trophic position (TP) for assessing and describing ecosystems has resulted in the emergence of novel techniques for accurate and accessible measurements. The strength of amino acid compound specific nitrogen isotopic analysis (AA-CSIA) lies in its ability to determine TP using a single organism, utilizing the isotopic differences between two or more amino acids (AAs). However, calculating TP from this technique relies upon the predictability of isotopic differences across consumer types and consistency among ecosystems. The goal of this study was to use wild samples to evaluate <sup>15</sup>N enrichment between AA groups with differing trophic fractionation patterns, termed the trophic discrimination factor (TDF<sub>AA</sub>), and determine an accurate value for calculating TPs of marine teleosts. Using a large sample size (224 samples of 47 species) across a broad range of TPs (2.0-4.5, estimated by stomach content analysis [SCA]) and marine ecosystems, we derived TDF<sub>AA</sub> values that explained up to 80% of the variability between TP calculations from SCA and AA-CSIA. We found a TDF<sub>AA</sub> value of 5.7±0.3‰ using the difference between δ<sup>15</sup>N values of glutamic acid and phenylalanine, 2‰ lower than the most commonly used value of 7.6±1.3‰. The weighted mean of several AAs resulted in the same value for TDF<sub>AA</sub>, but provided greater agreement with TPs from SCA. For more reliable TP calculations in marine teleosts, our results strongly advocate a lower TDF<sub>AA</sub> and the use of weighted mean AA δ<sup>15</sup>N values from triplicate analyses. © 2015 Association for the Sciences of Limnology and Oceanography.},
	correspondence_address = {C.J. Bradley; Department of Oceanography, University of Hawaii, Honolulu, United States; email: cbradley2@ucmerced.edu},
	abbrev_source_title = {Limnol. Oceanogr. Methods},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 134}
}

