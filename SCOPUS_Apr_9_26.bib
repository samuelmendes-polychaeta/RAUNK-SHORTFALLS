	doi = {10.3354/meps13840},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85127481376&doi=10.3354%2Fmeps13840&partnerID=40&md5=35121885ded4eb24ba18116d771c5d96},
	affiliations = {Netherlands Institute for Sea Research, Utrecht University, Department of Estuarine and Delta Systems, Korringaweg 7, PO Box 140, Yerseke, 4401 NT, Netherlands; Ecosystem Management Research Group, University of Antwerp, Universiteitsplein 1, Wilrijk, 2610, Belgium; IFREMER, Unité Ecologie et Modèles pour l’Halieutique, rue de l’Ile d’Yeu, BP 21105, Nantes, Cedex 3 44311, France; Centre for Environment, Fisheries and Aquaculture Science, Lowestoft Laboratory, Pakefield Road, Lowestoft, NR33 0HT, United Kingdom; Wageningen Marine Research, Wageningen UR, IJmuiden, 1970 AB, Netherlands; Plymouth Marine Laboratory, Prospect Place, Plymouth, PL1 3DH, United Kingdom},
	abstract = {Biological trait analysis has become a popular tool to infer the vulnerability of benthic species to trawling-induced disturbance. Approaches using multiple traits are being developed, but their generic relevance across faunal components and geographic locations remains poorly tested, and the importance of confounding effects are poorly recognised. This study integrates biological traits of benthic species that are responsive to instantaneous effects of trawling (i.e. sensitivity) and traits expressing recoverability over the longer term (i.e. years). We highlight the functional independence between these 2 components in response to trawling, test the behaviours of single and combined traits and account for potential confounding effects of environment and trawling intensity on benthic communities through variation partitioning. Two case studies are considered: epibenthos from the Bay of Biscay and endobenthos of the Dutch sector of the North Sea. The response to trawling is most pronounced when multiple traits covering different aspects that determine population dynamics (i.e. sensitivity and recoverability) are combined, despite confounding effects between gradients of benthic production and trawling intensity, especially for endobenthos. The integration of traits reflecting both sensitivity and recoverability provides complementary information on the faunal response to trawling, bridging the gap between fishing impact assessments and benthic community status assessments. © Inter-Research 2021.},
	author_keywords = {Benthic macroinvertebrate; Biological trait; Bottom trawling; Composite indicator; Confounding effect; Natural history; Time scale},
	correspondence_address = {O. Beauchard; Netherlands Institute for Sea Research, Utrecht University, Department of Estuarine and Delta Systems, Yerseke, Korringaweg 7, PO Box 140, 4401 NT, Netherlands; email: olivier.beauchard@nioz.nl},
	abbrev_source_title = {Mar. Ecol. Prog. Ser.},
