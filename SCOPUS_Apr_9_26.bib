@ARTICLE{Broadribb2026,
	author = {Broadribb, Manon and Rogers, Alice and Micaroni, Valerio and Kinsey, Richard and Bell, James J.},
	title = {Temporal trends in benthic community composition differ between shallow and mesophotic temperate rocky reefs},
	year = {2026},
	journal = {Marine Ecology Progress Series},
	volume = {778},
	pages = {},
	doi = {10.3354/meps15052},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105033674202&doi=10.3354%2Fmeps15052&partnerID=40&md5=f4bf93947089b53180ab752f7d451500},
	affiliations = {School of Biological Sciences, Victoria University of Wellington, Wellington, 6023, New Zealand; Department of Conservation, Fiordland National Park, Lakefront Drive, Te Anau, 9640, New Zealand},
	abstract = {Temperate mesophotic ecosystems (TMEs) generally occur between 30 and 150 m, at the limit of light availability for photosynthesis, and are often characterised by more stable environmental factors than shallower euphotic environments. We propose that this stability in physical factors may result in benthic communities within TMEs being more temporally stable compared to their shallow-water counterparts. We tested this hypothesis by undertaking monitoring at 4 distinct sites around New Zealand, each hosting benthic communities along a vertical depth gradient from shallow to mesophotic depths, over the course of 7 yr. Our results represent the first long-term study of benthic communities inhabiting TMEs. We analysed overall trends in benthic community composition, trends in diversity indices, and changes in the abundance of specific common benthic groups. Overall community composition differed between years at the majority of depths. However, the nature of these changes, along with the patterns in trends of diversity indices, varied between depths at all sites. Two of our 4 sites supported our hypothesis, exhibiting more stable benthic communities at mesophotic depths compared to the shallows; however, 2 sites did not follow expected patterns. At all sites, where communities were found to change through time, these changes tended to be indicative of stochastic variation, with limited evidence for directional or cyclical changes. Our findings highlight the need for monitoring programs that encompass both shallow and mesophotic depths, and management plans which take into account the different temporal trajectories benthic communities from adjacent shallow and mesophotic environments are likely to take. © Inter-Research 2026.},
	author_keywords = {Benthic communities; Community stability; Depth refuge; Temperate mesophotic ecosystems; TMEs},
	correspondence_address = {M. Broadribb; School of Biological Sciences, Victoria University of Wellington, Wellington, 6023, New Zealand; email: manon.broadribb@vuw.ac.nz},
	abbrev_source_title = {Mar. Ecol. Prog. Ser.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

