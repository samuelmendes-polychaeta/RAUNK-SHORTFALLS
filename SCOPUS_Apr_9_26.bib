@ARTICLE{Marsh2005238,
	author = {Marsh, Adam G. and Fielman, Kevin T.},
	title = {Transcriptome profiling of individual larvae of two different developmental modes in the poecilogonous polychaete Streblospio benedicti (Spionidae)},
	year = {2005},
	journal = {Journal of Experimental Zoology Part B: Molecular and Developmental Evolution},
	volume = {304},
