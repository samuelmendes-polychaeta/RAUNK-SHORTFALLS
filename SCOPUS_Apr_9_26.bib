	title = {Demographic and population response of the threatened coral Acropora cervicornis (Scleractinia, Acroporidae) to fireworm corallivory; [Respuesta demográfica y poblacional del coral amenazado Acropora cervicornis (Scleractinia, Acroporidae) a la coralivoria por gusano de fuego]},
	year = {2023},
