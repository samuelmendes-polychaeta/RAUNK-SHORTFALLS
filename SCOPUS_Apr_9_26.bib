	author = {Michaud, Emma and Aller, Robert C. and Zhu, Qingzhi and Heilbrun, Christina and Stora, Georges},
	title = {Density and size-dependent bioturbation effects of the infaunal polychaete Nephtys incisa on sediment biogeochemistry and solute exchange},
	year = {2021},
	journal = {Journal of Marine Research},
	volume = {79},
