	author = {Lelièvre, Yann and Le Gall, Line and Dubois, Philippe and Saucède, Thomas},
	title = {Characterization of coastal habitats and marine benthic communities of the sub-Antarctic Crozet archipelago using underwater imagery},
	year = {2025},
	journal = {Antarctic Science},
	volume = {37},
