@ARTICLE{Zhang20102070,
	author = {Zhang, Weixin and Hendrix, Paul F. and Snyder, Bruce A. and Molina, Marirosa and Li, Jianxiong and Rao, Xingquan and Siemann, Evan and Fu, Shenglei},
	title = {Dietary flexibility aids Asian earthworm invasion in North American forests},
	year = {2010},
