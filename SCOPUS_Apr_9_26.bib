	correspondence_address = {L. Amo; Departamento de Ecología Evolutiva, Museo Nacional de Ciencias Naturales, CSIC, E-28006 Madrid, Jose Gutierrez Abascal 2, Spain; email: luisa.amo@mncn.csic.es},
	abbrev_source_title = {Physiol. Behav.},
	type = {Article},
