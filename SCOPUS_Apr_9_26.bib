@ARTICLE{Fischer2014108,
	author = {Fischer, Barbara and van Doorn, G Sander and Dieckmann, Ulf and Taborsky, Barbara},
	title = {The evolution of age-dependent plasticity},
	year = {2014},
	journal = {American Naturalist},
	volume = {183},
