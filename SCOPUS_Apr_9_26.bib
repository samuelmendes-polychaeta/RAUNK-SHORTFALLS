	title = {Ecotoxicological effects of a glyphosate-based herbicide on Gryllus (Gryllus) assimilis (Orthoptera: Gryllidae) ontogeny: a study on antioxidant system, oxidative stress and cholinergic system},
	year = {2025},
	journal = {Ecotoxicology},
