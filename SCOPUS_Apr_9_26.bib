@ARTICLE{Albano201193,
	author = {Albano, Noelia and Masero, José A. and Sánchez-Guzmán, Juan M. and Villegas, Auxiliadora and Santiago-Quesada, Francisco},
	title = {Effects of diet on growth-related patterns of energy and macronutrient assimilation efficiency in a semi-precocial bird, the Gull-billed Tern Gelochelidon nilotica},
