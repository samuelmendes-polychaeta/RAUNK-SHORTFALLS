}

@ARTICLE{Peijnenburg1999170,
	author = {Peijnenburg, Willie J. G. M. and Posthuma, Leo and Zweers, Patrick G. P. C. and Baerselman, Rob and De Groot, Arthur C. and Van Veen, Rens P. M. and Jager, Tjalling},
	title = {Prediction of metal bioavailability in dutch field soils for the oligochaete Enchytraeus crypticus},
	year = {1999},
	journal = {Ecotoxicology and Environmental Safety},
	volume = {43},
	number = {2},
	pages = {170 - 186},
	doi = {10.1006/eesa.1999.1773},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0033034199&doi=10.1006%2Feesa.1999.1773&partnerID=40&md5=1c0fc6828ec5de7a49ef1b14076b8082},
	affiliations = {National Institute of Public Health, Environ., Lab. for Ecotoxicology, 1, 3720 BA Bilthoven, Netherlands},
	abstract = {Current risk assessment procedures ignore that variation in soil properties results in substantial differences for uptake and effects in organisms in different soils. In this contribution is presented the results of a study on the soil-related factors that modulate metal uptake and elimination by the oligochaete worm Enchytraeus crypticus. Uptake of Cd, Cu, Pb, and Zn was quantified in 20 Dutch field soils as a function of time. Uptake rate constants and equilibrium concentrations were estimated using compartment modeling. Internal metal concentrations varied less than the corresponding external levels. Zn and especially Cu provided the most extreme examples of this general behavior, which suggests regulation by the organism. Body residues by Cd increased linearly over time in 11 of the 20 soils studied, whereas in the remaining 9 soils equilibration of internal Cd levels was observed. CaCl<sub>2</sub> extraction could be used to discriminate the 9 soils in which there is Pb accumulation from the 11 soils in which bioavailable Pb levels were too low to allow for uptake. Multivariate expressions that describe uptake rate constants and bioaccumulation factors as a function of soil characteristics were derived, pH and cation exchange capacity were the most important parameters. The formulae were very similar to those describing partitioning of metals over the solid and liquid phase of the soils, which suggests pore water-mediated uptake. A semi-mechanistic approach yielded further evidence of pore water-related uptake, modulated by competition between H<sup>+</sup> and metal ions at the active sites of the membranes.},
	author_keywords = {Bioavailability; Enchytraeus crypticus; Heavy metal; Metal accumulation; Uptake kinetics},
	correspondence_address = {W.J.G.M. Peijnenburg; Natl. Inst. of Pub. Health/Envmt., Laboratory for Ecotoxicology, 3720 BA Bilthoven, P.O. Box 1, Netherlands; email: wjgm.peijnenburg@rrivm.nl},
	abbrev_source_title = {Ecotoxicol. Environ. Saf.},
