@ARTICLE{McClain20121993,
	author = {McClain, Craig R. and Stegen, James C. and Hurlbert, Allen H.},
	title = {Dispersal, environmental niches and oceanic-scale turnover in deep-sea bivalves},
	year = {2012},
	journal = {Proceedings of the Royal Society B: Biological Sciences},
	volume = {279},
	number = {1735},
	pages = {1993 - 2002},
	doi = {10.1098/rspb.2011.2166},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84859408606&doi=10.1098%2Frspb.2011.2166&partnerID=40&md5=ef5299de02a8b833b7a918f2c1600c33},
	affiliations = {National Evolutionary Synthesis Center, Durham, NC 27705, United States; Department of Biology, University of North of Carolina, Chapel Hill, NC 27599-3280, United States; Pacific Northwest National Lab, Biological Sciences Division, Richland, WA 99352, United States},
	abstract = {Patterns of beta-diversity or distance decay at oceanic scales are completely unknown for deep-sea communities. Even when appropriate data exist, methodological problems have made it difficult to discern the relative roles of environmental filtering and dispersal limitation for generating faunal turnover patterns. Here, we combine a spatially extensive dataset on deep-sea bivalves with a model incorporating ecological dynamics and shared evolutionary history to quantify the effects of environmental filtering and dispersal limitation. Both the model and empirical data are used to relate functional, taxonomic and phylogenetic similarity between communities to environmental and spatial distances separating them for 270 sites across the Atlantic Ocean. This study represents the first ocean-wide analysis examining distance decay as a function of a broad suite of explanatory variables.We find that both strong environmental filtering and dispersal limitation drive turnover in taxonomic, functional and phylogenetic composition in deep-sea bivalves, explaining 26 per cent, 34 per cent and 9 per cent of the variation, respectively. This contrasts with previous suggestions that dispersal is not limiting in broad-scale biogeographic and biodiversity patterning in marine systems. However, rates of decay in similarity with environmental distance were eightfold to 44-fold steeper than with spatial distance. Energy availability is the most influential environmental variable evaluated, accounting for 3.9 per cent, 9.4 per cent and 22.3 per cent of the variation in functional, phylogenetic and taxonomic similarity, respectively. Comparing empirical patterns with process-based theoretical predictions provided quantitative estimates of dispersal limitation and niche breadth, indicating that 95 per cent of deep-sea bivalve propagules will be able to persist in environments that deviate from their optimum by up to 2.1 g m<sup>-2</sup> yr<sup>-1</sup> and typically disperse 749 km from their natal site. © 2011 The Royal Society.},
	author_keywords = {Approximate Bayesian computation; Beta-diversity; Dispersal; Distance decay; Niche; Pattern-oriented modelling},
	correspondence_address = {C. R. McClain; National Evolutionary Synthesis Center, Durham, NC 27705, United States; email: cmcclain@nescent.org},
	abbrev_source_title = {Proc. R. Soc. B  Biol. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 55; All Open Access; Bronze Open Access}
}

@ARTICLE{Cruz-Motta2010,
	author = {Cruz-Motta, Juan José and Miloslavich, Patricia and Palomo, Gabriela and Iken, Katrin and Konar, Brenda and Pohle, Gerhard and Trott, Tom and Benedetti-Cecchi, Lisandro and Herrera, César and Hernández, Alejandra and Sardi, Adriana and Bueno, Andrea and Castillo, Julio and Klein, Eduardo and Guerra-Castro, Edlin and Gobin, Judith and Gómez, Diana Isabel and Riosmena-Rodríguez, Rafael and Mead, Angela and Bigatti, Gregorio and Knowlton, Ann and Shirayama, Yoshihisa},
	title = {Patterns of spatial variation of assemblages associated with intertidal rocky shores: A global perspective},
	year = {2010},
	journal = {PLoS ONE},
	volume = {5},
