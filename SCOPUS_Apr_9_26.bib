@ARTICLE{Lai2025,
	author = {Lai, Xianshui and Li, Tingting and Cong, Bailin and Pitriana, Pipit and Wang, Bei and Zhao, Linlin and Liu, Shenghao},
	title = {Biodiversity and Conservation of Marine Mollusks in the Indo-Pacific Convergence Zone},
	year = {2025},
	journal = {Ecology and Evolution},
	volume = {15},
