	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191013047&doi=10.5252%2Fzoosystema2024v46a9&partnerID=40&md5=15579b645f9300bde63c4ee50480bd26},
	affiliations = {CEFE, Université de Montpellier, CNRS, EPHE, IRD, 1919 route de Mende Cedex 5, Montpellier, 34293, France; Munic. Ctr. for Culture and Devmt.-Organ. Farming: Agric. and Organ. Prod. Partnership at Ctr. for Organ. and Regenerative Agric., Centro Empresarial, Zona Industrial, Idanha-A-Nova, 6060-182, Portugal; Centre for Functional Ecology, Department of Life Sciences, University of Coimbra, Coimbra, 3041, Portugal; Facultad de Ciencias Ambientales, Universidad Tecnológica de Pereira, Pereira, A.A. 097, Colombia; Taxonomia Biodiversity Fund, 7 rue Beccaria, Paris, 72012, France; Department of Integrative Biology, University of Guelph, Guelph, N1G 2W1, Canada; AMAP, Université de Montpellier, CIRAD, CNRS, INRAE, IRD, 1919 route de Mende Cedex 5, Montpellier, 34293, France; Regenerative Agriculture Department, Maharishi International University, Fairfield, 52557, IA, United States},
	abstract = {Intensive sampling of earthworms in French Guiana has been carried out for several years. The first published results have highlighted a very high regional diversity, a considerable geographical turnover in the composition of communities, as well as a very high proportion of species new to science. However, the work of describing these new species had not been undertaken until now. In this work, we present the results of the sampling carried out in March 2015 during the "Our Planet Reviewed" terrestrial expedition in the Mitaraka Range. We used an integrative taxonomy approach combining the use of DNA barcodes and morpho-Anatomical characters, which allowed the identification of 31 species, nine of which were represented in our samples only by juveniles, and four of which corresponded to already known species (Nouraguesia parareCsuzdi & Pavlícek, 2011, Pontoscolex corethrurus (Müller, 1856), Dichogaster andinaCognetti de Martiis, 1904 and Dichogaster bolaui (Michaelsen,1891)). The remaining 18 species were new to science and are described in this work. They belong to the genera AndiorrhinusCognetti de Martiis, 1908 (one species), MartiodrilusMichaelsen, 1936 (nine species), UrobenusBenham, 1886 (one species), AtatinaRighi, 1971 (one species), NeogasterCernosvitov, 1934 (two species), OmodeoscolexCsuzdi, 1993 (three species), and a new genus of OcnerodrilidaeBeddard, 1891 which we describe as Guianodrilus Bartz & Decaëns, n. gen. We then discuss the Linnaean deficit that characterizes the earthworm fauna of French Guiana and the taxonomic implications of our results. © 2024 BioOne. All rights reserved.},
	author_keywords = {Andiorrhinus; Atatina; Earthworms; French Guiana; Martiodrilus; Neogaster; new genus; new species; Omodeoscolex; Urobenus},
	abbrev_source_title = {Zoosystema},
