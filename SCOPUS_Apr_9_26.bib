@ARTICLE{Braeckman201555,
	author = {Braeckman, Ulrike and Provoost, Pieter and Sabbe, Koen and Soetaert, Karline and Middelburg, Jack J. and Vincx, Magda and Vanaverbeke, Jan},
	title = {Temporal dynamics in a shallow coastal benthic food web: Insights from fatty acid biomarkers and their stable isotopes},
