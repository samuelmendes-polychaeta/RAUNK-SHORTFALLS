@ARTICLE{Boag2018,
	author = {Boag, Thomas H. and Stockey, Richard G. and Elder, Leanne E. and Hull, Pincelli M. and Sperling, Erik A.},
	title = {Oxygen, temperature and the deep-marine stenothermal cradle of Ediacaran evolution},
	year = {2018},
	journal = {Proceedings of the Royal Society B: Biological Sciences},
	volume = {285},
	number = {1893},
