@ARTICLE{Oleszczuk2021,
	author = {Oleszczuk, Barbara and Grzelak, Katarzyna and Kędra, Monika},
	title = {Community structure and productivity of Arctic benthic fauna across depth gradients during springtime},
	year = {2021},
	journal = {Deep-Sea Research Part I: Oceanographic Research Papers},
