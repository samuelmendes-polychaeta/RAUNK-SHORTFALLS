@ARTICLE{Lai201647,
	author = {Lai, Yi-Te and Kekäläinen, Jukka and Kortet, Raine},
	title = {Does parasitic infection by the body cavity dwelling philometra ovata (Nematoda) impair swimming performance of male european minnow (phoxinus phoxinus)?},
