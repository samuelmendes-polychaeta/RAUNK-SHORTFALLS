@ARTICLE{Kelly2024,
	author = {Kelly, Eleanor R.M. and Trujillo, José E. and Setiawan, Alvin and Pether, Steve and Burritt, David and Allan, Bridie J.M.},
	title = {Investigating the metabolic and oxidative stress induced by biofouled microplastics exposure in Seriola lalandi (yellowtail kingfish)},
	year = {2024},
