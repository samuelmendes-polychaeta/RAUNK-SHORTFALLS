}

@ARTICLE{Muller2021,
	author = {Muller, Alexandre and Poitrimol, Camille and Nunes, Flávia L. D. and Boyé, Aurélien and Curd, Amelia and Desroy, Nicolas and Firth, Louise B. and Bush, Laura and Davies, Andrew J. and Lima, Fernando P. and Marzloff, Martin P. and Meneghesso, Claudia and Seabra, Rui and Dubois, Stanislas F.},
	title = {Musical Chairs on Temperate Reefs: Species Turnover and Replacement Within Functional Groups Explain Regional Diversity Variation in Assemblages Associated With Honeycomb Worms},
