@ARTICLE{Naik2023,
	author = {Naik, Abhishek T. and Kamensky, Kristina M. and Hellum, Aren M. and Moisander, Pia H.},
	title = {Disturbance frequency directs microbial community succession in marine biofilms exposed to shear},
	year = {2023},
	journal = {mSphere},
	volume = {8},
