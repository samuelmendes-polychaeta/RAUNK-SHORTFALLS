@ARTICLE{Parker2024642,
	author = {Parker, Anna L. and Kingsolver, Joel G.},
	title = {The interactive effects of heat stress, parasitism and host plant quality in a host–parasitoid system},
	year = {2024},
	journal = {Functional Ecology},
	volume = {38},
