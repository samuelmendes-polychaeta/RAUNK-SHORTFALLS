	abbrev_source_title = {Sci. Total Environ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Carrera2025,
	author = {Carrera, Noela and Juan-Ovejero, Raquel},
	title = {Long-term belowground impacts of experimental fire and post-fire soil stabilization treatments in a gorse shrubland},
	year = {2025},
	journal = {Applied Soil Ecology},
	volume = {206},
	pages = {},
	doi = {10.1016/j.apsoil.2024.105847},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85212535693&doi=10.1016%2Fj.apsoil.2024.105847&partnerID=40&md5=e58af38c6cb7d0f488a827d2f6fe1c76},
	affiliations = {Forest Research Centre of Lourizán, Consellería de Economía e Industria, Xunta de Galicia, Estrada Pontevedra-Marín, Km. 4, Pontevedra, 36080, Spain; Centre for Functional Ecology, Associate Laboratory TERRA, Department of Life Sciences, University of Coimbra, Coimbra, 3000-456, Portugal; Department of Ecology and Animal Biology, University of Vigo, Vigo, 36310, Spain},
	abstract = {Wildfires represent the foremost disruption in shrublands across the region of Galicia (NW Spain) and their severity is predicted to increase in the context of climate change. To alleviate their impact, soil stabilization techniques are commonly implemented. Nevertheless, there is a noticeable lack of information about the long-term consequences of fire and these post-fire interventions in these ecosystems. Moreover, scant attention has been paid to assessing how fire and post-fire disturbances affect soil microarthropod communities under these circumstances. In this study, we investigated the effects of an experimental fire along with two soil stabilization treatments (straw mulching or grass seeding) in a gorse (Ulex europaeus L.) shrubland, 12.5 years after the fire and the implementation of these post-fire techniques. Specifically, we examined the long-term effects on vegetation cover (total coverage and different growth forms), soil physico-chemical (soil water repellency, water stability of aggregates, pH, electrical conductivity, soil moisture, C and N content, and dissolved organic carbon) and microbiological (microbial biomass, β-glucosidase and acid phosphatase activities) properties, microarthropod communities (considering total abundance and abundances of high-rank taxa and foraging behaviour groups), and the QBS-ar (Soil Biological Quality-arthropods) index. Our results showed that the experimental fire and subsequent post-fire management strategies did not have any significant effect on vegetation cover or soil physico-chemical and microbiological properties more than a decade after the fire. However, microarthropod communities were negatively affected by grass seeding, with density values reduced by an average of 55 % compared to those subjected solely to the experimental fire. Moreover, average values of the QBS-ar index were significantly lower in soils under both straw mulching (126.3) and grass seeding (124.2) treatments than in burned soils without post-fire measurements (154.3). A redundancy analysis (RDA) showed that soil water repellency had a significant negative influence on microarthropod communities among treatments. A reduction in food resources, together with higher repellency levels, could have impeded soil animal survival and movement under post-fire straw mulching and grass seeding strategies. Our findings challenge the notion that post-fire soil stabilization treatments uniformly contribute to improved ecosystem rehabilitation at the long-term, and suggest that microarthropods may exhibit a distinct recovery pattern compared to vegetation or other soil parameters. © 2024 Elsevier B.V.},
	author_keywords = {Grass seeding; Microarthropod communities; QBS-ar index; Soil properties; Straw mulching; Vegetation cover},
	correspondence_address = {N. Carrera; Forest Research Centre of Lourizán, Consellería de Economía e Industria, Xunta de Galicia, Pontevedra, Estrada Pontevedra-Marín, Km. 4, 36080, Spain; email: noela.carrera.perez@xunta.gal},
	abbrev_source_title = {Appl. Soil Ecol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Green Open Access}
}

