	affiliations = {Programa de Pós-Graduação em Ecologia, Universidade Federal do Rio Grande do Sul, Avenida Bento Gonçalves 9500, Rio Grande do Sul, Porto Alegre, CEP 91540-000, Brazil; School of Environmental Sciences, University of East Anglia, Norwich Research Park, Norwich, Norfolk, NR4 7TJ, United Kingdom; Universidade Federal do Paraná - UFPR, Rua dos Funcionários 1540, Curitiba-PR, 80035-050, Brazil; Unité Mixte de Recherche sur l'Écosystème Prairial (UREP), Institut National de Recherche pour l'Agriculture l'Alimentation et l'Environnement (INRAE), Clermont-Ferrand, France; Empresa Brasileira de Pesquisa Agropecuária Florestas - Embrapa Florestas, Estrada da Ribeira Km 111, Caixa Postal 319, PR, Colombo, CEP 83411-000, Brazil; Municipal Center for Culture and Development (CMCD) - Organic Farming: Agriculture and Organic Production Partnership, Centre for Organic and Regenerative Agricullture, Zona Industrial 6060-182, Idanha-a-Nova, Portugal; Centre for Functional Ecology, Department of Life Sciences, University of Coimbra, Coimbra, Portugal},
	abstract = {In this study, we sampled grazed natural grassland and agropastoral systems in two regions (Alegrete and Aceguá) in the highly diverse Brazilian Pampa region which is undergoing significant change in land use cover. By hand sorting the soil, a total of five species were found, belonging to the families Glossoscolecidae (Glossoscolex sp.50 and Glossoscolex sp.51), Ocnerodrilidae (Kerriona sp.6 and Eukerria sp.3), and Lumbricidae (Aporrectodea trapezoides). The former four were identified as native-new to science-and the latter as exotic. Differences were observed in both earthworm species richness and abundance between regions and land-use systems, likely due to environmental conditions and agricultural practices, respectively. Agropastoral systems had higher abundance and species richness than natural grasslands, though these differences varied by location. This suggests that conversion from natural grassland to agropastoral systems can maintain native earthworms and, possibly, enhance ecosystem services. However, an exotic species was found in high abundance at one agropastoral site. These results highlight the need for additional biodiversity studies on earthworms in the Brazilian Pampa and for research on the impacts of land use changes in this region.  © 2023 Magnolia Press.},
	author_keywords = {agropastoral systems; ecosystem engineers; native grass pastures; Oligochaeta; soil macrofauna},
