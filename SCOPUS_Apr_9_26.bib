@ARTICLE{Navarro-Mayoral20251683,
	author = {Navarro-Mayoral, Sandra and Díaz-Vergara, Sonia and Bosch, Néstor E. and Tuya, Fernando and Bramanti, Lorenzo and Fernandez-Gonzalez, Victoria and Terrana, Lucas and Espino, Fernando and Haroun, Ricardo and Otero-Ferrer, Francisco},
	title = {Inside the mesophotic zone: taxonomic and trait diversity of epifauna associated with black coral forests across an oceanic archipelago},
