	title = {Salish Sea crustacean biodiversity is remarkably high and increases with oceanic influences},
	year = {2025},
	journal = {Marine Biodiversity},
	volume = {55},
	number = {6},
	pages = {},
	doi = {10.1007/s12526-025-01609-x},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024137512&doi=10.1007%2Fs12526-025-01609-x&partnerID=40&md5=63b1ff5263175d9a29891e1a8ed6e94b},
	affiliations = {Department of Biology, Seattle University, 901 12 th Ave, Seattle, 98122, WA, United States; Florida Museum of Natural History, University of Florida, Gainesville, 32611, FL, United States; Smithsonian Tropical Research Institute, Smithsonian Institution, Ancon, Balboa, Panama; Northwest Fisheries Science Center, National Marine Fisheries Service, National Oceanic and Atmospheric Administration, 2725 Montlake Boulevard East, Seattle, 98112, WA, United States; Florida Museum of Natural History, University of Florida, Gainesville, United States; School of Biological Sciences, Swire Institute of Marine Science, The University of Hong Kong, SAR, Hong Kong},
	abstract = {Standardized sampling and genetic barcoding have transformed our ability to quantify the biodiversity of cryptic marine fauna. Most studies have focused on quantifying diversity in archetypically diverse marine habitats, such as tropical coral reefs. In this study, Autonomous Reef Monitoring Structures (ARMS), DNA barcoding, and morphology-based taxonomic identifications were utilized to characterize patterns of diversity within a large temperate estuary and inland sea in the NE Pacific Ocean. Globally, crustaceans constitute one third of all described marine species and were the focus of this study. ARMS were deployed at five sites across the southern Salish Sea (Strait of Juan de Fuca, San Juan Islands, and Puget Sound, Washington, USA). Forty-one species of crustacean were documented. Species diversity increased oceanward, highest in the northern sites closest to the entrance to the Pacific Ocean, mirroring diversity trends seen in other estuary systems. Overall patterns of crustacean diversity in the region were comparable to diversity estimates from ARMS in subtropical coral reefs or temperate oyster beds, underscoring the remarkable diversity of the northeastern Pacific invertebrate fauna. © The Author(s), under exclusive licence to Senckenberg Gesellschaft für Naturforschung 2025.},
	author_keywords = {Autonomous Reef Monitoring Structures (ARMS); COI; Crustacean; DNA barcoding; Puget Sound; Salish Sea; Standardized sampling},
	correspondence_address = {K.M. Hultgren; Department of Biology, Seattle University, Seattle, 901 12 th Ave, 98122, United States; email: hultgrenk@seattleu.edu},
