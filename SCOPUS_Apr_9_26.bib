@ARTICLE{Maggi20201793,
	author = {Maggi, E. and Bertocci, I. and Benedetti-Cecchi, L.},
	title = {Light pollution enhances temporal variability of photosynthetic activity in mature and developing biofilm},
	year = {2020},
	journal = {Hydrobiologia},
	volume = {847},
