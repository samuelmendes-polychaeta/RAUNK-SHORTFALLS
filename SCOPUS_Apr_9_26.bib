@ARTICLE{Bhattarai2026,
	author = {Bhattarai, Abhi and Mcghie, Emily W. and Woo, Joshua C. and Niraula, Srijana and Rosetti, Patrick and Kim, Jaxon M. and Popoola, Ezekiel and Johnson, Ruth I.},
	title = {Generation and maintenance of apical rib-like actin fibers in epithelial support cells of the Drosophila eye},
	year = {2026},
	journal = {Development (Cambridge)},
	volume = {153},
