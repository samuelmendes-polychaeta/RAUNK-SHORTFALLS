	title = {Enhancement of nitrogen removal by Tubifex tubifex in saturated vertical flow constructed wetlands under antibiotic stress},
	year = {2025},
	journal = {Journal of Environmental Management},
	volume = {394},
	pages = {},
	doi = {10.1016/j.jenvman.2025.127598},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017963447&doi=10.1016%2Fj.jenvman.2025.127598&partnerID=40&md5=0e31da52c4f9e6df7fb6be443a1db6b4},
	affiliations = {Jiangsu Key Laboratory of Crop Genetics and Physiology/Jiangsu Key Laboratory of Crop Cultivation and Physiology/Jiangsu Co-Innovation Centre for Modern Production Technology of Grain Crops, Yangzhou University, Yangzhou, 225009, China; College of Bioscience and Biotechnology, Yangzhou University, Yangzhou, 225009, China; Department of Geography, Faculty of Environment, Science and Economy, University of Exeter, Exeter, EX4 4QG, United Kingdom},
	abstract = {Constructed wetlands (CWs), particularly saturated vertical flow wetlands (VF-CWs) are effective at removing nitrogen. However, their performance can be hindered by antibiotics, and biological solutions to this issue remains largely unexplored. In this study, lab-scale saturated VF-CWs were established to test whether Tubifex tubifex can enhance nitrogen (N) removal in saturated VF-CWs under antibiotic stress. Antibiotics significantly reduced N removal efficiency of saturated VF-CWs, decreasing the average removal efficiencies of ammonia nitrogen (NH<sub>4</sub><sup>+</sup>-N) from 43.1 ± 2.1 % to 37.5 ± 2.2 % (p < 0.05) and nitrate/nitrite nitrogen (NO<sub>x</sub><sup>−</sup>-N) from 58.7 ± 2.0 % to 47.9 ± 2.1 % (p < 0.01). The addition of T. tubifex significantly improved these rates to 47.1 ± 2.2 % (p < 0.05) and 71.9 ± 2.1 % and (p < 0.01), respectively. T. tubifex addition decreased antibiotic concentrations by ingesting antibiotics and facilitating roots absorption while restricting their translocation between macrophyte tissues. Its presence also increased bacterial diversity and N-cycle bacterial abundance in both sediment and the rhizosphere under antibiotic stress. Enhanced ammonia oxidation (AOB), denitrification (narG and nosZ) and anammox were identified as the main drivers of increased N removal. Moreover, T. tubifex suppressed antibiotic resistance genes, resulting in an average threefold reduction. Therefore, T. tubifex is a useful tool for improving N removal in saturated VF-CWs treating antibiotic-laden wastewater. © 2025 Elsevier Ltd},
	author_keywords = {Antibiotics; Constructed wetlands; Nitrogen removal; Tubifex tubifex},
	correspondence_address = {Y. Chen; Jiangsu Key Laboratory of Crop Genetics and Physiology/Jiangsu Key Laboratory of Crop Cultivation and Physiology/Jiangsu Co-Innovation Centre for Modern Production Technology of Grain Crops, Yangzhou University, Yangzhou, 225009, China; email: yunchen@yzu.edu.cn},
