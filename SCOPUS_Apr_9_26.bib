@ARTICLE{Below202685,
	author = {Below, Patrick and Gorb, Stanislav N. and Friedrich, Frank and Krings, Wencke},
	title = {Morphological and biomechanical adaptations of larval mandibles in Trichoptera (Insecta)},
	year = {2026},
	journal = {Physiological Entomology},
