	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064946243&doi=10.1016%2Fj.str.2019.02.002&partnerID=40&md5=5257045ceda4f85bda4313ec231d8c05},
	affiliations = {University of Grenoble Alpes, CNRS, CERMAV, Grenoble, 38000, France; Swiss Institute of Bioinformatics, Geneva, 1227, Switzerland; Computer Science Department, UniGe, Geneva, 1227, Switzerland; Section of Biology, UniGe, Geneva, 1205, Switzerland; CEITEC, Masaryk University, Brno, 625 00, Czech Republic; NCBR, Faculty of Science, Masaryk University, Brno, 625 00, Czech Republic; School of Chemistry, University of Bangor, Bangor, LL57 2UW, United Kingdom; University of Grenoble Alpes, CNRS, DPM, Grenoble, 38000, France},
	abstract = {Lectins with a β-propeller fold bind glycans on the cell surface through multivalent binding sites and appropriate directionality. These proteins are formed by repeats of short domains, raising questions about evolutionary duplication. However, these repeats are difficult to detect in translated genomes and seldom correctly annotated in sequence databases. To address these issues, we defined the blade signature of the five types of β-propellers using 3D-structural data. With these templates, we predicted 3,887 β-propeller lectins in 1,889 species and organized this information in a searchable online database. The data reveal a widespread distribution of β-propeller lectins across species. Prediction also emphasizes multiple architectures and led to the discovery of a β-propeller assembly scenario. This was confirmed by producing and characterizing a predicted protein coded in the genome of Kordia zhangzhouensis. The crystal structure uncovers an intermediate in the evolution of β-propeller assembly and demonstrates the power of our tools. Donut-shaped β-propeller lectins are made of repeated blades, each containing binding sites for carbohydrates. This scaffold is of high interest for protein evolution, biotechnology, and nanotechnology. An algorithm for screening sequence databases for such lectins was implemented. Some predicted sequences revealed an alternate scenario of β-propeller assembly that we experimentally validated. © 2019 Elsevier Ltd},
	author_keywords = {carbohydrate binding protein; lectins; oligomerization; β-propeller},
	correspondence_address = {F. Lisacek; Swiss Institute of Bioinformatics, Geneva, 1227, Switzerland; email: frederique.lisacek@sib.swiss},
