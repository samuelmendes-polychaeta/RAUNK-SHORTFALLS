@ARTICLE{Gerwing2016,
	author = {Gerwing, Travis G. and Drolet, David and Hamilton, Diana J. and Barbeau, Myriam A.},
	title = {Relative Importance of Biotic and Abiotic Forces on the Composition and Dynamics of a Soft-Sediment Intertidal Community},
	year = {2016},
	journal = {PLoS ONE},
