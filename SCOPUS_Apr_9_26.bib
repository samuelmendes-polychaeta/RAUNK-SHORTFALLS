	affiliations = {University of Vienna, Department of Functional and Evolutionary Ecology, Vienna, Austria; Royal Netherlands Institute for Sea Research (NIOZ), ‘t Horntje, Netherlands; Max-Planck Institute for Marine Microbiology, Bremen, Germany; Biology Department, Woods Hole Oceanographic Institution, Woods Hole, United States; MIT-WHOI Joint Program in Oceanography/Applied Ocean Science & amp; Engineering, Cambridge and Woods Hole, United States; Harvard University, Department of Organismic and Evolutionary Biology, Cambridge, United States; UMR 8222 LECOB, CNRS-Sorbonne Université, Observatoire Océanologique de Banyuls, Banyuls-sur-Mer, France; Marine Biology Station Piran, National Institute of Biology, Piran, Slovenia; University of Costa Rica, School of Biology, San Pedro, Costa Rica; University of Vienna, Department of Palaeontology, Vienna, Austria; Schmidt Ocean Institute, Palo Alto, United States},
	abstract = {It was once believed that only microbes and viruses inhabited the subseafloor crust beneath hydrothermal vents. Yet, on the seafloor, animals like the giant tubeworm Riftia pachyptila thrive. Their larvae are thought to disperse in the water column, despite never being observed there. We hypothesized that these larvae travel through the subseafloor via vent fluids. In our exploration, lifting lobate lava shelves revealed adult tubeworms and other vent animals in subseafloor cavities. The discovery of vent endemic animals below the visible seafloor shows that the seafloor and subseafloor faunal communities are connected. The presence of adult tubeworms suggests larval dispersal through the recharge zone of the hydrothermal circulation system. Given that many of these animals are host to dense bacterial communities that oxidize reduced chemicals and fix carbon, the extension of animal habitats into the subseafloor has implications for local and regional geochemical flux measurements. These findings underscore the need for protecting vents, as the extent of these habitats has yet to be fully ascertained. © The Author(s) 2024.},
	correspondence_address = {M. Bright; University of Vienna, Department of Functional and Evolutionary Ecology, Vienna, Austria; email: monika.bright@univie.ac.at; S. Gollner; Royal Netherlands Institute for Sea Research (NIOZ), ‘t Horntje, Netherlands; email: sabine.gollner@nioz.nl},
