	year = {2022},
	journal = {Journal of Ecology},
	volume = {110},
	number = {3},
	pages = {659 - 672},
	doi = {10.1111/1365-2745.13829},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85123480994&doi=10.1111%2F1365-2745.13829&partnerID=40&md5=e0c3c2705632fac8f4e8a954ee5954bb},
	affiliations = {CAS Key laboratory of aquatic and watershed ecology, Wuhan Botanical Garden, Chinese Academy of Sciences, Wuhan, China; CAS Key Laboratory of Tropical Forest Ecology, Xishuangbanna Tropical Botanical Garden, Chinese Academy of Sciences, Menglun, China; Center of Plant Ecology, Core Botanical Gardens, Chinese Academy of Sciences, Wuhan/Menglun, China; Sino-Africa Joint Research Center, Chinese Academy of Sciences, Wuhan, China; University of Chinese Academy of Sciences (UCAS), Beijing, China; Royal Botanic Gardens Kew, Welcome Trust Millennium Building, Wakehurst, United Kingdom; Department of Ecological Science, Faculty of Science, Vrije Universiteit, Amsterdam, Netherlands},
	abstract = {More than half of the net primary production in terrestrial ecosystems returns to the soil through leaf litter fall and decomposition. In terrestrial ecosystems, litter constitutes a mixture of mainly senescent foliage from multiple species. Yet, the effect of litter mixing on litter decomposition rate remains ambiguous. Quantification of the soil fauna contribution and inclusion of their interaction with litter could remove the prevailing ambiguity, as soil fauna might influence the direction and magnitude of litter mixture effects on decomposition. We carried out a global meta-analysis to elucidate how soil fauna influenced litter mixture decomposition rate based on 55 published studies with 873 fauna inclusion/exclusion observations in field litterbag experiments. We hypothesized that soil fauna inclusion in litter mixture experiments would cause a positive change in the magnitude of mixed litter decomposition. That is, the presence of soil fauna would lead to synergistic litter mixture effects while the absence of soil fauna would lead to antagonistic litter mixture effects. Furthermore, we hypothesized that soil fauna would have a greater positive impact on the litter mixture effect in environments with low precipitation. While litter mixture had a neutral effect on decomposition on average across studies, non-additive mixture effects were common, with a key role for soil fauna, which generally enhanced decomposition rate compared to the component single-species litters. In contrast, fauna exclusion resulted in diminished decomposition rate overall. The overall synergistic soil fauna effect on litter mixture decomposition increased under low precipitation. Under high precipitation, the litter mixture effect was positive in the absence of soil fauna but non-significant in the presence of fauna. Climate imposes a great effect on litter mixture, with synergistic effects increasing towards the equator. Synthesis. These results highlight the importance of soil fauna in mixed litter decomposition, most strongly in dry environments. In this era of global climate change, where some regions are projected to become drier, soil fauna might compensate the expected slower decomposition of litter by increasingly enhancing litter mixture decomposition. © 2022 British Ecological Society.},
	author_keywords = {biodiversity; drought; ecosystems functions; global analysis; litter decomposition; litter mixture effect; nutrient cycling; soil fauna},
	correspondence_address = {J. Zuo; CAS Key laboratory of aquatic and watershed ecology, Wuhan Botanical Garden, Chinese Academy of Sciences, Wuhan, China; email: zuojuan@wbgcas.cn; G.G.O. Dossa; CAS Key Laboratory of Tropical Forest Ecology, Xishuangbanna Tropical Botanical Garden, Chinese Academy of Sciences, Menglun, China; email: dgbadamassi@gmail.com},
	abbrev_source_title = {J. Ecol.},
