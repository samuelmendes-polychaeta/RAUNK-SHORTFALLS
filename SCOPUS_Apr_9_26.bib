	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 223; All Open Access; Green Open Access}
}

@ARTICLE{Washburn201721,
	author = {Washburn, Travis W. and Reuscher, Michael G. and Montagna, Paul A. and Cooksey, Cynthia and Hyland, Jeffrey L.},
	title = {Macrobenthic community structure in the deep Gulf of Mexico one year after the Deepwater Horizon blowout},
	year = {2017},
	journal = {Deep-Sea Research Part I: Oceanographic Research Papers},
	volume = {127},
	pages = {21 - 30},
	doi = {10.1016/j.dsr.2017.06.001},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85026647516&doi=10.1016%2Fj.dsr.2017.06.001&partnerID=40&md5=d9e61a2da77680ce72c7555f0cc6ca59},
	affiliations = {Harte Research Institute for Gulf of Mexico Studies, Texas A&M University-Corpus Christi, 6300 Ocean Drive, Unit 5869, Corpus Christi, 78412-5869, TX, United States; NOAA/NOS, National Centers for Coastal Ocean Science, Charleston, 29412-9110, SC, United States},
	abstract = {The impacts of the 2010 Deepwater Horizon (DWH) disaster on deep-sea Gulf of Mexico benthic communities were analyzed one year after the blowout. Richness, diversity, and evenness were severely impaired within a radius of approximately 1 km around the DWH wellhead. However, lower diversity than background was observed in several stations up to 29 km to the southwest of the wellhead. Compared to samples from 2010, abundance near the DWH wellhead increased in 2011 with some of the highest values found at stations within the 1 km radius. The increase was mostly caused by the high abundance of opportunistic polychaetes of the family Dorvilleidae, genus Ophryotrocha. At contaminated stations near the DWH wellhead, diversity did not change with increased sampling area, whereas a steep increase of diversity with increasing sampling area was observed at stations farther from the wellhead. The spatial extent of DWH impacts appeared to decrease from 2010 to 2011. Impacts on diversity near the wellhead were still observed; however, the large increase in abundance may indicate the initial stages of recovery, year-to-year variability, or an early stage of succession following a disturbance; and this can be resolved only with additional temporal sampling. © 2017 Elsevier Ltd},
	author_keywords = {Benthos; Deep sea; Diversity; Macrofauna; Oil spill; PAH; Recovery; Succession; Temporal variability},
	correspondence_address = {P.A. Montagna; Harte Research Institute for Gulf of Mexico Studies, Texas A&M University-Corpus Christi, Corpus Christi, 6300 Ocean Drive, Unit 5869, 78412-5869, United States; email: paul.montagna@tamucc.edu},
