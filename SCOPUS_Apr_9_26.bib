@ARTICLE{Magri2018S68,
	author = {Magri, M. and Benelli, S. and Bondavalli, C. and Bartoli, M. and Christian, R.R. and Bodini, A.},
	title = {Benthic N pathways in illuminated and bioturbated sediments studied with network analysis},
	year = {2018},
