@ARTICLE{Pairohakul2021,
	author = {Pairohakul, Supanut and Olive, Peter J. W. and Bentley, Matthew G. and Caldwell, Gary S.},
	title = {Trophic upgrading of long-chain polyunsaturated fatty acids by polychaetes: a stable isotope approach using Alitta virens},
	year = {2021},
	journal = {Marine Biology},
	volume = {168},
