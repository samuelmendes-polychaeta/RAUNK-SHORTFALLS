	year = {2025},
	journal = {International Journal of Biological and Chemical Sciences},
	volume = {19},
	number = {6},
	pages = {2685 - 2757},
	doi = {10.4314/ijbcs.v19i6.32},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105033669214&doi=10.4314%2Fijbcs.v19i6.32&partnerID=40&md5=90700285f768a8b25cc677a0644ca27a},
	affiliations = {Laboratory of Animal Biodiversity and Ecology, Marien Ngouabi University, BP 69, Brazzaville, Democratic Republic Congo; Foundation for Arthropod Biodiversity and Crop Protection, BP 69, Brazzaville, Democratic Republic Congo; UFR Sciences et Techniques, Université d’Orléans, Orléans, 45100, France},
	abstract = {Freshwater ecosystem in urban environments, are increasingly vulnerable to climate change and anthropogenic pressures, which alter water quality and disrupt biological communities. The Mfoa river, a small urban watercourse crossing Brazzaville (Republic of Congo), receives continuous inputs of household and industrial effluents. This study presented the first bioassessment of benthic macroinvertebrate communities in the Mfoa river. Two stations—upstream and downstream—were surveyed during the wet season. Macroinvertebrates were sampled using standardised benthic collection techniques, identified to the family level, and analysed using richness, abundance Shannon-Wiener diversity (H′) and Pielou’s evenness (Pielou’s E). The community was overwhelmingly dominated by Arthropoda (87.8%), followed by Mollusca (10%) and Annelida (2.2%). Diversity and evenness were low overall (station 1: H′ = 0.505, E = 0.219; station 2: H′ = 0.910, E = 0.508). The most abundant families were Chironomidae (87%) and Physidae (9.7%), both of which are considered pollution-tolerant taxa. In contrast, pollution-sensitive groups (EPT: Ephemeroptera, Plecoptera, Trichoptera) were entirely absent. Despite a relatively brief sampling period and, an absence of physicochemical data, this study underscores the ecological degradation of the Mfoa river and highlights the need for long-term monitoring and integrated management strategies in urban freshwater systems in Central Africa. © 2025 International Formulae Group. All rights reserved.},
	author_keywords = {Benthic Macroinvertebrates; Bioindicators; Mfoa river; Water quality assessment},
	correspondence_address = {M.B. Mbou Okassa; Laboratory of Animal Biodiversity and Ecology, Marien Ngouabi University, Brazzaville, BP 69, Democratic Republic Congo; email: mireille.bellembou@fondation-bapc.org},
