	source = {Scopus},
	note = {Cited by: 48}
}

@ARTICLE{Jackson20091411,
	author = {Jackson, Heather Bird and Baum, Kristen A. and Robert, Tristan and Cronin, James T.},
	title = {Habitat-specific movement and edge-mediated behavior of the saproxylic insect odontotaenius disjunctus (coleoptera: Passalidae)},
	year = {2009},
	journal = {Environmental Entomology},
	volume = {38},
	number = {5},
	pages = {1411 - 1422},
	doi = {10.1603/022.038.0509},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-77449130949&doi=10.1603%2F022.038.0509&partnerID=40&md5=b3853007933c54bf21ca8935452954a6},
	abstract = {The ability to disperse among patches is central to population dynamics in fragmented landscapes. Although saproxylic (=dead wood dependent) insects live in extremely fragmented forest ecosystems and comprise a significant proportion of the biodiversity therein, few studies have focused on dispersal of members in this group. We quantified the terrestrial movements of Odontotaenius disjunctus Illiger, a common saproxylic beetle in eastern North American forests. Movement behavior of individual beetles was measured in deciduous forest and two common matrix (=unsuitable) habitats (urban lawn and cattle pasture). Probability of emigrating from a forest fragment was assessed at the high-contrast boundary between forest and pasture. Seasonal, diurnal, and sex-biased patterns of O. disjunctus dispersal were determined from captures at drift fences encircling inhabited logs. Movement was 1.6 and 2.7 times faster and 1.1 and 1.5 times more linear in suitable habitat (forest) than in unsuitable matrix (lawn and pasture, respectively). Net displacement in the forest exceeded predictions of a correlated random walk, but net displacement in matrix habitats was less than expected. When confronted with a high-contrast boundary, O. disjunctus was 14 times more likely to move toward the forest than the pasture. The importance of temperature was indicated by its positive relationship with movement rate and increased diurnal and warm season dispersal activity. Reluctance to cross boundaries into open fields and slow movement within open fields suggest a low likelihood of terrestrial O. disjunctus movement among forest fragments. © 2009 Entomological Society of America.},
	author_keywords = {Bess beetle; Coarse woody debris; Horned passalus; Landscape matrix},
	correspondence_address = {H. B. Jackson; email: hjacks1@lsu.edu},
	abbrev_source_title = {Environ. Entomol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 23; All Open Access; Bronze Open Access}
}

