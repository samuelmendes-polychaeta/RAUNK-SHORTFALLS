	doi = {10.1344/GeologicaActa2024.22.9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216855429&doi=10.1344%2FGeologicaActa2024.22.9&partnerID=40&md5=5de89fed040ebe788ae63297d7d8bbb0},
	affiliations = {Departament de Mineralogia, Petrologia i Geologia Aplicada, Facultat de Ciències de la Terra, Universitat de Barcelona, c/Martí i Franquès s/n, Catalonia, Barcelona, 08028, Spain; Institut de Recerca GEOMODELS, c/Martí i Franquès s/n, Catalonia, Barcelona, 08028, Spain; Département de Géosciences, Université de Fribourg, Chemin du Musée 6, Fribourg, 1700, Switzerland},
	abstract = {Whereas post-mortem bioerosional features such as bivalve, sponge or worm borings are frequently preserved in ancient corals, reports of ante-mortem skeletal anomalies are rare and virtually non-existent from Mesozoic specimens. Here, we document the occurrence of fossil skeletal lesions produced during the life span of the colonies in exceptionally well-preserved Aptian (Early Cretaceous) scleractinians from the Maestrat Basin (East Iberia). These ante-mortem damage features are characterized by millimetric to centimetric areas of skeletal depression, as well as upward growth around damaged areas indicating regeneration. Depressed skeletal lesions are commonly overprinted by post-mortem lithophagid borings. Distribution of skeletal anomalies on the colonies can be focal or multifocal, and their location basal, medial and/or apical. The extent of the skeletal anomalies can be mild (occupying <10% of the colony) to extreme (occupying ≥50% of the colony). The edges of the skeletal anomalies are distinct (disk-shaped) or annular (ring-shaped), the margins are mainly smooth to uneven, and the shapes are circular, oblong, pyriform, linear, or irregular. The skeletal anomalies exhibited by the corals are comparable to tissue lesions produced in modern corals either by predation, bioerosion or disease, which may be followed by skeletal overgrowth or denudation. Although demonstrating disease in fossil colonies is challenging, there is no reason to believe that corals did not experience diseases back in the Cretaceous. This paper gives an example of the potential of coral anomalies originating from tissue lesions and skeletal damage to be preserved in the geological record, a factor that may have been often overlooked in the study of fossil coral communities. © 2024, Geologica Acta. All rights reserved.},
	author_keywords = {Aptian; Coral; Iberian Chain; Lesion; Skeletal anomaly},
	abbrev_source_title = {Geol. Acta},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Brunetti2024,
