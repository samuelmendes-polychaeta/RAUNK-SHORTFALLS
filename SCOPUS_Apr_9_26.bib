	source = {Scopus},
	note = {Cited by: 14}
}

@ARTICLE{Bosch2015155,
	author = {Bosch, Jennifer A. and Cornwell, Jeffrey C. and Kemp, W. Michael},
	title = {Short-term effects of nereid polychaete size and density on sediment inorganic nitrogen cycling under varying oxygen conditions},
	year = {2015},
	journal = {Marine Ecology Progress Series},
	volume = {524},
	pages = {155 - 169},
	doi = {10.3354/meps11185},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84926337418&doi=10.3354%2Fmeps11185&partnerID=40&md5=ad384fc2b95d3b4337ba1720bd209212},
	affiliations = {University of Maryland, Center for Environmental Science, Horn Point Laboratory, 2020 Horns Point Rd., Cambridge, 21613-0775, MD, United States},
	abstract = {Chronic eutrophication and expanding seasonal hypoxia (O<sub>2</sub> < 63 μM) in estuaries like Chesapeake Bay have altered benthic faunal communities in favor of opportunistic species that can quickly populate organic-rich sediments following hypoxic events. It has been suggested that the biogenic activity of polychaetes can stimulate microbial ammonification, nitrification, and/or denitrification in estuarine sediments as well as increase the fluxes of inorganic nitrogen (NH<sub>4</sub><sup>+</sup>, NO<sub>2</sub><sup>-</sup>, NO<sub>3</sub><sup>-</sup>, N<sub>2</sub>) across the sediment-water interface. Results of 2 laboratory experiments with the opportunistic polychaete Alitta (Neanthes) succinea were used to quantify the short-term influence of density and size of surface-feeding polychaetes on denitrification and sedimentwater fluxes of inorganic nitrogen under varying oxygen conditions. This study shows that polychaete enhancements of O<sub>2</sub> and nitrogen fluxes were strongly correlated with total animal biomass. Fluxes of O<sub>2</sub>, NH<sub>4</sub><sup>+</sup> and N<sub>2</sub> were stimulated by presence of animals for both larger and smaller worms, but per capita effects were greater for the deep-burrowing larger polychaetes. With the onset of hypoxic conditions, all density treatments had reductions in O<sub>2</sub>, NH<sub>4</sub><sup>+</sup> and N<sub>2</sub> fluxes, with the high-density treatment showing the greatest change. Denitrification efficiency was 33% higher for experiments with large worms than for smaller worm treatments, suggesting that the former were more effective in removing fixed nitrogen. © Inter-Research 2015, www.int-res.com.},
	author_keywords = {Alitta succinea; Bioirrigation; Denitrification; Hypoxia; Nitrogen cycling; Polychaetes; Sediment biogeochemistry},
	correspondence_address = {J.A. Bosch; University of Maryland, Center for Environmental Science, Horn Point Laboratory, Cambridge, 2020 Horns Point Rd., 21613-0775, United States; email: jbosch@umces.edu},
	abbrev_source_title = {Mar. Ecol. Prog. Ser.},
