@ARTICLE{Schleicherová2023,
	author = {Schleicherová, Dáša and Prearo, Marino and Santovito, Alfredo},
	title = {Influence of Nutritional Stress on Female Allocation and Somatic Growth in the Simultaneously Hermaphroditic Polychaete Worm Ophryotrocha diadema},
