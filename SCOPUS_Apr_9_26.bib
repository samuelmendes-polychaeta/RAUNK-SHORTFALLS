	title = {Earthworm Aporrectodea trapezoides had no effect on the dispersal of a vesicular-arbuscular mycorrhizal fungi, Glomus intraradices},
	year = {1997},
	journal = {Soil Biology and Biochemistry},
	volume = {29},
