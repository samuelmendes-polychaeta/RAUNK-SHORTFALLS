	note = {Cited by: 39}
}

@ARTICLE{Lehnert2022,
	author = {Lehnert, Matthew S. and Tarver, Lauren A. and Feng, Jiansheng},
	title = {Material Properties and Morphology of Prestomal Teeth in Relation to the Feeding Habits of Diptera (Brachycera)},
	year = {2022},
	journal = {Insects},
	volume = {13},
