	correspondence_address = {M. Kishida; Graduate School of Science and Technology, Kumamoto University, Kumamoto, 860-8555, Japan; email: mkishida@gpo.kumamoto-u.ac.jp; S.-Y. Hu; Department of Biological Science and Technology, National Pingtung University of Science and Technology, Pingtung 912, Taiwan; email: syhu@mail.npust.edu.tw},
	abbrev_source_title = {Toxics},
