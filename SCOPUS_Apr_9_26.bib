	doi = {10.1007/s41208-025-01012-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024108029&doi=10.1007%2Fs41208-025-01012-0&partnerID=40&md5=49bbd3dbc9320cce85dfc2ab0eba07f5},
	affiliations = {Department of Biological Oceanography, Nigerian Institute for Oceanography and Marine Research, Victoria Island, P.M.B. 12729, Lagos, Nigeria},
	abstract = {This study aimed to assess the ecological quality status of the East Mole Lagos shoreline and harbour by utilising meiofauna and nematodes as indicators of environmental disturbances. Samples, including sediment and water, were collected from four stations along the East Mole of Lagos shoreline, Nigeria, between June and December 2024. Meiofauna samples from the sediment were collected using a Van Veen grab with an area of 0.1 m² and extracted according to standard protocols. Bottom water samples were collected and analysed for temperature, dissolved oxygen, pH, conductivity, salinity, and total dissolved solids utilising the Horiba U 50 series. Twenty-six taxa across nine phyla were identified. Nematodes exhibited the highest relative abundance and density at 26. 7% and 41.7 ind m<sup>− 2</sup>, while Kinorhyncha had the least observed values, at 1.1% and 1.17 ind m<sup>− 2</sup>, respectively. The relative abundance of meiofauna assemblages decreased in the order of Nematoda > Arthropoda > Brachiopoda > Tardigrada > Foraminifera > Annelida > Mollusca > Phoronida > Kinorhyncha. The maturity index (MI) had a mean value of 2. 82, and the percentage of colonizers- persisters (c- p) of c- p 2 was 57% (≥ 50%) and c- p 4 at 43% (> 10%), indicating a slightly disturbed environment. The categories of c-p2 and c-p4 exhibited high tolerance and sensitivity to environmental disturbances. The nematode feeding types were non-selective deposit feeders (1B: 48%), Epistrate feeders (2 A: 22%), and omnivores/predators (2B: 30%). The AZTI’s Marine Biotic Index (AMBI) revealed a range of undisturbed (station 2) and slightly disturbed environments (stations 1, 3, and 4). The grain size varied from very fine sand at 0.09% to coarse sand at 66.34%. Tardigrada, Arthropoda, Nematoda, and Annelida exhibited significant correlations with particle size (very fine sand), while salinity correlated with Phoronida and Foraminifera. Meiofaunal and nematode assemblages serve as significant ecological indicators of environmental disturbances, suggesting that the ecological quality status of the East Mole Lagos shoreline is relatively stable to slightly disturbed. © The Author(s), under exclusive licence to Springer Nature Switzerland AG 2025.},
	author_keywords = {Marine environment; Maturity indices; Meiofauna; Nematodes; Shoreline},
