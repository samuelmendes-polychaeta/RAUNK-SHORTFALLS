@ARTICLE{Ibrahim2023,
	author = {Ibrahim, Nur Fazne and Hamid, Muzzalifah Abd and Akhir, Mohd Fadzil Mohd and Ong, Meng Chuan and Talaat, Wan Izatul Asma Wan and Idris, Izwandy},
	title = {Seasonal benthic species composition linked to coastal defense structures (CDS) in Kuala Nerus, Terengganu, Malaysia},
