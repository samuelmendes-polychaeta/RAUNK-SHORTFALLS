@ARTICLE{Miloslavich2013,
	author = {Miloslavich, Patricia and Cruz-Motta, Juan José and Klein, Eduardo and Iken, Katrin and Weinberger, Vanessa and Konar, Brenda and Trott, Tom and Pohle, Gerhard and Bigatti, Gregorio and Benedetti-Cecchi, Lisandro and Shirayama, Yoshihisa and Mead, Angela and Palomo, Gabriela and Ortiz, Manuel and Gobin, Judith and Sardi, Adriana and Díaz, Juan Manuel and Knowlton, Ann and Wong, Melisa and Peralta, Ana C.},
	title = {Large-Scale Spatial Distribution Patterns of Gastropod Assemblages in Rocky Shores},
