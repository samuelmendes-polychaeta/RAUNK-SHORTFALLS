	note = {Cited by: 9; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Yeoh20171214,
	author = {Yeoh, D.E. and Valesini, F.J. and Hallett, C.S. and Abdo, D.A. and Williams, J.},
	title = {Diel shifts in the structure and function of nearshore estuarine fish communities},
	year = {2017},
	journal = {Journal of Fish Biology},
	volume = {90},
	number = {4},
	pages = {1214 - 1243},
	doi = {10.1111/jfb.13222},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85005949956&doi=10.1111%2Fjfb.13222&partnerID=40&md5=267a8b69fd0bd65c1bfd5a51a189bf60},
	affiliations = {Centre for Fish and Fisheries Research, School of Veterinary and Life Sciences, Murdoch University, 90 South Street, Murdoch, 6150, WA, Australia; Aquaculture and Aquatic Biosecurity Branch, Department of Fisheries, Government of Western Australia, P. O. Box 20, North Beach, 6920, WA, Australia},
	abstract = {Day–night shifts in the nearshore fish fauna of a temperate microtidal estuary were assessed using a holistic suite of structural and functional community attributes. Mean fish species richness and diversity (taxonomic distinctness) were higher at night across all regions of the estuary and seasons, concurring with the findings of numerous comparable studies reviewed worldwide, while the diel period in which mean abundance was higher varied among seasons. Likewise, species and functional guild compositions (the latter based on feeding modes and habitat use) both differed significantly between day and night, with the extent of the diel shift again varying seasonally. Daytime fish communities were characterized by higher abundances of Atherinidae, Sillaginidae and Mugilidae, while Gobiidae were far more abundant at night. Marked shifts in size composition were also evident, with smaller fishes (<100 mm total length, L<sub>T</sub>) being more prevalent during the day and larger fishes (≥200 mm L<sub>T</sub>) proportionally more abundant at night. The above diel shifts were feasibly related to a range of predator–prey interactions and feeding-related movements, namely a nocturnal decrease in top-order avian piscivory coupled with an increase in invertebrate prey availability, resulting in changes in the presence and catchability of certain fish species in shallow estuarine waters. © 2016 The Fisheries Society of the British Isles},
	author_keywords = {day–night variation; diurnal; estuary; guild; nocturnal; size},
	correspondence_address = {D.E. Yeoh; Centre for Fish and Fisheries Research, School of Veterinary and Life Sciences, Murdoch University, Murdoch, 90 South Street, 6150, Australia; email: d.yeoh@murdoch.edu.au},
