@ARTICLE{McCurdy20001137,
	author = {McCurdy, D.G. and Boates, J.S. and Forbes, M.R.},
	title = {Spatial distribution of the intertidal snail Ilyanassa obsoleta in relation to parasitism by two species of trematodes},
	year = {2000},
	journal = {Canadian Journal of Zoology},
	volume = {78},
	number = {7},
	pages = {1137 - 1143},
	doi = {10.1139/cjz-78-7-1137},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0033830507&doi=10.1139%2Fcjz-78-7-1137&partnerID=40&md5=afa458d4f0f785f5af6b78a2eef510f4},
	affiliations = {Department of Biology, 2240 Herzberg Laboratories, Carleton University, Ottawa, Ont. K1S 5B6, 1125 Colonel By Drive, Canada},
	abstract = {We studied the spatial distributions of mud snails (Ilyanassa obsoleta) infected by two trematodes, Lepocreadium setiferoides and Gynaecotyla adunca, on a macrotidal mudflat in the Minas Basin, Bay of Fundy. Snails, as first intermediate hosts, were castrated by both parasites, and we found no evidence of sex differences in parasitism. Similar to previous work, prevalence of L. setiferoides in I. obsoleta increased exponentially with host size (and age). Unexpectedly, prevalence of G. adunca decreased over the largest size classes of snails, a result that may be due to several causes. Distributions of both parasites across the intertidal zone differed from previous accounts in that snails infected with L. setiferoides were found only in the middle of the intertidal zone, whereas prevalence of G. adunca increased exponentially moving seaward. Several species of polychaetes could be infected by L. setiferoides in the laboratory and may act as appropriate second intermediate hosts, whereas only the amphipod Corophium volutator served as a second intermediate host for G. adunca. Finally, the vertical distributions of I. obsoleta infected by either species of trematode overlap with distributions of apparent or known second intermediate hosts.},
	correspondence_address = {D.G. McCurdy; Department of Biology, 2240 Herzberg Laboratories, Carleton University, Ottawa, Ont. K1S 5B6, 1125 Colonel By Drive, Canada; email: dmccurdy@ccs.carleton.ca},
	abbrev_source_title = {Can. J. Zool.},
