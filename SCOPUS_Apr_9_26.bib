	author = {Ducrot, Virginie and Péry, Alexandre R.R. and Mons, Raphaël and Quéau, Hervé and Charles, Sandrine and Garric, Jeanne},
	title = {Dynamic energy budget as a basis to model population-level effects of zinc-spiked sediments in the gastropod Valvata piscinalis},
	year = {2007},
	journal = {Environmental Toxicology and Chemistry},
	volume = {26},
	number = {8},
	pages = {1774 - 1783},
	doi = {10.1897/06-556R.1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-34547926872&doi=10.1897%2F06-556R.1&partnerID=40&md5=2f2742f560fcf18b3f9b9207f9873c8e},
	affiliations = {Laboratoire d'Écotoxicologie, Cemagref, F-69336 Lyon Cedex 09, 3bis quai Chauveau, CP 220, France; INRA, Agrocampus Rennes, Équipe Écotoxicologie et Qualité des Milieux Aquatiques, F-35042 Rennes, 65 rue de Saint Brieuc, France; Laboratoire de Biométrie et Biologie Evolutive (UMR 5558), CNRS, Université Lyon 1, F-69622, Villeurbanne Cedex, 43 bd 11 novembre, France},
	abstract = {This paper presents original toxicity test designs and mathematical models that may be used to assess the deleterious effects of toxicants on Valvata piscinalls (Mollusca, Gastropoda). Results obtained for zinc, used as a reference toxicant, are presented. The feeding behavior, juvenile survival, growth, age at puberty, onset of reproduction, number of breedings during the life cycle, and fecundity were significantly altered when the snails were exposed to zinc-spiked sediments. Dynamic energy budget models (DEBtox) adequately predicted the effects of zinc on the V. piscinalis life cycle. They also provided estimates for life-cycle parameters that were used to parameterize a demographic model, based on a Z-transformed life-cycle graph. The effect threshold for the population growth rate (λ) was estimated at 259 mg/kg dry sediment of zinc, showing that significant changes in abundance may occur at environmental concentrations. Significant effects occurring just above this threshold value were mainly caused by the severe impairment of reproductive endpoints. Sensitivity analysis showed that the value of λ depended mainly on the juvenile survival rate. The impairment of this latter parameter may result in extinction of V. piscinalis. Finally, the present study highlights advantages of the proposed modeling approach in V. piscinalis and possible transfer to other test species and contaminants. © 2007 SETAC.},
	author_keywords = {Bioenergetics; Demographic models; Life-history traits; Metal-contaminated sediments; No-observed-effect concentration},
	correspondence_address = {V. Ducrot; Laboratoire d'Écotoxicologie, Cemagref, F-69336 Lyon Cedex 09, 3bis quai Chauveau, CP 220, France; email: virginie.ducrot@rennes.inra.fr},
