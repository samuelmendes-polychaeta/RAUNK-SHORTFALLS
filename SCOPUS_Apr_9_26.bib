@ARTICLE{Vaikre2018957,
	author = {Vaikre, Maarja and Remm, Liina and Rannap, Riinu and Voode, Margus},
	title = {Functional Assemblages of Macroinvertebrates in Pools and Ditches in Drained Forest Landscape},
	year = {2018},
