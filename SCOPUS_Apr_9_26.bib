	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105026680877&doi=10.1134%2FS1062359025611450&partnerID=40&md5=2a7773bb13ade1849e82eb5aff403585},
	affiliations = {Omsk State Pedagogical University, Omsk, 644099, Russian Federation; Dostoevsky Omsk State University, Omsk, 644077, Russian Federation; Institute of Cytology and Genetics, Siberian Branch of the Russian Academy of Sciences, Novosibirsk, Russian Federation; Institute of the Biological Problems of the North, Far East Branch of the Russian Academy of Sciences, Magadan, Russian Federation; Vitebsk State University named after P.M. Masherov, Vitebsk, Belarus},
	abstract = {Abstract: We investigated the impact of various factors on the size and mass of eleven earthworm taxa, abundant in southern part of West Siberia. Earthworms were collected during in 2022 and 2023 in the West Siberian Plain, Gorny Altai, and Rudny Altai (Kazakhstan). We analyzed 1053 individuals from 256 samples at 24 test sites. To account for the impact of physical-geographical factors on body size, sampling sites were established in mountain, lowland, and intrazonal landscapes, across various natural zones and habitats. To account for edaphic factors, layered measurements of soil density, pH, electrical conductivity, temperature, moisture, and organic matter were performed in all soil samples. Variance analysis showed that body mass is influenced by gut cleansing and fixation type. Smaller taxa demonstrate more pronounced mass decrease after gut cleansing. Worms stretched when fixed in formalin and contracted in alcohol. The coefficients of length and width change after fixation significantly depended on earthworm species and the total length, except for width change during alcohol fixation. European invasive species were observed to be 1.1–3.3 times shorter in southern Western Siberia compared to Belarus. The key physico-geographical factors influencing earthworm size and mass were “habitat depth,” “habitat type,” “natural zone,” and “landscape.” The key edaphic factors influencing earthworm size and mass were “soil organic matter” and “soil temperature.” © Pleiades Publishing, Inc. 2025.},
	author_keywords = {earthworms; Lumbricidae, edaphic factors, physico-geographical factors, fixation type},
