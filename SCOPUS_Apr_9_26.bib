	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-0027955003&doi=10.1016%2F0925-4773%2894%2990050-7&partnerID=40&md5=997d011000b3007d3002689a59b46ca2},
	affiliations = {MRC Brain Development Programme, Division of Anatomy and Cell Biology, U.M.D.S. Guy's and St. Thomas's Hospitals, London, SE1 9RT, Guy's Campus, United Kingdom; United Kingdom},
	abstract = {We have isolated cDNA and genomic clones for the murine FGF-7 gene and examined its expression throughout development. Transcripts were transiently detected in the developing myocardium, differentially regulated between the atrium and ventricle. The gene was also expressed in the myotomes of the somites, coincident with FGF-4 and FGF-5 transcripts, and was detected transiently in cleaved muscles. Regional expression was detected in the ventricular zone of the developing forebrain at 14.5 d.p.c. Later in development, FGF-7 RNA was detected in mesenchymal tissues suggesting a role in epithelial-mesenchymal interactions and in the dermis consistent with its proposed role as a keratinocyte mitogen. Our results suggest that FGF-7 is likely to have diverse roles during development. © 1994.},
