@ARTICLE{Edwards20252985,
	author = {Edwards, Lukas H. A. and Smallegange, Isabel M.},
	title = {The role of developmental plasticity in eco-phenotypic population dynamics},
	year = {2025},
	journal = {Functional Ecology},
	volume = {39},
	number = {11},
	pages = {2985 - 2998},
	doi = {10.1111/1365-2435.70050},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005177633&doi=10.1111%2F1365-2435.70050&partnerID=40&md5=282d91017eeda6e59c5780a7cf92556d},
	affiliations = {School of Natural and Environmental Sciences, Newcastle University, Newcastle upon Tyne, United Kingdom},
	abstract = {Individual variation in development can strongly impact population density via its impact on demography. When this variation in development is caused by developmental plasticity, the resulting effects on population density are characterised as ‘eco-phenotypic dynamics’ If plasticity in turn is sensitive to variation in population density, ‘eco-phenotypic feedbacks’ can arise. When individual development is density-dependent due to resource limitation, we expect eco-phenotypic feedbacks between development rate and population density to be widespread. Yet, exactly how plasticity in development rates, termed ‘heterokairy’ interacts with population density to influence eco-phenotypic dynamics is unclear. Here, we provide conceptual and empirical starting points to assess the role of heterokairy in eco-phenotypic population dynamics. We present a conceptual framework to identify how heterokairy impacts, and is impacted by, population density. This framework is validated using existing empirical evidence, focusing on polyphenisms that comprise alternate phenotypes that differ in development rate: ‘heterokairic polyphenisms’. We find that heterokairic polyphenisms typically comprise fast developing (‘minor’) and slow developing (‘major’) phenotypes that are prevalent among ectotherms. How heterokairy shapes eco-phenotypic feedbacks depends on whether minors (or majors) are mostly expressed at low (or high) density, or vice versa. Minor-at-low-density systems, such as those found in salamanders, aphids and nematodes, reflect classic life history predictions that growing, low density, populations favour short development times, whilst high-density populations favour slower development. Alternatively, minor-at-high-density systems allow resource-stressed juveniles, most common at high-densities, to still mature but as minors by reducing developmental and metabolic costs. We propose such opposing responses to density can prompt different eco-phenotypic dynamics and feedbacks. Our work highlights the crucial role that development plays in phenotype construction, and the consequences it can have for (meta)population dynamics and phenotype evolution. We call for a shift away from a focus on developmental outcomes in adulthood to the developmental processes that construct phenotypes. Ultimately, this can lead to a more mechanistic, and thus predictive, approach to understanding the adaptive role of alternative paces of development within ecological and evolutionary contexts. Read the free Plain Language Summary for this article on the Journal blog. © 2025 The Author(s). Functional Ecology published by John Wiley & Sons Ltd on behalf of British Ecological Society.},
	author_keywords = {allometric plasticity; alternative phenotypes; density-dependent selection; eco-evolutionary dynamics; pace-of-life syndrome; paedomorphosis; phenotypic plasticity; population dynamics},
	correspondence_address = {L.H.A. Edwards; School of Natural and Environmental Sciences, Newcastle University, Newcastle upon Tyne, United Kingdom; email: l.edwards7@newcastle.ac.uk},
	abbrev_source_title = {Funct. Ecol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access}
}

@ARTICLE{Leite Jardim2025,
	author = {Leite Jardim, Victor and Boyé, Aurélien and Le Garrec, Vincent and Maguer, Marion and Tauran, Adeline and Gauthier, Olivier and Grall, Jacques},
	title = {Habitat complexity promotes species richness and community stability: a case study in a marine biogenic habitat},
	year = {2025},
	journal = {Oikos},
	volume = {2025},
	number = {7},
	pages = {},
	doi = {10.1111/oik.10675},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000540454&doi=10.1111%2Foik.10675&partnerID=40&md5=422f240e8192794f2ffb16d395488419},
	affiliations = {Univ Brest, CNRS, IRD, Ifremer, LEMAR, IUEM, Plouzane, France; Ifremer, Centre de Bretagne, DYNECO, Laboratory of Coastal Benthic Ecology, Plouzané, France; Univ Brest, CNRS, IRD, OSU IUEM, Plouzané, France},
	abstract = {Habitat complexity (HC) promotes species richness and abundance. Aquatic environments are faced with intense pressures that threaten the 3D structure of the seafloor, with cascading effects on ecosystem functioning and biodiversity. Maerl or rhodolith beds are marine biogenic habitats created by few species of free-living non-geniculate coralline algae that aggregate and form complex structures. Although their high biodiversity has been attributed to the HC provided by coralline algal nodules, the mechanisms through which HC modification affect associated communities remains uncertain in face of numerous confounding factors. Hence, we tested how changes in the extent and nature of maerl complexity drive changes in biodiversity. Using long-term monitoring data from ten maerl beds in Brittany (France) over 12 years, we investigated the links between structural complexity, environmental conditions and benthic macrofaunal communities. HC was quantified at the coralline algal nodule and bed level, through morphometrics and density, and its effects on local diversity and on communities spatial and temporal variability were evaluated. HC promoted species richness and density of most taxa regardless of other environmental factors. These relationships were linear and no limiting threshold of complexity was found at a regional scale. HC played a more important role in driving regional diversity patterns than other measured environmental constraints individually, and beds with relatively lower HC were the most distinct in terms of community composition and structure. Species replacement was the main component of temporal variability and HC promoted community stability. While overall facilitative, the effects of HC might be taxa and trait-dependent, justifying comprehensive trait-based approaches. Our results reiterate the need to protect complex biogenic habitats. © 2025 The Author(s). Oikos published by John Wiley & Sons Ltd on behalf of Nordic Society Oikos.},
	author_keywords = {complexity–diversity relationships; foundation species; habitat diversity; maerl; rhodolith; structural complexity},
	correspondence_address = {V. Leite Jardim; Univ Brest, CNRS, IRD, Ifremer, LEMAR, IUEM, Plouzane, France; email: victor.leitejardim@univ-brest.fr},
	abbrev_source_title = {Oikos},
	type = {Article},
