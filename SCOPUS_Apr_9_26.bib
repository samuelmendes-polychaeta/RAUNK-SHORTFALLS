	year = {2026},
	journal = {Marine Pollution Bulletin},
	volume = {222},
	pages = {},
	doi = {10.1016/j.marpolbul.2025.118896},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021086935&doi=10.1016%2Fj.marpolbul.2025.118896&partnerID=40&md5=4e709973a91237fbd59f002d166152ee},
	affiliations = {The University of New South Wales, School of Biological, Earth and Environmental Sciences, Kensington, 2052, NSW, Australia; School of Life and Environmental Sciences, The University of Sydney, Camperdown, 2006, NSW, Australia; NSW Department of Primary Industries and Regional Development, Port Stephens Fisheries Institute, Taylors Beach, 2316, NSW, Australia; School of Aquatic & Fishery Sciences, University of Washington, Seattle, 98195, WA, United States; The Swire Institute of Marine Science and School of Biological Sciences, The University of Hong Kong, Hong Kong; Hong Kong Oyster Hatchery & Innovation Research Unit, The University of Hong Kong, Hong Kong},
	abstract = {Ocean warming and marine heatwaves are expected to significantly affect marine species' physiology, compromising species survival. Yet, the degree of acclimation through transgenerational plasticity (TGP) is unknown, particularly early life stages (larvae) of ecologically and aquaculturally important species such as oysters. Here, we assess the TGP response to elevated temperatures in larvae from two genetically distinct families of Sydney rock oyster,  Saccostrea glomerata . Adults were exposed to control (24 °C) and warm (28 °C) for ∼8 weeks during reproductive conditioning. Subsequently, within-family crosses were made and percentage development, abnormality, shell size and LT50 of larvae were measured after 48 h exposure to temperatures ranging 24.3–36.0 °C. Overall, larvae from warm parents had greater development, lower abnormality, but were smaller at higher temperatures compared to those from control parents. Furthermore, parental exposure to warming increased LT50 of larvae by approximately 2.0 °C in one family. Our findings suggest that TGP may provide  S. glomerata  larvae with resilience against warming and may provide buffer time for them to adapt. © 2025 The Authors.},
	author_keywords = {Ocean warming; Oyster larvae; Saccostrea glomerata; Thermal tolerance; Transgenerational plasticity},
	correspondence_address = {P.M. Ross; School of Life and Environmental Sciences, The University of Sydney, Camperdown, 2006, Australia; email: pauline.ross@sydney.edu.au},
