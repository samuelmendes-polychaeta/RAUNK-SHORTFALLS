	title = {Habitat preferences and trophic interactions of the benthic invertebrate communities inhabiting depositional and erosional banks of a meander from Danube Delta (Romania)},
	year = {2022},
	journal = {Global Ecology and Conservation},
	volume = {38},
	pages = {},
