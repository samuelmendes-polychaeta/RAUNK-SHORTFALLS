	title = {Bioturbation of peanut worms Sipunculus nudus on the composition of prokaryotic communities in a tidal flat as revealed by 16S rRNA gene sequences},
	year = {2019},
	journal = {MicrobiologyOpen},
	volume = {8},
	number = {8},
