	correspondence_address = {J.-P. Pezy; Normandie Univ, UNICAEN, UNIROUEN, Laboratoire Morphodynamique Continentale et Côtière, CNRS UMR 6143 M2C, 24 rue des Tilleuls, 14000, France; email: jean-philippe.pezy@unicaen.fr},
