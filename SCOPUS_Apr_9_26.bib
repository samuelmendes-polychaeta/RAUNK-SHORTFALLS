@ARTICLE{Weiland-Bräuer20201,
	author = {Weiland-Bräuer, Nancy and Pinnow, Nicole and Langfeldt, Daniela and Roik, Anna and Güllert, Simon and Chibani, Cynthia M. and Reusch, Thorsten B. H. and Schmitz, Ruth A.},
	title = {The native microbiome is crucial for offspring generation and fitness of aurelia aurita},
