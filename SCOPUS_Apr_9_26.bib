	affiliations = {Programa de Pós-Graduação em Biodiversidade e Conservação da Natureza, Laboratório de Invertebrados Bentônicos, Instituto de Ciências Biológicas, Universidade Federal de Juiz de Fora, Juiz de Fora, Brazil; Departamento de Genética, Ecologia e Evolução, Instituto de Ciências Biológicas, Universidade Federal de Minas Gerais, Belo Horizonte, Brazil; Departamento de Ecologia e Conservação, Instituto de Ciências Naturais, Universidade Federal de Lavras, Lavras, Brazil; Departamento de Zoologia, Laboratório de Invertebrados Bentônicos, Instituto de Ciências Biológicas, Universidade Federal de Juiz de Fora, Juiz de Fora, Brazil},
	abstract = {The replacement of native vegetation with monoculture eucalyptus plantations and the growing demand for water are strongly threatening the springs and, consequently, the fauna present. The aim of this study was to analyze the effect of eucalyptus plantations on the taxonomic and functional structure of aquatic oligochaete assemblages in Neotropical springs, assessing if (1) the taxonomic and functional diversities of aquatic oligochaetes are related to each other and (2) the replacement of vegetation cover by eucalyptus monoculture alters the composition and functional parameters of aquatic oligochaetes. The study was conducted in 20 springs located on private properties where eucalyptus forestry is predominant, in the Paraíba do Sul River sub-basin, Brazil. A positive relationship was found between taxonomic and functional parameters. PERMANOVA found that springs located in forested areas had a different taxonomic composition of oligochaetes compared to springs in eucalyptus areas, and all generalized linear models (GLM) pointed to the area as significant. Our results help to understand the influence of eucalyptus monoculture on the taxonomic and functional structure of oligochaetes. © The Author(s), under exclusive licence to Springer Nature Switzerland AG 2024.},
