@ARTICLE{Fortunato20161925,
	author = {Fortunato, Caroline S. and Huber, Julie A.},
	title = {Coupled RNA-SIP and metatranscriptomics of active chemolithoautotrophic communities at a deep-sea hydrothermal vent},
	year = {2016},
	journal = {ISME Journal},
	volume = {10},
