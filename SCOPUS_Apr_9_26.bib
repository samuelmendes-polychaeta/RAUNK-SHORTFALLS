@ARTICLE{Ferrer201217977,
	author = {Ferrer, Camilo and Malagón, Gerardo and Gomez, María del Pilar and Nasi, Enrico},
	title = {Dissecting the determinants of light sensitivity in amphioxus microvillar photoreceptors: Possible evolutionary implications for melanopsin signaling},
	year = {2012},
	journal = {Journal of Neuroscience},
	volume = {32},
	number = {50},
