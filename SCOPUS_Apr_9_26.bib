@ARTICLE{Quiroga Artigas2018,
	author = {Quiroga Artigas, Gonzalo and Lapébie, Pascal and Leclère, Lucas and Takeda, Noriyo and Deguchi, Ryusaku and Jékely, Gáspár and Momose, Tsuyoshi and Houliston, Evelyn},
	title = {A gonad-expressed opsin mediates light-induced spawning in the jellyfish clytia},
	year = {2018},
