	author = {Bernard, Guillaume and Kauppi, Laura and Lavesque, Nicolas and Ciutat, Aurélie and Grémare, Antoine and Massé, Cécile and Maire, Olivier},
	title = {An invasive mussel (Arcuatula senhousia, benson 1842) interacts with resident biota in controlling benthic ecosystem functioning},
