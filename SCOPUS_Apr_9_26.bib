	affiliations = {Emergency Response Division, National Oceanic and Atmospheric Administration (NOAA), 7600 Sand Point Way NE, Seattle, 98115, WA, United States; Department of Biological Sciences, California State University, Long Beach, CA, United States; VA, United States; Exponent, Inc, Sedona, AZ, United States; Aquatic Toxicology Support, Bremerton, WA, United States; Industrial Economics, Inc, Cambridge, MA, United States; Office of the Admnistrator, NOAA, Washington, DC, United States},
