@ARTICLE{Ge2023278,
	author = {Ge, Xinyu and Peng, Lang and Vogler, Alfried P. and Morse, John C. and Yang, Lianfang and Sun, Changhai and Wang, Beixin},
	title = {Massive gene rearrangements of mitochondrial genomes and implications for the phylogeny of Trichoptera (Insecta)},
	year = {2023},
