@ARTICLE{Groenendijk19991225,
	author = {Groenendijk, Dick and Kraak, Michiel H. S. and Admiraal, Wim},
	title = {Efficient shedding of accumulated metals during metamorphosis in metal- adapted populations of the midge Chironomus riparius},
	year = {1999},
