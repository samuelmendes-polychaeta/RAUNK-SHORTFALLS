@ARTICLE{Ravelo2020,
	author = {Ravelo, Alexandra M and Bluhm, Bodil A. and Foster, Nora and Iken, Katrin},
	title = {Biogeography of epibenthic assemblages in the central Beaufort Sea},
	year = {2020},
	journal = {Marine Biodiversity},
	volume = {50},
