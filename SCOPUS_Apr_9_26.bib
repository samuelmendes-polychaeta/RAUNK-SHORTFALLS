	author = {Kazmi, Syed Shabi Ul Hassan and Wang, Yolina Yu Lin and Cai, Yan-Er and Wang, Zhen},
	title = {Temperature effects in single or combined with chemicals to the aquatic organisms: An overview of thermo-chemical stress},
	year = {2022},
	journal = {Ecological Indicators},
