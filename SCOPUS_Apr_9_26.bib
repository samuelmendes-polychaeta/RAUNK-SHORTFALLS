@ARTICLE{Lane20131983,
	author = {Lane, Ackley C. and Mukherjee, Joy and Chan, Vera B.S. and Thiyagarajan, Vengatesen},
	title = {Decreased pH does not alter metamorphosis but compromises juvenile calcification of the tube worm Hydroides elegans},
	year = {2013},
	journal = {Marine Biology},
	volume = {160},
