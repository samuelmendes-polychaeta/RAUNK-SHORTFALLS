@ARTICLE{Boehm201623,
	author = {Boehm, Frederike Ricarda and Sandrini-Neto, Leonardo and Moens, Tom and da Cunha Lana, Paulo},
	title = {Sewage input reduces the consumption of Rhizophora mangle propagules by crabs in a subtropical mangrove system},
	year = {2016},
	journal = {Marine Environmental Research},
