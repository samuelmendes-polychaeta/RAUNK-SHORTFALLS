	note = {Cited by: 6; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Segovia2025668,
	author = {Segovia, Leandro N. and Garello, Nicolás A. and Saigo, Miguel and Blettler, Martín C.M. and Grismado, Cristian J. and Rodrigues, Stephane},
	title = {How spider diversity and traits interact with environmental variables in riparian sandy bars},
	year = {2025},
	journal = {Ecohydrology and Hydrobiology},
	volume = {25},
	number = {3},
	pages = {668 - 681},
	doi = {10.1016/j.ecohyd.2024.11.001},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209245065&doi=10.1016%2Fj.ecohyd.2024.11.001&partnerID=40&md5=e17f4b48c8bd935ac7163426a7e2020f},
	affiliations = {The National Institute of Limnology (INALI; CONICET-UNL), Ciudad Universitaria (3000), Santa Fe, Argentina; División Aracnología, Museo Argentino de Ciencias Naturales "Bernardino Rivadavia", Av. Ángel Gallardo 470, Aires, C1405DJR, Argentina; CNRS UMR 7324 CITERES and Graduate School of Engineering Polytech Tours, University of Tours, France},
	abstract = {Spider ecology and functional traits were analysed within side bars (SB) of the middle Paraná River, investigating their relationship with environmental variables. Pitfall traps were utilized to capture spiders during four seasonal surveys spanning the years 2018 to 2019 on three SB, characterized by varying hydrological conditions. These surveys were conducted across three pre-defined zones: Wet Zone (WZ), Temporally Exposed Zone (TEZ), and Permanently Dry Zone (PDZ). The three zones were significantly differentiated according to sedimentological variables, vegetation cover, humidity, and soil organic matter (SOM). A total of 732 spiders were collected, representing 21 families and 49 species. Lycosidae and Linyphiidae were notably dominant. The species Sphecozone ignigena, Glenognatha lacteovittata, and Agalenocosa grismadoi were the most abundant. The PDZ was the most diverse zone in terms of guilds (8), species (spp) and morphospecies (msp) (34), families (18) and total abundance (295), in addition to exhibiting the greatest vegetation cover. Analysis of beta diversity of species during the rising limb of water flow revealed that replacement exceeded nesting levels in all seasons studied, indicating that most of the beta diversity was attributable to replacement. Furthermore, specific associations were observed within spider guilds. This study was a pioneer in exclusively examining the spider communities on the banks of the second longest river in South America and analysing how their ecology and functional traits behave under different environmental variables. © 2024 European Regional Centre for Ecohydrology of the Polish Academy of Sciences},
	author_keywords = {Araneae; Ballooning; Flood; Functional traits; Large river; Side bar},
	correspondence_address = {N.A. Garello; The National Institute of Limnology (INALI; CONICET-UNL), Ciudad Universitaria (3000), Santa Fe, Argentina; email: nicolas.garello@conicet.gov.ar},
	abbrev_source_title = {Ecohydrol. Hydrobiol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Green Open Access}
}

@ARTICLE{Kanhai2025,
	author = {Kanhai, Attish and Juman, Rahanna},
	title = {Seagrass loss decreases abundance, diversity and changes composition of macrobenthic infauna in a Caribbean Bay},
	year = {2025},
	journal = {Marine Biodiversity},
	volume = {55},
	number = {1},
	pages = {},
	doi = {10.1007/s12526-025-01499-z},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218182150&doi=10.1007%2Fs12526-025-01499-z&partnerID=40&md5=02687129cff376bd7a3d1528df9abb4e},
	affiliations = {Institute of Marine Affairs, Hilltop Lane, Chaguaramas, Trinidad and Tobago},
	abstract = {Seagrass meadows form complex ecosystems in the coastal zone that are highly productive and sustain an abundant faunal community. This study compared the macrobenthic infaunal communities in William’s Bay, Trinidad before and after a lush seagrass meadow dominated by Thalassia testudinum (Banks ex König) was extirpated. In 2007, T. testudinum aerial productivity was estimated at 2.68 ± 0.81 gm<sup>−2</sup> d<sup>−1</sup> and total biomass was 357.8 ± 224.8 gm<sup>−2</sup>, but by 2016 the bed had collapsed with zero productivity and biomass. To assess the macrobenthic infauna, five replicate cores were taken at six stations in 2007 and in 2016. Species richness, abundance and biomass all decreased from 2007 to 2016 as seagrass meadows were lost. This is likely due to fewer microhabitats and less protection from predators provided by seagrass cover. Relative abundance of the main species groups remained unchanged; polychaetes accounted for 48% of the species in 2007 and 2016, amphipods accounted for 17% in both years, decapods for 12% and 15% in 2007 and 2016 respectively, non-segmented worms for 11% (2007) and 6% (2016), molluscs for 2% (2007) and 13% (2016), echinoderms for less than 1% and a small miscellaneous group for another 1%. Deposit-feeding polychaetes were dominant across both sampling periods while carnivorous polychaetes showed a notable decline. Epifaunal amphipods dominated across both periods compared to infaunal tube-dwellers. © The Author(s), under exclusive licence to Senckenberg Gesellschaft für Naturforschung 2025.},
	author_keywords = {Amphipods; Benthic macrofauna; Polychaetes; Thalassia testudinum; Trinidad and Tobago},
	correspondence_address = {A. Kanhai; Institute of Marine Affairs, Chaguaramas, Hilltop Lane, Trinidad and Tobago; email: akanhai@ima.gov.tt},
	abbrev_source_title = {Mar. Biodiv.},
