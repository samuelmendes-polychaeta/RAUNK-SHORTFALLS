}

@ARTICLE{Salice2009785,
	author = {Salice, Christopher J. and Miller, Thomas J. and Roesijadi, G.},
	title = {Demographic responses to multigeneration cadmium exposure in two strains of the freshwater gastropod, biomphalaria glabrata},
	year = {2009},
	journal = {Archives of Environmental Contamination and Toxicology},
	volume = {56},
