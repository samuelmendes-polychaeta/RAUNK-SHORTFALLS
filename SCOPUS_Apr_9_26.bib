	correspondence_address = {X. Hua; Key Lab of Groundwater Resources and Environment of Ministry of Education, Key Lab of Water Resources and Aquatic Environment of Jilin Province, College of Environment and Resources, Jilin University, Changchun, 130012, China; email: huaxy@jlu.edu.cn},
	abbrev_source_title = {Environ. Sci. Pollut. Res.},
