	author = {dos Santos, Wagner Luiz and Pôrto, Kátia Cavalcanti and Pinheiro, Fábio},
	title = {An Overview of Reproductive Allocation and Reproductive Costs in Bryophytes: Challenges and Prospects},
	year = {2024},
	journal = {Botanical Review},
	volume = {90},
