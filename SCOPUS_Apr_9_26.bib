@ARTICLE{De Vlas1996105,
	author = {De Vlas, Sake J. and Bunskoeke, E.J. and Ens, Bruno J. and Hulscher, Jan B.},
	title = {Tidal changes in the choice of Nereis Diversicolor or Macoma Balthica as main prey species in the diet of the oystercatcher Haematopus Ostralegus},
