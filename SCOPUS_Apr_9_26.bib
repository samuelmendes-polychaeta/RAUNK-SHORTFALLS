@ARTICLE{Kraberg20117,
	author = {Kraberg, Alexandra C. and Wasmund, Norbert and Vanaverbeke, Jan and Schiedek, Doris and Wiltshire, Karen H. and Mieszkowska, Nova},
	title = {Regime shifts in the marine environment: The scientific basis and political context},
	year = {2011},
	journal = {Marine Pollution Bulletin},
	volume = {62},
