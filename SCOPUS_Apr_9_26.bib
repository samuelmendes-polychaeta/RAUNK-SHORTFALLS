	year = {2022},
	journal = {Frontiers in Microbiology},
	volume = {13},
	pages = {},
	doi = {10.3389/fmicb.2022.1042116},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85144056016&doi=10.3389%2Ffmicb.2022.1042116&partnerID=40&md5=7aa586c410bfa31f30d27a6b6febd53f},
	affiliations = {Laboratory of Marine Environmental Microbiology, Division of Applied Biosciences, Graduate School of Agriculture, Kyoto University, Kyoto, Japan; Institute for Extra-cutting-edge Science and Technology Avant-garde Research (X-star), Japan Agency for Marine-Earth Science and Technology (JAMSTEC), Yokosuka, Japan; General Affairs Department, Japan Agency for Marine-Earth Science and Technology (JAMSTEC), Yokosuka, Japan; Department of Marine and Earth Sciences, Marine Works Japan Ltd, Yokosuka, Japan; Section for Exploration of Life in Extreme Environments, Exploratory Research Center on Life and Living Systems (ExCELLS), National Institute of Natural Sciences, Okazaki, Japan},
	abstract = {In deep-sea hydrothermal environments, inorganic sulfur compounds are important energy substrates for sulfur-oxidizing, -reducing, and -disproportionating microorganisms. Among these, sulfur-disproportionating bacteria have been poorly understood in terms of ecophysiology and phylogenetic diversity. Here, we isolated and characterized a novel mesophilic, strictly chemolithoautotrophic, diazotrophic sulfur-disproportionating bacterium, designated strain GF1<sup>T</sup>, from a deep-sea hydrothermal vent chimney at the Suiyo Seamount in the Izu-Bonin Arc, Japan. Strain GF1<sup>T</sup> disproportionated elemental sulfur, thiosulfate, and tetrathionate in the presence of ferrihydrite. The isolate also grew by respiratory hydrogen oxidation coupled to sulfate reduction. Phylogenetic and physiological analyses support that strain GF1<sup>T</sup> represents the type strain of a new genus and species in the family Desulfobulbaceae, for which the name Desulfolithobacter dissulfuricans gen. nov. sp. nov. is proposed. Proteomic analysis revealed that proteins related to tetrathionate reductase were specifically and abundantly produced when grown via thiosulfate disproportionation. In addition, several proteins possibly involved in thiosulfate disproportionation, including those encoded by the YTD gene cluster, were also found. The overall findings pointed to a possible diversity of sulfur-disproportionating bacteria in hydrothermal systems and provided a refined picture of microbial sulfur disproportionation. Copyright © 2022 Hashimoto, Shimamura, Tame, Sawayama, Miyazaki, Takai and Nakagawa.},
	author_keywords = {chemolithoautotroph; comparative proteomic analysis; deep-sea hydrothermal vent; Deltaproteobacteria; Desulfobulbaceae; sulfur disproportionation},
	correspondence_address = {S. Nakagawa; Laboratory of Marine Environmental Microbiology, Division of Applied Biosciences, Graduate School of Agriculture, Kyoto University, Kyoto, Japan; email: nakagawa.satoshi.7u@kyoto-u.ac.jp},
	abbrev_source_title = {Front. Microbiol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 14; All Open Access; Gold Open Access; Green Open Access}
}

