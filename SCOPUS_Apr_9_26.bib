	abbrev_source_title = {Ecotoxicol. Environ. Saf.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 21; All Open Access; Green Open Access}
}

@ARTICLE{Rishworth2018,
	author = {Rishworth, Gavin M. and Perissinotto, Renzo and Bird, Matthew S. and Pelletier, Noémie},
	title = {Grazer responses to variable macroalgal resource conditions facilitate habitat structuring},
	year = {2018},
	journal = {Royal Society Open Science},
	volume = {5},
