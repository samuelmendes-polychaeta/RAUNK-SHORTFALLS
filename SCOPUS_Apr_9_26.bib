@ARTICLE{Forbes20101449,
	author = {Forbes, Valery E. and Olsen, Mette and Palmqvist, Annemette and Calow, Peter},
	title = {Environmentally sensitive life-cycle traits have low elasticity: Implications for theory and practice},
	year = {2010},
	journal = {Ecological Applications},
	volume = {20},
	number = {5},
	pages = {1449 - 1455},
	doi = {10.1890/09-1063.1},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-77954324970&doi=10.1890%2F09-1063.1&partnerID=40&md5=2c00980429ca858518d2ad65794afae7},
	affiliations = {Department of Environmental, Social and Spatial Change, Roskilde University, 4000 Roskilde, P.O. Box 260, Denmark},
	abstract = {The relationships between population growth rate and the life-cycle traits contributing to it are nonlinear and variable. This has made it difficult for ecologists to consistently predict changes in population dynamics from observations on changes in life-cycle traits. We show that traits having a high sensitivity to chemical toxicants tend to have a low elasticity, meaning that changes in them have a relatively low impact on population growth rate, compared to other life-cycle traits. This makes evolutionary sense in that there should be selection against variability in population growth rate. In particular, we found that fecundity was generally more sensitive to chemical stress than was juvenile or adult survival or time to first reproduction, whereas fecundity typically had a lower elasticity than the other life-cycle traits. Similar relationships have been recorded in field populations for a wide range of taxa, but the conclusions were necessarily more tentative because stochastic effects and confounding variables could not be excluded. Better knowledge of these relationships can be used to optimize population management and protection strategies and to increase understanding of the drivers of population dynamics. © 2010 by the Ecological Society of America.},
	author_keywords = {Chemical stress; Daphnia magna; Elasticity; Lowest observed effective concentration; Matrix population model; Population dynamics; Sensitivity},
	correspondence_address = {V. E. Forbes; Department of Environmental, Social and Spatial Change, Roskilde University, 4000 Roskilde, P.O. Box 260, Denmark; email: vforbes@ruc.dk},
	abbrev_source_title = {Ecol. Appl.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 42}
}

@ARTICLE{Høgslund2010110,
