	note = {Cited by: 1; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Gintowt2025,
	author = {Gintowt, Natalia Anna and Kendzierska, Halina and Janas, Urszula},
	title = {Seasonal Dynamics of Benthic Infauna Communities in Zostera marina Meadows: Effects of Plant Density Gradients},
	year = {2025},
	journal = {Biology},
