	source = {Scopus},
	note = {Cited by: 65}
}

@ARTICLE{Van Oers2005716,
	author = {Van Oers, Kees and Klunder, Margreet and Drent, Piet J.},
	title = {Context dependence of personalities: Risk-taking behavior in a social and a nonsocial situation},
	year = {2005},
	journal = {Behavioral Ecology},
	volume = {16},
