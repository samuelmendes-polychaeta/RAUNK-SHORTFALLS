@ARTICLE{Janson20121568,
	author = {Janson, Anne-Laure and Denis, Lionel and Rauch, Mathieu and Desroy, Nicolas},
	title = {Macrobenthic biodiversity and oxygen uptake in estuarine systems: The example of the Seine estuary},
