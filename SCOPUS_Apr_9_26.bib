@ARTICLE{Banaru2007167,
	author = {Banaru, Daniela and Harmelin-Vivien, Mireille},
	title = {Spatial and temporal variations of stable isotope (δ13C and δ15N) signatures of Danube waters and marine communities on the Black Sea Romanian coasts; [Variations spatio-temporelles de la signature en isotopes stables (δ13C et δ15N) des eaux du Danube et des communautés marines sur les Côtes Roumaines de la mer Noire]},
