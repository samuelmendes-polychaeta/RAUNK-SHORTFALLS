	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84887042161&doi=10.5735%2F085.050.0504&partnerID=40&md5=d1f07c9ddd39bb52a79a93b5d220c5d2},
	affiliations = {Centre for Ecological Research, Polish Academy of Sciences, PL-05-092 Łomianki, ul. Konopnickiej 1, Poland; Institute of Ecology and Bioethics, Cardinal Stefan Wyszynski University in Warsaw, PL-01-938 Warsaw, ul. Wójcickiego 1/3, Poland; Siedlce University of Natural Sciences and Humanities, PL-08-110 Siedlce, ul. Konarskiego 2, Poland; Department of Ecology, University of Ecology and Management, PL-02-061 Warsaw, ul. Wawelska 14, Poland; Museum and Institute of Zoology, PL-00-679 Warsaw, ul. Wilcza 64, Poland; Kazimierz Wielki University, PL-85-064 Bydgoszcz, ul. Jana Karola Chodkiewicza 30, Poland; Nicolaus Copernicus University, PL-87-100 Toruń, ul. Gagarina 11, Poland},
	abstract = {It has long been known that there is an allometric relationship between metabolic rate (M) and body weight (W) of the form: M = M0W<sup>b</sup>. However, the debate remains open regarding the value of b. Only recently research turned to the ecological implications of existing differences in metabolic scaling among taxa. Using a data set on forest soil invertebrates, we evaluated the influence of differences in intraspecific metabolic rate scaling on observed species biomass and abundance distributions. We found that absolute densities and biomass were correlated with the exponents of the intraspecific metabolic scaling. Evenness of the abundance distributions and species diversity were also moderately linked to b. These results suggest that the shape of the intraspecific metabolic-rate-body-size relationship affects interspecific biomass and abundance distributions. This emphasizes the importance of intraspecific variations in allometric scaling and indicates the need to take these variations into account when proposing models to explain these relationships. © 2013 Finnish Zoological and Botanical Publishing Board.},
