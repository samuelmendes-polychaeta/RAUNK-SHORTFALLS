	affiliations = {Department of Integrative Marine Ecology, Ischia Marine Centre, Stazione Zoologica Anton Dohrn, Naples, Ischia, Italy; Department of Environmental Biology, University of Rome “La Sapienza”, Rome, Italy; Department of Biology, University of Padova, Padova, Italy; Aquatic Bioscience, Huntsman Marine Science Centre, 1 Lower Campus Road, St Andrews, New Brunswick, E5B 2L7, Canada; Department of Biology, University of Naples Federico II, Naples, Italy; Laboratoire d'Océanographie de Villefranche, Sorbonne Université, CNRS, Villefranche-sur-Mer, France; Department of Integrative Marine Ecology, Fano Marine Centre, Stazione Zoologica Anton Dohrn, Fano, Italy},
	abstract = {Juvenile stages of marine species might be more vulnerable than adults to climate change, however larval vulnerability to predictable environmental changes can be mitigated by parental anticipatory buffer effects occurring during gametogenesis. In this study, ocean acidification effect were investigated on larval growth of two sea urchins, Arbacia lixula and Paracentrotus lividus, at different temperature levels. Results showed that altered pH and temperature affected larval development in both species, with significant length reductions of spicules and significant increases in abnormal larvae. Detrimental effects of reduced pH and high temperature were however dependent on the mother. Furthermore, the responses of A. lixula larvae from the ambient site (pH ∼ 8.0) were compared with those of larvae obtained from mothers collected from a natural CO<sub>2</sub> vent (pH ∼ 7.7) in Ischia. Comparisons highlighted a transgenerational response, as the CO<sub>2</sub> vent larvae proved to be more resilient to reduced pH, although more sensitive to increased temperature. © 2023},
	author_keywords = {Carbon vents; Echinoderms; Larval development; Maternal effects; Seawater acidification; Temperature},
