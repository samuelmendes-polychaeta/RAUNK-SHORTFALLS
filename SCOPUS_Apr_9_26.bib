	affiliations = {Research Institute for the Environment and Livelihoods, Charles Darwin University, Darwin, 0909, NT, Australia; CSIRO Land and Water, Albury, 2640, NSW, Australia; Institute of Land Water and Society, Charles Sturt University, Thurgoona, 2640, NSW, Australia; Centre for Freshwater Ecosystems, La Trobe University, Wodonga, 3689, Victoria, Australia; Supervising Scientist Branch, Department of Agriculture, Water and the Environment, Darwin, 0820, NT, Australia},
	abstract = {Groundwater ecosystems have a diverse and unique fauna, often dominated by Crustacea and generally characterised by short range endemics confined to single aquifers. Much of this knowledge has come from studies conducted either in fractured rock aquifers or alluvial aquifers. Karstic subterranean environments are present in the Cambrian Limestone Aquifer (CLA) in the Northern Territory, Australia, a freshwater aquifer which spans an area of ~28,000 km<sup>2</sup>. The presence of underground caverns and channels potentially allows extensive connectivity within this groundwater system. The emerging shale gas industry in the Beetaloo region, which underlies the CLA, provided the impetus to undertake the first survey of the potential existence of a stygofaunal community. Twenty-six groundwater wells (bores) and two springs were sampled in August and October 2019, across a distance of ~500 km, from the sub-tropical Mataranka region in the north to the semi-arid Barkly Tablelands in the south. Plankton nets and motorised pumps were used to collect water samples and conventional microscope-based morphological examinations in conjunction with environmental DNA (eDNA) were used to determine the presence of stygofauna. COI barcoding and 16S rRNA regions were also used for phylogenetic analysis. All stygofaunal communities were dominated by crustaceans, namely shrimps, amphipods, ostracods, copepods and syncarids. This fauna showed little affinity with the stygofauna recorded from more extensively sampled aquifers in north-western Australia, with new genera and species present in the CLA. eDNA analysis showed the presence of diverse biota at sites where direct water sampling for intact animals was difficult. COI and 16S analysis confirmed that a species of blind shrimp, Parisia unguis, occurred extensively throughout the aquifer, over a distance of at least ~300 km. The presence of Pa. unguis at widely separated sites across the CLA is consistent with substantial connectivity within the aquifer. This connectivity indicates that the risk of groundwater contamination from fracking chemicals needs to be adequately mitigated to prevent widespread effects. © 2021 Elsevier B.V.},
	author_keywords = {Atyidae; Cambrian Limestone Aquifer; eDNA; Parisia unguis; Stygobiotic animals; Subterranean ecosystems},
	correspondence_address = {S. Oberprieler; Research Institute for the Environment and Livelihoods, Charles Darwin University, Darwin, 0909, Australia; email: stef_oberprieler@hotmail.com},
	abbrev_source_title = {Sci. Total Environ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 17}
}

@ARTICLE{Pogoreutz2022,
	author = {Pogoreutz, Claudia and Clua, Eric E. G. and Tortolero-Langarica, J. J. Adolfo},
