@ARTICLE{Cannarsa2017151,
	author = {Cannarsa, Elio and Meconcelli, Stefania},
	title = {Increased population density reduces body growth and female investment in a simultaneous hermaphrodite},
	year = {2017},
	journal = {Current Zoology},
	volume = {63},
	number = {2},
	pages = {151 - 157},
	doi = {10.1093/cz/zow030},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85019665988&doi=10.1093%2Fcz%2Fzow030&partnerID=40&md5=671f55069fc65fdf30630de17ac4d614},
	affiliations = {Department of Life Sciences and Systems Biology, Universitá di Torino, Via Accademia Albertina 13, Torino, 10123, Italy},
	abstract = {Sex allocation theory applied to hermaphrodites assumes that there is a trade off between the allocation of resources to male and female functions, within a fixed reproductive resource budget. Charnov's classic resource allocation model predicts a more female-biased sex allocation when competition among different sperm donors is low due to diminishing fitness returns for male investment. By manipulating the social group size, one automatically changes the population density at which individuals live. Increasing population density may affect reproductive allocation, leading to resource competition and/or to increased concentration of harmful metabolites. This could lead to an over- or underestimation of the individual adjustment of sex allocation responses to mating opportunities. In this article, we tested the effects of density and social group size separately on female investment and body growth (considered as proxy of the overall energy budget) in the simultaneously hermaphroditic polychaete worm Ophryotrocha diadema. We manipulated social group size (i.e., monogamous and promiscuous regimes) and density (i.e., 4 levels) using a full-factorial design, to identify the underlying factor affecting female allocation (in terms of egg production) and body growth. In contrast to findings of previous experiments, we found that an increase in population density reduced body growth and egg production of hermaphrodites irrespective of social group size. We advance the hypothesis that the increase of catabolites and oxygen consumption in high-density conditions reduces the overall resource budget and this could obscure group size effects on female fecundity. © The Author (2016).},
	author_keywords = {Body growth; Female fecundity; Mating group size; Ophryotrocha diadema; Resource budget},
	correspondence_address = {E. Cannarsa; Department of Life Sciences and Systems Biology, Universitá di Torino, Torino, Via Accademia Albertina 13, 10123, Italy; email: ecannars@unito.it},
	abbrev_source_title = {Curr. Zool.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access}
}

