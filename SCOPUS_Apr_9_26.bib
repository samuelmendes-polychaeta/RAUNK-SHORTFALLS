	author = {Beck, Ludwig and Römbke, Jörg and Breure, Anton M. and Mulder, Christian},
	title = {Considerations for the use of soil ecological classification and assessment concepts in soil protection},
	year = {2005},
	journal = {Ecotoxicology and Environmental Safety},
	volume = {62},
