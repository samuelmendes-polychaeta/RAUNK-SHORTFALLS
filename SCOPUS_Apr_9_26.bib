@ARTICLE{Ahmad2023,
	author = {Ahmad, Manzoor and Ling, Juan and Yin, Jianping and Chen, Luxiang and Yang, Qingsong and Zhou, Weiguo and Zhang, Yuhang and Huang, Xiaofang and Khan, Imran and Dong, Junde},
	title = {Evaluation of the Different Nutritional and Environmental Parameters on Microbial Pyrene Degradation by Mangrove Culturable Bacteria},
	year = {2023},
	journal = {International Journal of Molecular Sciences},
