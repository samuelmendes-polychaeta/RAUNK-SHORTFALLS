@ARTICLE{Liyanagedara202557,
	author = {Liyanagedara, Pamod H. and Kowalewski, Michal and Tyler, Carrie L.},
	title = {Live–dead fidelity of ecological health indices (AMBI and M-AMBI) in benthic marine associations: a case study from coastal North Carolina, USA},
	year = {2025},
	journal = {Marine Ecology Progress Series},
	volume = {774},
	pages = {57 - 72},
	doi = {10.3354/meps14985},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024457197&doi=10.3354%2Fmeps14985&partnerID=40&md5=5f0cb13c1bfa6069fb1ce99576fcc3c1},
	affiliations = {Florida Museum of Natural History, University of Florida, Gainesville, 32611, FL, United States; Department of Biology, University of Florida, Gainesville, 32611, FL, United States; Department of Geoscience, University of Nevada, Las Vegas, 89154, NV, United States},
	abstract = {Recent studies have developed biotic indices, such as AMBI and M-AMBI, which commonly employ benthic macroinvertebrates to quantify ecosystem health with single numerical values. These indices can be potentially applied to the recent fossil record to assess human impacts. We evaluated the fidelity of AMBI and M-AMBI using live (LA) and dead (DA) benthic assemblages from 52 sites in Onslow Bay, North Carolina, USA, where various aspects of the live-dead compositional and functional agreement have been previously assessed. AMBI scores were calculated for the live and dead assemblages, while M-AMBI scores were computed both separately, and by pooling the live and dead assemblages together. A Wilcoxon paired-sample signed-rank test revealed significant differences in AMBI scores between the DAs and LAs, but no significant differences were found for M-AMBI. For AMBI scores, the correlation between the whole-community LA and DA was weak and non-significant, whereas M-AMBI live and dead scores were positively correlated. Habitat-level grouping based on AMBI scores showed weak and insignificant correlations for both whole benthic and mollusk-only communities. In contrast, M-AMBI scores demonstrated strong and significant correspondence between the LA and DA for whole communities. However, this agreement was not significant for mollusk-only communities. M-AMBI was more effective than AMBI in reconstructing key relationships from DAs. When applied to the fossil record, the absolute numerical values of M-AMBI may be less interpretable due to time averaging and are most applicable as a relative tool in conservation paleobiology studies. © The authors 2025.},
	author_keywords = {AMBI; Biotic indices; Conservation paleobiology; Fossil record; M-AMBI; Macroinvertebrates},
	correspondence_address = {P.H. Liyanagedara; Florida Museum of Natural History, University of Florida, Gainesville, 32611, United States; email: ph.liyanagedara@ufl.edu},
	abbrev_source_title = {Mar. Ecol. Prog. Ser.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wu2025,
	author = {Wu, Hao and Dong, Sijin and Yu, Meipeng and Liu, Yuxin and Rao, Benqiang},
	title = {Interspecific association characteristics of Alternanthera philoxeroides-invaded communities and their latitudinal variations},
	year = {2025},
	journal = {Frontiers in Ecology and Evolution},
	volume = {13},
	pages = {},
	doi = {10.3389/fevo.2025.1602762},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011276162&doi=10.3389%2Ffevo.2025.1602762&partnerID=40&md5=83b1649eb1774eab279ab4233a602b0d},
	affiliations = {College of Life Sciences, Xinyang Normal University, Xinyang, China; Henan Dabieshan National Field Observation and Research Station of Forest Ecosystem, Zhengzhou, China; Xinyang Academy of Ecological Research, Xinyang, China; School of Life Sciences, Henan University, Kaifeng, China},
	abstract = {Biological invasions can lead to changes in the interspecific association and coexistence patterns of plant species; however, the differences in the interspecific association characteristics of invaded plant communities in heterogeneous habitats and their variations along latitudinal gradients remain unclear. Here, we established 40 terrestrial plots and 40 aquatic plots invaded by the amphibious invasive species Alternanthera philoxeroides (Mart.) Griseb. within the range of 21–37°N in China to explore the interspecific associations and association intensities of A. philoxeroides-invaded plant communities and their latitudinal trends. We found that there was a significantly positive interspecific association in the overall terrestrial communities, with A. philoxeroides having a strong association with many accompanying species. However, there was a nonsignificant negative interspecific association in the overall aquatic communities. The ratio of species pairs with positive/negative associations (PNR) in terrestrial communities dramatically decreased at higher latitudes. The values of the Jaccard index (J<sub>A</sub>), Ochiai index (O<sub>I</sub>), and Dice index (D<sub>I</sub>) which represent the interspecific association intensity in terrestrial communities, were extremely significantly greater than those in aquatic communities. The association intensity between terrestrial accompanying species significantly decreased with increasing latitude, and the association intensity between aquatic accompanying species varied weakly along the latitudinal gradient. Our study revealed that A. philoxeroides invasion aggravated interspecific competition among accompanying species in terrestrial plant communities in higher latitude regions, whereas the aquatic A. philoxeroides-invaded communities presented more mutualistic relationships to resist abiotic stress in higher latitude regions. Copyright © 2025 Wu, Dong, Yu, Liu and Rao.},
	author_keywords = {alligator weed; habitat heterogeneity; interspecific relationship; latitude; plant invasions; species coexistence},
	correspondence_address = {H. Wu; College of Life Sciences, Xinyang Normal University, Xinyang, China; email: wuhao86868686@163.com; B. Rao; College of Life Sciences, Xinyang Normal University, Xinyang, China; email: wuhao86868686@163.com},
	abbrev_source_title = {Front. ecol. evol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Kendzierska2024,
	author = {Kendzierska, Halina and Janas, Urszula},
	title = {Functional diversity of macrozoobenthos under adverse oxygen conditions in the southern Baltic Sea},
	year = {2024},
	journal = {Scientific Reports},
	volume = {14},
	number = {1},
	pages = {},
	doi = {10.1038/s41598-024-59354-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190704810&doi=10.1038%2Fs41598-024-59354-3&partnerID=40&md5=d7ac73b106144b6ca13eae6d49bb4f90},
	affiliations = {Department of Marine Ecology, Faculty of Oceanography and Geography, University of Gdańsk, Al. Marszałka Piłsudskiego 46, Gdynia, 81-378, Poland},
	abstract = {Oxygen deficiency is a major problem in the Baltic Sea. To study the impact of hypoxia on the functional diversity of benthic fauna and the possibility of macrozoobenthos recovery, data were analyzed in a gradient of oxygen conditions in the Gdańsk Basin. The research conducted on the basis of biological traits analysis enabled us to analyze the number, type and spatial distribution of biological traits—a proxy for functions performed by macrozoobenthos. A significant depletion of macrofauna was already observed under conditions of reduced oxygen above the bottom, both in terms of functional diversity and biomass. Although taxa observed in hypoxia (DO < 2 mL L<sup>−1</sup>) perform a number of functions, the remaining species do not form complex structures in the sediments or cause deep bioturbation and bioirrigation. Moreover, their extremely low biomass plays an irrelevant role in benthic–pelagic coupling. Thus, benthic fauna under hypoxia is not an element that ensures the functioning of the ecosystem. We assess that traits important for species dispersal and the presence of taxa resistant to short-term hypoxia in the oxic zone above the halocline provide a “backup” for ecosystem functioning under altered diverse oxygen conditions below the halocline after cessation of hypoxia in the southern Baltic Sea. © The Author(s) 2024.},
	correspondence_address = {H. Kendzierska; Department of Marine Ecology, Faculty of Oceanography and Geography, University of Gdańsk, Gdynia, Al. Marszałka Piłsudskiego 46, 81-378, Poland; email: halina.kendzierska@ug.edu.pl},
	abbrev_source_title = {Sci. Rep.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 16; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Knoop20244385,
	author = {Knoop, Jessica and Barrento, Sara and Griffin, John N.},
	title = {Harvesting impact on a commercially important red macroalga on a North-East Atlantic rocky shore},
	year = {2024},
	journal = {Hydrobiologia},
	volume = {851},
	number = {18},
	pages = {4385 - 4400},
	doi = {10.1007/s10750-024-05591-6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196672543&doi=10.1007%2Fs10750-024-05591-6&partnerID=40&md5=7b45c6a3889932404e125be0dacc6e1f},
	affiliations = {Department of Biosciences, Swansea University, Singleton Park, Swansea, SA2 8PP, United Kingdom; FAI Farms Ltd, The Barn, Wytham, Oxford, OX2 8QJ, United Kingdom},
	abstract = {Red macroalgae in the genus Porphyra are widely collected for human consumption and increasingly harvested along the North Atlantic coasts but their ability to withstand repeated harvesting and maintain high cover and abundance on natural shorelines remains poorly explored, raising sustainability concerns. Therefore, we investigated the effect of frequent hand-harvesting on Porphyra dioica in a population in South Wales, UK, where it is commercially harvested. Twelve control and twelve treatment quadrats were installed in spring and six control and treatment plots in autumn. Monthly hand-harvesting of P. dioica individuals larger than 5 cm was performed in the treatment plots, while the control plots remained undisturbed. We monitored P. dioica percentage cover, yield, thallus length and recruit density, as well as benthic flora and fauna. Harvesting only impacted P. dioica thallus length, resulting in 41% smaller thalli compared to unharvested plots during summer, with possible long-term implications (e.g. reproductive output). Strong seasonality of P. dioica cover and yield was observed, peaking during spring and summer. The results suggest high resilience of the opportunistic life strategy of P. dioica under frequent harvesting, but to allow for full recovery, we urge for a recovery period of more than the tested 4 weeks. © The Author(s), under exclusive licence to Springer Nature Switzerland AG 2024.},
	author_keywords = {Laver; Porphyra; Removal; Seaweed; Sustainable; Yield},
	correspondence_address = {J. Knoop; Department of Biosciences, Swansea University, Swansea, Singleton Park, SA2 8PP, United Kingdom; email: jessica-knoop@web.de},
	abbrev_source_title = {Hydrobiologia},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{McCormack2024,
	author = {McCormack, Robert B. and Whiterod, Nick S.},
	title = {Biology, distribution and conservation of a dwarf-group crayfish, Euastacus spinichelatus Morgan, 1997 (Decapoda: Astacidea: Parastacidae), a freshwater crayfish from the Great Dividing Range, New South Wales, Australia},
	year = {2024},
	journal = {Journal of Crustacean Biology},
	volume = {44},
	number = {1},
	pages = {},
	doi = {10.1093/jcbiol/ruae011},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85187682629&doi=10.1093%2Fjcbiol%2Fruae011&partnerID=40&md5=cd7ade89b0c207ac9b661c71340bfd38},
	affiliations = {Australian Crayfish Project, Australian Aquatic Biological Pty Ltd, Karuah, 2324, NSW, Australia; Section of Invertebrate Zoology, Carnegie Museum of Natural History, Pittsburgh, 15213-4080, PA, United States; Nature Glenelg Trust, Victor Harbor, 5211, SA, Australia; CLLMM Research Centre, Goyder Institute for Water Research, Goolwa, 5214, SA, Australia},
	abstract = {We present the outcomes of two conservation initiatives, namely ‘The Australian Crayfish’ and ‘Saving the Spinys’ projects, which have substantially contributed to enhancing our understanding of E. spinichelatus concerning its distribution, habitat, biology, and conservation status. We extend the range of E. spinichelatus to encompass the headwater reaches of the Namoi River within the Murray-Darling Basin. The use of molecular taxonomy analyses identified divergent lineages that acted to remove the southeastern tributaries of the Hastings River and the most western tributary of the Manning River from the range of E. spinichelatus. The species has suffered significant population declines in recent years, with it appearing to be highly susceptible to anthropogenic changes, drought and/or high-severity bushfires. Results advocate for the classification of E. spinichelatus as an endangered species, recognizing its distinctive ecological niche and its status as a climate refugee, aiming to protect this rare species from anthropogenic and climate-related challenges. We also present a taxonomic key differentiating E. spinichelatus from other members of Parastacidae in the region. © The Author(s) 2024. Published by Oxford University Press on behalf of The Crustacean Society.},
	author_keywords = {climate change; conservation; critically endangered freshwater crayfishes; Crustacea; ectosymbiotic fauna; Euastacus spinifer; extirpation; Hastings River Basin; Murray-Darling Basin},
	correspondence_address = {R.B. McCormack; Australian Crayfish Project, Australian Aquatic Biological Pty Ltd, Karuah, 2324, Australia; email: rob@aabio.com.au},
