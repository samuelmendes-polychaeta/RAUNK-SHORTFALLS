	number = {19},
	pages = {},
	doi = {10.3390/ani15192885},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019252607&doi=10.3390%2Fani15192885&partnerID=40&md5=ddaa3194ad9b04330d6ec17beac14002},
	affiliations = {Fish Nutrigenomics and Integrative Biology Group, Institute of Aquaculture Torre de la Sal (IATS, CSIC), Castellón, 12595, Spain; Department of Biotechnology and Life Sciences, University of Insubria, Varese, 21100, Italy},
	abstract = {Intestinal microbiota populations are constantly shaped by both intrinsic and extrinsic factors, including diet, environment, and host genetics. As a result, understanding how to assess, monitor, and exploit microbiome–host interplay remains an active area of investigation, especially in aquaculture. In this study, we analyzed the taxonomic structure and functional potential of the intestinal microbiota of European sea bass and rainbow trout, incorporating gilthead sea bream as a final reference. The results showed that the identified core microbiota (40 taxa for sea bass and 20 for trout) held a central role in community organization, despite taxonomic variability, and exhibited a predominant number of positive connections (>60% for both species) with the rest of the microbial community in a Bayesian network. From a functional perspective, core-associated bacterial clusters (75% for sea bass and 81% for sea bream) accounted for the majority of predicted metabolic pathways (core contribution: >75% in sea bass and >87% in trout), particularly those involved in carbohydrate, amino acid, and vitamin metabolism. Comparative analysis across ecological phenotypes highlighted distinct microbial biomarkers, with genera such as Vibrio, Pseudoalteromonas, and Paracoccus enriched in saltwater species (Dicentrarchus labrax and Sparus aurata) and Mycoplasma and Clostridium in freshwater (Oncorhynchus mykiss). Overall, this study underscores the value of integrating taxonomic, functional, and network-based approaches as practical tools to monitor intestinal health status, assess welfare, and guide the development of more sustainable production strategies in aquaculture. © 2025 by the authors.},
	author_keywords = {bacterial functions; Bayesian network; core microbiota; dietary intervention; European sea bass; fish gut microbiome; host genetics; microbiota biomarkers; Rainbow trout; taxonomical variability},
	correspondence_address = {F. Moroni; Fish Nutrigenomics and Integrative Biology Group, Institute of Aquaculture Torre de la Sal (IATS, CSIC), Castellón, 12595, Spain; email: federico.moroni@csic.es; J. Pérez-Sánchez; Fish Nutrigenomics and Integrative Biology Group, Institute of Aquaculture Torre de la Sal (IATS, CSIC), Castellón, 12595, Spain; email: jaime.perez.sanchez@csic.es},
