@ARTICLE{Zhukova2022,
	author = {Zhukova, Natalia V. and Eliseikina, Marina G. and Balakirev, Evgeniy S. and Ayala, Francisco J.},
	title = {Multiple bacterial partners in symbiosis with the nudibranch mollusk Rostanga alisae},
	year = {2022},
	journal = {Scientific Reports},
	volume = {12},
