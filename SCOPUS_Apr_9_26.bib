@ARTICLE{Wolfe2020179,
	author = {Wolfe, Kennedy and Anthony, Ken and Babcock, Russell C. and Bay, Line and Bourne, David G. and Burrows, Damien and Byrne, Maria and Deaker, Dione J. and Diaz-Pulido, Guillermo and Frade, Pedro R. and Gonzalez-Rivero, Manuel and Hoey, Andrew and Hoogenboom, Mia and McCormick, M.A.R.K. and Ortiz, Juan-Carlos and Razak, Tries and Richardson, Anthony J. and Roff, George and Sheppard-Brennand, Hannah and Stella, Jessica and Thompson, Angus and Watson, Sue-Ann and Webster, Nicole and Audas, Donna and Beeden, Roger and Carver, Jesseca and Cowlishaw, Mel and Dyer, Michelle and Groves, Paul and Horne, Dylan and Thiault, Lauric and Vains, Jason and Wachenfeld, David and Weekers, Damien and Williams, Genevieve and Mumby, Peter J.},
	title = {Priority species to support the functional integrity of coral reefs},
