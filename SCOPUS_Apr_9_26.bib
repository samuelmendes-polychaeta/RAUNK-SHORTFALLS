}

@ARTICLE{Piotrowska2013713,
	author = {Piotrowska, Katarzyna and Connolly, John and Finn, John and Black, Alistair and Bolger, Thomas},
	title = {Evenness and plant species identity affect earthworm diversity and community structure in grassland soils},
	year = {2013},
