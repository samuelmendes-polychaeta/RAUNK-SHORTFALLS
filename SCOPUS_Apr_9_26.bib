@ARTICLE{Malik2022,
	author = {Malik, Rondy J. and Bruns, Mary Ann V. and Bell, Terrence H. and Eissenstat, David M.},
	title = {Phylogenetic Signal, Root Morphology, Mycorrhizal Type and Macroinvertebrate Exclusion: Exploring Wood Decomposition in Soils Conditioned by 13 Temperate Tree Species},
