@ARTICLE{Metzger2016879,
	author = {Metzger, David C. H. and Healy, Timothy M. and Schulte, Patricia M.},
	title = {Conserved effects of salinity acclimation on thermal tolerance and hsp70 expression in divergent populations of threespine stickleback (Gasterosteus aculeatus)},
