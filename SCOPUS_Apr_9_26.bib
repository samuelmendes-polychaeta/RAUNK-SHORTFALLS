	title = {The sea urchin Diadema africanum uses low resolution vision to find shelter and deter enemies},
	year = {2018},
	journal = {Journal of Experimental Biology},
	volume = {221},
	number = {14},
	pages = {},
	doi = {10.1242/jeb.176271},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85050333215&doi=10.1242%2Fjeb.176271&partnerID=40&md5=9d2a8c4b6ef4872e08bb27de7a5cc913},
	affiliations = {Lund Vision Group, Department of Biology, Lund University, Lund, 223 62, Sweden; School of Biological Sciences, Faculty of Science, University of Bristol, Bristol, BS8 1TH, United Kingdom; Departamento de Biologiá Animal, Edafologiá y Geologiá (UD Ciencias Marinas), Universidad de La Laguna, Tenerife, Canary Islands, San Cristóbal de La Laguna, 38200, Spain},
	abstract = {Many sea urchins can detect light on their body surface and some species are reported to possess image-resolving vision. Here, we measure the spatial resolution of vision in the long-spined sea urchin Diadema africanum, using two different visual responses: a taxis towards dark objects and an alarm response of spine-pointing towards looming stimuli. For the taxis response we used visual stimuli, which were isoluminant to the background, to discriminate spatial vision from phototaxis. Individual animals were placed in the centre of a cylindrical arena under bright down-welling light, with stimuli of varying angular width placed on the arena wall at alternating directions from the centre. We tracked the direction of movement of individual animals in relation to the stimuli to determine whether the animals oriented towards the stimulus. We found that D. africanum responds by taxis towards isoluminant stimuli with a spatial resolution in the range of 29–69 deg. This corresponds to a theoretical acceptance angle of 38–89 deg, assuming a contrast threshold of 10%. The visual acuity of the alarm response of D. africanum was tested by exposing animals to different sized dark looming and appearing stimuli on a monitor. We found that D. africanum displays a spine-pointing response to appearing black circles of 13–25 deg angular width, corresponding to an acceptance angle of 60–116 deg, assuming the same contrast threshold as above. © 2018. Published by The Company of Biologists Ltd.},
	author_keywords = {Echinoidea; Photoreception; Sea urchin; Visual acuity; Visual response; Visually guided behaviour},
	correspondence_address = {D.-E. Nilsson; Lund Vision Group, Department of Biology, Lund University, Lund, 223 62, Sweden; email: dan-e.nilsson@biol.lu.se},
	abbrev_source_title = {J. Exp. Biol.},
