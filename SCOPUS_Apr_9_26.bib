	year = {2025},
	journal = {Ecology Letters},
	volume = {28},
	number = {1},
	pages = {},
	doi = {10.1111/ele.70054},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213989137&doi=10.1111%2Fele.70054&partnerID=40&md5=71561a73fd4ce3016dae2850827c3ae7},
	affiliations = {Centre for Biological Diversity, School of Biology, University of St Andrews, St Andrews, United Kingdom; School of Biological Sciences, University of Aberdeen, Aberdeen, United Kingdom},
	abstract = {Given that reproductive physiology is highly sensitive to thermal stress, there is increasing concern about the effects of climate change on animal fertility. Even a slight reduction in fertility can have consequences for population growth and survival, so it is critical to better understand and predict the potential effects of climate change on reproductive traits. We synthesised 1894 effect sizes across 276 studies on 241 species to examine thermal effects on fertility in aquatic animals. Our meta-analysis revealed that external fertilisers tend to be more vulnerable to warming than internal fertilisers, especially in freshwater species. We also found that increased temperature is particularly detrimental for gametes and that under certain conditions, female fertility is more sensitive to warming than male fertility, challenging the prevailing view that males are more vulnerable. This work provides valuable new insights into the effects of temperature on fertility, with potential consequences for population viability. © 2024 The Author(s). Ecology Letters published by John Wiley & Sons Ltd.},
	author_keywords = {fecundity; fertilisation; gamete; gonad; meta-analysis; reproduction; temperature},
	correspondence_address = {A. Chatten; Centre for Biological Diversity, School of Biology, University of St Andrews, St Andrews, United Kingdom; email: agc27@st-andrews.ac.uk; N. Pilakouta; Centre for Biological Diversity, School of Biology, University of St Andrews, St Andrews, United Kingdom; email: np84@st-andrews.ac.uk},
	abbrev_source_title = {Ecol. Lett.},
