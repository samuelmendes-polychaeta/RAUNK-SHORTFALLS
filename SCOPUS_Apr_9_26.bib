	doi = {10.1016/j.ecss.2021.107577},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115812842&doi=10.1016%2Fj.ecss.2021.107577&partnerID=40&md5=cf3d463d5bc17ee7c2c72b4850f8c3ba},
	affiliations = {Departamento de Botânica, Instituto de Biologia, Universidade Federal do Rio de Janeiro, Cidade Universitária, Av. Carlos Chagas Filho, 373 Bloco A, A1-66, Rio de Janeiro, 21941-902, Brazil; Programa de Pós-graduação em Ciências (Botânica) do Museu Nacional, Universidade Federal do Rio de Janeiro, Rio de Janeiro, Brazil; Dipartimento di Biologia, Università di Pisa, CoNISMa, Via Derna 1, Pisa, 56126, Italy; Stazione Zoologica Anton Dohrn, Villa Comunale, Naples, 80121, Italy; Departamento de Zoologia, Instituto de Biologia, Universidade Federal do Rio de Janeiro, Cidade Universitária, Av. Carlos Chagas Filho, 373 Bloco A, A0-108, Rio de Janeiro, 21941-902, Brazil},
	abstract = {Spatial and temporal variability in rocky shore assemblages at multiple scales can be driven by natural factors and anthropogenic disturbances, operating either separately to each other or in complex combinations. Using the shallow subtidal rocky habitat in Ilha Grande Bay (southeastern Brazil) as a model system, this study analyzed five natural and five anthropogenic variables as possible drivers of variability of cover in rocky shore assemblages, focusing on the following questions: (i) Which are the relevant horizontal scales of variation in assemblage structure?; (ii) Are patterns of horizontal variation consistent across a small depth range?; (iii) Are there significant relationships between spatial patterns of macroalgae and macroinvertebrates, and their potential natural and anthropogenic drivers? These issues were addressed through a hierarchical sampling strategy including five horizontal scales, namely quadrat (0.4–3 m), point (3–10 m), site (100–350 m), island (500–1000 m) and area (2000–6500 m), repeated at two depths (1–2 m and 3.5–4.5 m). The correlations of cover data of 21 groups of organisms and five natural and five anthropogenic variables were analyzed. Assemblages showed relevant variation among quadrats, points and sites, at both depths, while variation at the area scale was relevant only at 3.5–4.5 m depth, indicating that patterns of horizontal variation were not fully consistent between depths. Substrate rugosity, rocky shore extension, water movement, percentage of deforested land area and distance to urban center were the environmental variables that most explained spatial patterns of the assemblages. Our study highlights the potential role of such variables as drivers of variation in rocky subtidal assemblages at multiple spatial scales. For environmental protection programs, relevant scales of variation of target populations and assemblages need to be considered, to effectively capture their dynamics and underlying processes. © 2021 Elsevier Ltd},
	author_keywords = {Articulated coralline algae; Brazil; Palythoa; Substrate heterogeneity; Urbanization},
	correspondence_address = {I.M. Carneiro; Departamento de Botânica, Instituto de Biologia, Universidade Federal do Rio de Janeiro, Cidade Universitária, Rio de Janeiro, Av. Carlos Chagas Filho, 373 Bloco A, A1-66, 21941-902, Brazil; email: ivanmonclaro@ufrj.br},
	abbrev_source_title = {Estuar. Coast. Shelf Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@ARTICLE{Pawlikowski2022433,
	author = {Pawlikowski, Krzysztof and Kornijów, Ryszard},
	title = {Distribution of benthic macroinvertebrates across a reed stand in a brackish Baltic lagoon},
	year = {2022},
	journal = {Oceanologia},
	volume = {64},
	number = {3},
	pages = {433 - 444},
	doi = {10.1016/j.oceano.2022.02.004},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85127496270&doi=10.1016%2Fj.oceano.2022.02.004&partnerID=40&md5=64de32d7382212a392dc1846fb14688f},
	affiliations = {National Marine Fisheries Research Institute, Gdynia, Poland},
	abstract = {The role of reeds in the functioning of ecosystems and their significance for zoobenthos in the coastal lagoons is poorly understood. We hypothesise that next to the spatial zonal differentiation of abiotic factors in the apparently homogeneous habitat of reeds, benthic macroinvertebrate fauna is also unevenly distributed, and differs in taxonomic and functional diversity, as well as density and biomass across the reed stand. The research was carried out in the Vistula Lagoon (southern Baltic) along three designated sectors arranged parallel to the shoreline and differing in distance from the shore and depth. Mean density of reed stems in the analysed stand was within the range of values reported from different American and European wetlands. Regardless of the location within the reeds and the season, the fauna was dominated by detritivorous Tubificinae and larvae of Chironomidae. The highest diversity, density, and biomass of fauna were found in the middle littoral zone, and the lowest in the outer zone adjacent to the open water. The presented data support our hypothesis predicting the existence of a spatial variation pattern in the composition and distribution of macroinvertebrates in response to the changing zonal habitat conditions within the reed stand. © 2022},
	author_keywords = {Littoral zone; Macrophytes; Trophic guilds; Vistula Lagoon; Zoobenthos},
	correspondence_address = {K. Pawlikowski; National Marine Fisheries Research Institute, Gdynia, Kołłątaja 1, 81-332, Poland; email: kpawlikowski@mir.gdynia.pl},
	abbrev_source_title = {Oceanologia},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Sautya2021,
	author = {Sautya, Sabyasachi and Gaikwad, Santosh and Khokher, Sanofar and Pradhan, Umesh Kumar and Chatterjee, Soumya and Choudhury, Amita and Sahu, Balaram and Attri, Suman},
	title = {Distribution Pattern of the Benthic Meiofaunal Community Along the Depth Gradient of the Western Indian Continental Margin, Including the OMZ and Abyssal Plain},
