@ARTICLE{Bodur2024,
	author = {Bodur, Yasemin V. and Renaud, Paul E. and Lins, Lidia and Da Costa Monteiro, Luana and Ambrose, William G. and Felden, Janine and Krumpen, Thomas and Wenzhöfer, Frank and Włodarska-Kowalczuk, Maria and Braeckman, Ulrike},
	title = {Weakened pelagic-benthic coupling on an Arctic outflow shelf (Northeast Greenland) suggested by benthic ecosystem changes},
