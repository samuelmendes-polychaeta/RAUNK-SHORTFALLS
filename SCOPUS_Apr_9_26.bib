	note = {Cited by: 35; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Caswell2019472,
	author = {Caswell, Bryony A. and Frid, Chris L.J. and Borja, Angel},
	title = {An ecological status indicator for all time: Are AMBI and M-AMBI effective indicators of change in deep time?},
	year = {2019},
