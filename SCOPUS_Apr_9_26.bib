}

@ARTICLE{Lindsey-Robbins2019,
	author = {Lindsey-Robbins, Josephine and Vázquez-Ortega, Angélica and McCluney, Kevin and Pelini, Shannon},
	title = {Effects of detritivores on nutrient dynamics and corn biomass in mesocosms},
	year = {2019},
	journal = {Insects},
