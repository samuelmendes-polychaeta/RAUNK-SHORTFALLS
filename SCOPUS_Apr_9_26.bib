@ARTICLE{Bisanti2024,
	author = {Bisanti, Luca and Turco, Gabriele and Chemello, Renato},
	title = {Signals of loss, part two: A phytal community collapsing under extreme-climate conditions on a Mediterranean vermetid reef},
	year = {2024},
	journal = {Marine Pollution Bulletin},
