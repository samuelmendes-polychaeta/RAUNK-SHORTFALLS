	source = {Scopus},
	note = {Cited by: 24}
}

@ARTICLE{Bonkowski201241,
	author = {Bonkowski, Michael and Roy, Jacques},
	title = {Decomposer community complexity affects plant competition in a model early successional grassland community},
	year = {2012},
	journal = {Soil Biology and Biochemistry},
	volume = {46},
	pages = {41 - 48},
	doi = {10.1016/j.soilbio.2011.11.013},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-83455235271&doi=10.1016%2Fj.soilbio.2011.11.013&partnerID=40&md5=d37d408dc3861ba4b1decfc7a26c3515},
	affiliations = {Biozentrum Köln, Institut für Zoologie, Abt. Terrestrische ökologie, 50674 Köln, Zülpicher Str. 47b, Germany; Centre d'Ecologie Fonctionnelle et Evolutive, CNRS, F-34293 Montpellier, 1919 route de Mende, France; Ecotron, CNRS UPS 3248, 34 980 Montferrier-sur-Lez, 1 Chemin du Rioux, Campus Baillarguet, France},
	abstract = {The effects of a simple decomposer community, consisting of collembola, enchytraeids and earthworms on the performance of plants in a model Mediterranean early successional grassland community were investigated. Interactions of plant functional groups and species within the soil decomposer community resulted in significant shifts of plant competitive strength and therefore are likely to affect the rate of the successional development of plant communities.Depending on the functional role of the decomposer taxa involved, either legumes, or non-leguminous forbs were more negatively affected. Therefore, increasing species numbers with in the decomposer community gradually reduced the relative contribution of forbs (legumes and non-leguminous forbs), although fundamentally different mechanisms were responsible for these effects. Surprisingly, not the biomass-dominant annelid taxa, but collembola had the strongest effects on plant performance. The grass-to-forb ratio, an indicator of successional change, shifted from 3 to 4 in presence of collembola, suggesting that indirect effects on microbial symbionts of plants were more important than classic decomposer effects via increased and more constant nutrient availability to plants. Total plant productivity, however, was not affected, since grasses gained competitive advantage and compensated with increased growth for the negative animal effects on forb performance. Our results highlight the importance of specific functional groups among decomposers for structuring grassland plant communities. However, great plasticity in the plant community through negative covariance between forbs and grasses, partly compensated for decomposer effects at the plant canopy level. © 2011 Elsevier Ltd.},
	author_keywords = {Decomposer community; Grassland succession; Plant competition},
	correspondence_address = {M. Bonkowski; Cologne Biocenter, Institut für Zoologie, Abt. Terrestrische ökologie, 50674 Köln, Zülpicher Str. 47b, Germany; email: m.bonkowski@uni-koeln.de},
	abbrev_source_title = {Soil Biol. Biochem.},
