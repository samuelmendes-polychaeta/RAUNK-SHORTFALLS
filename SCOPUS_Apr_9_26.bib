	title = {Bioenergetics of parental investment in two polychaete species with contrasting reproductive strategies: The planktotrophic Boccardia chilensis and the poecilogonic Boccardia wellingtonensis (Spionidae)},
	year = {2020},
	journal = {Marine Ecology},
