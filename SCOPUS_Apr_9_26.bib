}

@ARTICLE{Branscomb2014158,
	author = {Branscomb, E. Sanford and Vedder, Karen and Strathmann, Richard R.},
	title = {Risks for larvae mediated by plasticity in hatching},
	year = {2014},
	journal = {Invertebrate Biology},
	volume = {133},
