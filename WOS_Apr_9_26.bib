Title = {Biological traits of marine benthic invertebrates in Northwest Europe},
Journal = {SCIENTIFIC DATA},
Year = {2022},
Volume = {9},
Number = {1},
Month = {JUN 15},
Abstract = {Biological traits analysis (BTA) provides insight into causes and
   consequences of biodiversity change that cannot be achieved using
   traditional taxonomic approaches. However, acquiring information on
   biological traits (i.e., the behavioural, morphological, and
   reproductive characteristics of taxa) can be extremely time-consuming,
   especially for large community datasets, thus hindering the successful
   application of BTA. Here, we present information on ten key biological
   traits for over a thousand marine benthic invertebrate taxa surveyed in
   Northwest Europe (mainly the UK shelf). Scores of 0 to 3 are provided to
   indicate our confidence that taxa exhibit each possible mode of trait
   expression. The information was acquired over a decade through an
   extensive appraisal of relevant sources, including peer-reviewed papers,
   books, online material and, where necessary, professional judgement.
   These data may be inspected, used, and augmented by fellow researchers,
   thus assisting in the wider application of BTA in marine benthic
   ecology.},
