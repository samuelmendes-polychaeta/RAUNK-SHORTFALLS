   Degraer, Steven, Royal Belgian Inst Nat Sci, Operat Directorate Nat, B-1200 Brussels, Belgium.},
DOI = {10.1002/aqc.2448},
ISSN = {1052-7613},
EISSN = {1099-0755},
Keywords = {subtidal; coastal; Habitats Directive; marine protected area; ecosystem
   approach; benthos},
