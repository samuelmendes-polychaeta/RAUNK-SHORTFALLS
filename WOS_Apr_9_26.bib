@article{ WOS:001413924700001,
Author = {Kanhai, Attish and Juman, Rahanna},
Title = {Seagrass loss decreases abundance, diversity and changes composition of
   macrobenthic infauna in a Caribbean Bay},
Journal = {MARINE BIODIVERSITY},
Year = {2025},
Volume = {55},
Number = {1},
Month = {FEB 5},
Abstract = {Seagrass meadows form complex ecosystems in the coastal zone that are
   highly productive and sustain an abundant faunal community. This study
   compared the macrobenthic infaunal communities in William's Bay,
   Trinidad before and after a lush seagrass meadow dominated by Thalassia
   testudinum (Banks ex K \& ouml;nig) was extirpated. In 2007, T.
   testudinum aerial productivity was estimated at 2.68 +/- 0.81 gm-2 d-1
   and total biomass was 357.8 +/- 224.8 gm-2, but by 2016 the bed had
   collapsed with zero productivity and biomass. To assess the macrobenthic
   infauna, five replicate cores were taken at six stations in 2007 and in
   2016. Species richness, abundance and biomass all decreased from 2007 to
   2016 as seagrass meadows were lost. This is likely due to fewer
   microhabitats and less protection from predators provided by seagrass
   cover. Relative abundance of the main species groups remained unchanged;
   polychaetes accounted for 48\% of the species in 2007 and 2016,
   amphipods accounted for 17\% in both years, decapods for 12\% and 15\%
   in 2007 and 2016 respectively, non-segmented worms for 11\% (2007) and
   6\% (2016), molluscs for 2\% (2007) and 13\% (2016), echinoderms for
   less than 1\% and a small miscellaneous group for another 1\%.
   Deposit-feeding polychaetes were dominant across both sampling periods
   while carnivorous polychaetes showed a notable decline. Epifaunal
   amphipods dominated across both periods compared to infaunal
   tube-dwellers.},
