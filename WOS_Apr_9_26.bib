@article{ WOS:001094504100005,
Author = {D'Ambrosio, Mariaelena and Ramos, Iris and Martins, Carla and Costa,
   Pedro M.},
Title = {An investigation into the toxicity of tissue extracts from two distinct
   marine Polychaeta},
Journal = {TOXICON-X},
Year = {2022},
Volume = {14},
Month = {JUN},
Abstract = {The present study investigated the potential toxicity of venomous
   secretions of two polychaetes, Hediste diversicolor and Glycera alba
   (Annelida: Phyllodocida). Toxic activity of putative toxins, measured on
   mussel gills through the Comet assay, revealed higher effects caused by
   extracts from H. diversicolor skin and G. alba specialised, jawed
   proboscis, when compared to control. The results suggest that H.
   diversicolor secretes toxins via skin for protection against predators,
   contrarily to G. alba, who secretes toxins for predation.},
