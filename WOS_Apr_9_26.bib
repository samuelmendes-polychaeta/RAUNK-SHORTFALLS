@article{ WOS:000607298000002,
Author = {Allouche, Mohamed and Nasri, Ahmed and Harrath, Abdel Halim and Mansour,
   Lamjed and Alwasel, Saleh and Beyrem, Hamouda and Plavan, Gabriel and
   Rohal-Lupher, Melissa and Boufahja, Fehmi},
Title = {Do presence of gray shrimp Crangon crangon larvae influence
