@article{ WOS:001596115200001,
Author = {O'Reilly-Berkeley, Xaali and Pazmino-Palomino, Alex and
   Hidalgo-Cardenas, Andrea and Trujillo-Regalado, Sofia I. and Mossman,
   Hannah and Rowntree, Jennifer K. and Preziosi, Richard F.},
Title = {Height and phytotelm size affect the invertebrate communities of
   epiphytic bromeliads in the Amazon rainforest},
Journal = {ECOLOGICAL ENTOMOLOGY},
Year = {2026},
Volume = {51},
Number = {2},
Pages = {221-234},
Month = {APR},
Abstract = {Tank bromeliads are found in rainforests across the Neotropics and
   harbour diverse invertebrate communities between their leaf axes.
   Various factors influence the invertebrate species richness and
   differences in composition in bromeliad phytotelmata, most notably,
   habitat size. However, there has been little work on invertebrate
   communities in bromeliads in western Amazonia or at different heights in
   the canopy. We collected 63 epiphytic bromeliads (Aechmea hoppii (Harms)
   L.B.Sm, A. nidularioides L.B.Sm) on the eastern edge of the Tropical
   Andes Biodiversity Hotspot in Ecuador and explored which biological and
   physical variables explained the differences in invertebrate composition
   among bromeliads. We extracted a total of 7524 individual aquatic and
   terrestrial macroinvertebrates and identified 300 morphospecies
   belonging to 27 orders, within the phyla Arthropoda, Annelida and
   Platyhelminthes. We recorded information on bromeliad location within
   the forest (height in canopy, primary or secondary forest), plant size
   (phytotelmata volume, base circumference, length of longest leaf),
   phytotelm pH and temperature and counted the number of leaves as a
   measure of habitat complexity. Overall, our results indicate that height
   in the canopy and phytotelm size explained statistically significant
   portions of the variation in different parts of the bromeliad community.
   Bromeliad size was positively correlated with alpha diversity of both
   terrestrial and aquatic invertebrates, whereas height in the canopy
   affected beta diversity. The sampling time of year in which bromeliads
   were collected affected the aquatic community, suggesting biological
   seasonality in the absence of climatic seasonality. By extending the
   height from the ground at which most bromeliad studies have been carried
   out, our work has highlighted the potential importance of vertical
   variation of bromeliad invertebrate communities throughout the canopy.
   Additionally, we fill in a geographic gap in this body of work.
   Las bromelias son comunes en los bosques neotropicales y la mayor \&
   iacute;a albergan comunidades diversas de invertebrados en los espacios
   entre sus ejes foliares. Diversos factores influyen en la riqueza de
   especies y en la composici \& oacute;n de los invertebrados en las
   fitotelmas de bromelias, especialmente el tama \& ntilde;o de la
   fitotelma. No obstante, existe escasa investigaci \& oacute;n sobre las
   comunidades de invertebrados en bromelias de la Amazon \& iacute;a
   occidental o a distintas alturas en el dosel del bosque. Se recolectaron
   63 bromelias ep \& iacute;fitas (Aechmea hoppii (Harms) L.B.Sm, A.
   nidularioides L.B.Sm) en el extremo oriental del hotspot de
   biodiversidad de los Andes Tropicales en Ecuador, con el fin de
   determinar qu \& eacute; variables biol \& oacute;gicas y f \&
   iacute;sicas explican las diferencias en la composici \& oacute;n de
   invertebrados entre bromelias. En total se extrajeron 7524 individuos de
   macroinvertebrados acu \& aacute;ticos y terrestres, correspondientes a
   300 morfoespecies de 27 \& oacute;rdenes, pertenecientes a los filos
   Arthropoda, Annelida y Platyhelminthes. Se registr \& oacute; informaci
   \& oacute;n sobre la ubicaci \& oacute;n de cada bromelia en el bosque
   (altura en el dosel, bosque primario o secundario), el tama \& ntilde;o
   de la planta (volumen de la fitotelma, circunferencia basal, longitud de
   la hoja m \& aacute;s larga), el pH y la temperatura de la fitotelma, y
   se cont \& oacute; el n \& uacute;mero de hojas como indicador de la
   complejidad del microh \& aacute;bitat ofrecido por la bromelia. Los
   resultados indican que la altura en el dosel y el tama \& ntilde;o de la
   fitotelma explican porciones estad \& iacute;sticamente significativas
   de la variaci \& oacute;n en distintos componentes de la comunidad de
   invertebrados. El tama \& ntilde;o de la bromelia mostr \& oacute; una
   correlaci \& oacute;n positiva con la diversidad alfa de invertebrados
   tanto terrestres como acu \& aacute;ticos, mientras que la altura en el
   dosel incidi \& oacute; en la diversidad beta. La \& eacute;poca de
   muestreo en la que se recolectaron las bromelias influy \& oacute; en la
   comunidad acu \& aacute;tica, lo que sugiere un patr \& oacute;n de
   estacionalidad biol \& oacute;gica en ausencia de estacionalidad clim \&
   aacute;tica. Al ampliar la altura desde el suelo a la que habitualmente
   se han realizado estudios en bromelias, este trabajo implica la
   potencial importancia de la variaci \& oacute;n vertical en las
   comunidades de invertebrados a lo largo del dosel. Asimismo, contribuye
   a explorar un vac \& iacute;o geogr \& aacute;fico en el conocimiento de
   este microh \& aacute;bitat.},
