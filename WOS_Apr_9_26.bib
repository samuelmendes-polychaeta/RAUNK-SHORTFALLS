@article{ WOS:001200728500002,
Author = {Guimaraes, Luiza Pedrosa and do Amaral, Pedro Henrique Monteiro and da
   Gama Alves, Roberto},
Title = {Taxonomic and functional diversity of oligochaetes in Neotropical
   springs: the influence of eucalyptus monocultures},
Journal = {HYDROBIOLOGIA},
Year = {2025},
Volume = {852},
Number = {12, SI},
Pages = {3013-3024},
Month = {JUL},
Abstract = {The replacement of native vegetation with monoculture eucalyptus
   plantations and the growing demand for water are strongly threatening
   the springs and, consequently, the fauna present. The aim of this study
   was to analyze the effect of eucalyptus plantations on the taxonomic and
   functional structure of aquatic oligochaete assemblages in Neotropical
   springs, assessing if (1) the taxonomic and functional diversities of
   aquatic oligochaetes are related to each other and (2) the replacement
   of vegetation cover by eucalyptus monoculture alters the composition and
   functional parameters of aquatic oligochaetes. The study was conducted
   in 20 springs located on private properties where eucalyptus forestry is
   predominant, in the Paraiba do Sul River sub-basin, Brazil. A positive
   relationship was found between taxonomic and functional parameters.
   PERMANOVA found that springs located in forested areas had a different
   taxonomic composition of oligochaetes compared to springs in eucalyptus
   areas, and all generalized linear models (GLM) pointed to the area as
   significant. Our results help to understand the influence of eucalyptus
   monoculture on the taxonomic and functional structure of oligochaetes.},
